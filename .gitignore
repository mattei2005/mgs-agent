__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage

# ─── Databases (state ativo, muda em runtime) ─────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ─── Backups e arquivos temporários ───────────────────────────
*.bak
*.bak-*
*.bak.*
*.swp
*.tmp
*.orig
*.rej

