backups/
data/backup-*/

# ─── Ares generated media samples (pesados/runtime) ─────────────
data/ares/creative-inventory/video-frame-samples-full/

# ─── Lockfiles internos do Hermes ─────────────────────────────
*.lock
*.pid

# ─── Secrets locais (não versionar) ───────────────────────────
.secrets/
secrets/

# ─── Outros temporários ───────────────────────────────────────
.tmp/
tmp/

# RunCloud inventory temp files
.runcloud-inventory.*

# ─── Rescue/temp state files ───────────────────────────────────
data/git-rescue-*/
data/hermes-news-explainer-state.json.*
# ─── Hermes update reports/backups (runtime, may contain sensitive auth snapshots) ──
reports/hermes-updates/
*.tar.gz


# Generated AI media artifacts (local smoke/ops outputs)
data/generated/

# Browser profiles/cookies are runtime and may contain local session data
/browser-profiles/
data/browser-profiles/

# Sensitive/debug runtime artifacts: never version automatically
data/ares/meta-ads/audit/token-debug-*.json
data/**/audit/**/*.json
data/**/reports/**/*.json
data/**/state/**/*.json
data/ares/meta-ads/audit/**/*.json
data/ares/meta-ads/reports/**/*.json
data/ares/meta-ads/state/**/*.json
data/mgs-gateway-restart-finalizer-*.sh
data/mgs-gateway-restart-snapshot-*.sha256
# Environment editor/backup copies can contain live credentials.
.env.save*
.env.*.save*

# Finance full readbacks can exceed GitHub's 100 MB blob limit; keep local.
work/finance-reaudit-*/batch*-full-prewrite.json
work/finance-reaudit-*/batch*-full-postwrite.json
