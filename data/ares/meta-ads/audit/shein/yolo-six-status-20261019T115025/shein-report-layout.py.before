#!/usr/bin/env python3
"""Canonical SHEIN report renderer/gate. Offline only; never posts or mutates APIs."""
import argparse
import copy
import hashlib
import json
import re
import unicodedata
from collections import defaultdict
from datetime import date, datetime, timedelta
from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
from pathlib import Path
from zoneinfo import ZoneInfo
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
from shein_report_delivery import discord_length, register_report

CONTRACT = Path('/root/mgs-agent/data/ares/meta-ads/operations/SHEIN-US-DIRECT.json')


class LayoutError(ValueError):
    pass


def policy():
    return json.loads(CONTRACT.read_text())['reporting']['on_demand_default_layout']


def number(value):
    if value is None or isinstance(value, bool):
        return None
    try:
        result = Decimal(str(value))
        return result if result.is_finite() else None
    except (InvalidOperation, ValueError):
        return None


def signal(value, estimated=False):
    v = number(value)
    if v is None:
        return '⚪'
    rule = policy()['roi_direction_signal']
    if estimated:
        bands = rule['estimated_roi']
        return bands['red']['color'] if v < Decimal(bands['red']['value']) else bands['green']['color'] if v > Decimal(bands['green']['value']) else bands['yellow']['color']
    colors = rule['real_roi']
    return colors['positive'] if v > 0 else colors['negative'] if v < 0 else colors['exact_zero']


def mean_roi(values):
    valid = [v for x in values if (v := number(x)) is not None]
    return (sum(valid) / len(valid) if valid else None, len(valid))


def roi(revenue, spend):
    r, s = number(revenue), number(spend)
    return (r - s) * 100 / s if r is not None and s is not None and s > 0 else None


def equal_metric(actual, expected, label):
    a, e = number(actual), number(expected)
    if (a is None) != (e is None) or (a is not None and abs(a - e) > Decimal('1e-18')):
        raise LayoutError('Inconsistent ' + label)


def fmt(value, suffix='', signed=False, places=2):
    v = number(value)
    if v is None:
        return 'n/d'
    v = v.quantize(Decimal(1).scaleb(-places), rounding=ROUND_HALF_UP)
    return format(v, f'+.{places}f' if signed else f'.{places}f').replace('.', ',') + suffix


def visual_width(text):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in ('W', 'F') else 1 for c in text)


def product_label(value, remove_ellipsis=False, max_characters=None):
    rule = policy().get('product_column') or {}
    limit = rule.get('max_characters', 20)
    visual_limit = rule.get('max_visual_width', limit)
    suffix = rule.get('ellipsis', '')
    if max_characters is not None:
        if not isinstance(max_characters, int) or isinstance(max_characters, bool) or max_characters <= 0 or max_characters > limit:
            raise LayoutError('Preview product cap must be a positive integer no larger than the default')
        limit = max_characters
        visual_limit = min(visual_limit, limit)
    budget_suffix = '' if remove_ellipsis and max_characters is not None else suffix
    if not isinstance(limit, int) or isinstance(limit, bool) or limit < len(budget_suffix) or not isinstance(visual_limit, int) or visual_limit < visual_width(budget_suffix):
        raise LayoutError('Invalid product display limit')
    text = unicodedata.normalize('NFC', str(value) if value is not None else 'n/d')
    text = ' '.join(text.replace('|', ' ').split())
    def fits(candidate):
        return len(candidate) <= limit and visual_width(candidate) <= visual_limit
    if fits(text):
        return text
    prefix = text
    while prefix and not fits(prefix.rstrip() + budget_suffix):
        prefix = prefix[:-1]
    return prefix.rstrip() if remove_ellipsis else prefix.rstrip() + suffix


def bar_positions(text):
    positions, current = [], 0
    for char in text:
        if char == '|':
            positions.append(current)
        current += visual_width(char)
    return positions


def family_groups(rows):
    ids = {r['id']: r for r in rows}
    if len(ids) != len(rows):
        raise LayoutError('Duplicate campaign ID')
    by_number, children, parents, notes = defaultdict(list), defaultdict(list), {}, []
    for r in rows:
        # Match numeric identity, preserving literal padding in all labels.
        by_number[(r['product'], int(r['number']))].append(r['id'])
    for r in rows:
        source = r.get('copy_source_literal')
        if source is None:
            continue
        matches = by_number[(r['product'], int(source))]
        if len(matches) != 1:
            notes.append('Origem COPY fora do recorte ou ambígua: ' + r['number'])
            continue
        parents[r['id']] = matches[0]
        children[matches[0]].append(r['id'])
    colors = {}
    def check(cid):
        if colors.get(cid) == 1:
            raise LayoutError('COPY cycle')
        if colors.get(cid) == 2:
            return
        colors[cid] = 1
        for child in children[cid]:
            check(child)
        colors[cid] = 2
    for cid in ids:
        check(cid)
    key = lambda cid: (ids[cid].get('first_delivery') or '9999-12-31', int(ids[cid]['number']), cid)
    def tree(cid):
        group = [ids[cid]]
        for child in sorted(children[cid], key=key):
            group.extend(tree(child))
        return group
    roots = sorted((cid for cid in ids if cid not in parents), key=lambda cid: (unicodedata.normalize('NFKD', ids[cid]['product']).casefold(), *key(cid)))
    groups = [tree(cid) for cid in roots]
    if len([r for g in groups for r in g]) != len(rows):
        raise LayoutError('Family coverage mismatch')
    return groups, notes


def requested_sort(model):
    """Validate an explicit one-request presentation override, not a saved policy."""
    rule = model.get('explicit_sort_request')
    if rule is None:
        return None
    if not isinstance(rule, dict) or rule.get('mode') not in ('estimated_roi_desc', 'estimated_roi_asc'):
        raise LayoutError('Unsupported explicit report sorting')
    if rule.get('history_sort') not in (None, 'campaign_number_asc'):
        raise LayoutError('Unsupported explicit history sorting')
    if 'hide_copy_origin_notes' in rule and not isinstance(rule['hide_copy_origin_notes'], bool):
        raise LayoutError('Invalid COPY diagnostic visibility')
    if 'include_rps' in rule and not isinstance(rule['include_rps'], bool):
        raise LayoutError('Invalid RPS column request')
    if rule.get('budget_remaining_display') not in (None, 'percent_daily_budget'):
        raise LayoutError('Unsupported budget remaining presentation')
    if rule.get('authorized_by_discord_id') != '344196393512075265' or not re.fullmatch(r'\d{17,20}', str(rule.get('source_thread_id', ''))) or not str(rule.get('request_text', '')).strip():
        raise LayoutError('Missing explicit report sorting authority/provenance')
    return rule


def effective_report_options(model, cfg):
    """Resolve prospective account defaults, then explicit authorized deltas."""
    explicit = requested_sort(model)
    account = model.get('account') or {}
    aid = str(account.get('id', '')).removeprefix('act_')
    rule = cfg.get('account_report_overrides', {}).get(aid, {})
    if rule.get('status') != 'active':
        return explicit
    if rule.get('account_name') != account.get('name'):
        raise LayoutError('Account report override identity mismatch')
    stamp = (model.get('source_timestamps') or {}).get('insights') or model.get('snapshot_at')
    if not stamp:
        raise LayoutError('Missing financial timestamp for account report policy')
    if datetime.fromisoformat(stamp) < datetime.fromisoformat(rule['effective_from_financial_snapshot']):
        return explicit
    options = copy.deepcopy(rule['options'])
    requested_sort({'explicit_sort_request': options})
    options['_canonical_default'] = True
    if explicit is not None:
        options.update(explicit)
        options['_canonical_default'] = False
    return options


def ordered_groups(rows, account, cfg, explicit_request=None):
    """Apply a saved account rule or a validated one-request presentation order."""
    groups, notes = family_groups(rows)
    rule = cfg.get('account_sort_overrides', {}).get(str(account['id']).removeprefix('act_'), {})
    if explicit_request is not None:
        rule = {'status': 'active', 'account_name': account['name'], 'mode': explicit_request['mode']}
    if rule.get('status') != 'active':
        return groups, notes
    if rule.get('account_name') != account['name']:
        raise LayoutError('Account sort override identity mismatch')
    if rule.get('mode') not in ('estimated_roi_desc', 'estimated_roi_asc'):
        raise LayoutError('Unsupported account sort override')
    def key(row):
        value = number(row.get('estimated_roi'))
        score = (-value if rule['mode'] == 'estimated_roi_desc' else value) if value is not None else Decimal(0)
        return (value is None, score,
                row.get('first_delivery') or '9999-12-31', int(row['number']), row['id'])
    return [[row] for row in sorted(rows, key=key)], notes


def pack_complete_parts(parts):
    """Combine complete blocks where possible; never split a row or fence."""
    packed = []
    for part in parts:
        if packed and discord_length(packed[-1] + '\n\n' + part) <= 2000:
            packed[-1] += '\n\n' + part
        else:
            packed.append(part)
    return packed


def prose_parts(text):
    """Keep long audit/limitation footers within the same exact Discord limit."""
    parts, current = [], ''
    for line in text.splitlines():
        if discord_length(line) > 2000:
            raise LayoutError('One footer line exceeds Discord capacity')
        candidate = current + ('\n' if current else '') + line
        if discord_length(candidate) > 2000:
            parts.append(current)
            current = line
        else:
            current = candidate
    if current:
        parts.append(current)
    return parts


def table_parts(title, headers, groups, left_columns, join, prefix=''):
    flat = [r for group in groups for r in group]
    widths = [max(visual_width(v) for v in [headers[i]] + [row[i] for row in flat]) for i in range(len(headers))]
    def cell(value, width, left):
        spaces = width - visual_width(value)
        if left:
            return value + ' ' * spaces
        n = spaces // 2
        return ' ' * n + value + ' ' * (spaces - n)
    def line(row):
        return join.join(cell(v, w, i in left_columns) for i, (v, w) in enumerate(zip(row, widths))).rstrip()
    header = line(headers)
    lines = [line(row) for row in flat]
    def message(chunk, i, total):
        lead = prefix.strip() + '\n\n' if prefix and i == 1 else ''
        return lead + f'**{title} · {i}/{total}**\n```text\n' + header + '\n' + '\n'.join(chunk) + ('\n' if chunk else '') + '```'
    if prefix and lines and discord_length(message([lines[0]], 1, 1)) > 2000:
        return pack_complete_parts([prefix.strip(), *table_parts(title, headers, groups, left_columns, join)])
    # Fixed point includes the real page numbers rather than an arbitrary reserve.
    # The new capacity-first policy permits a family boundary only when needed;
    # adjacency and exact parent/child order remain unchanged.
    total = 1
    while True:
        chunks, current = [], []
        if discord_length(message([], 1, total)) > 2000:
            raise LayoutError('Table header exceeds Discord capacity')
        for item in lines:
            i = len(chunks) + 1
            if discord_length(message(current + [item], i, total)) <= 2000:
                current.append(item)
            else:
                if not current:
                    raise LayoutError('One row exceeds Discord capacity')
                chunks.append(current)
                current = [item]
                if discord_length(message(current, len(chunks) + 1, total)) > 2000:
                    raise LayoutError('One row exceeds Discord capacity')
        if current or not chunks:
            chunks.append(current)
        if len(chunks) == total:
            break
        total = len(chunks)
    parts = []
    for i, chunk in enumerate(chunks, 1):
        if any(bar_positions(row) != bar_positions(header) for row in chunk):
            raise LayoutError('Visual separators misaligned')
        text = message(chunk, i, total)
        if discord_length(text) > 2000:
            raise LayoutError('Discord part too large')
        parts.append(text)
    return parts


def render_model(model, preview_remove_product_ellipsis=False, preview_product_max_characters=None, preview_compact_headers=False):
    cfg = policy()
    explicit_sort = effective_report_options(model, cfg)
    include_rps = bool(explicit_sort and explicit_sort.get('include_rps'))
    budget_percent = bool(explicit_sort and explicit_sort.get('budget_remaining_display') == 'percent_daily_budget')
    if include_rps:
        rps_source = model.get('rps_source') or {}
        if rps_source.get('source_kind') != 'SB_DASH_VISIBLE_COLUMN' or rps_source.get('native_metric_id') != 'RPS' or rps_source.get('capture_method') != 'rendered_table_DOM' or rps_source.get('dashboard_url') != 'https://app.smartbiddingdigital.com/reports/adgroup' or not rps_source.get('observed_at') or rps_source.get('unit') != model.get('account', {}).get('currency', '') + '/1000_sessions' or not re.fullmatch(r'[a-f0-9]{64}', str(rps_source.get('capture_sha256', ''))) or rps_source.get('data_date') != model.get('date'):
            raise LayoutError('Missing visible SB dashboard RPS provenance/unit/date')
    if preview_product_max_characters is not None:
        product_label('', remove_ellipsis=preview_remove_product_ellipsis, max_characters=preview_product_max_characters)
    if cfg.get('column_separators', {}).get('join') != ' | ':
        raise LayoutError('Unsupported separator contract')
    account = model.get('account') or {}
    if not all(account.get(k) for k in ('id', 'name', 'currency', 'timezone_name')):
        raise LayoutError('Missing account evidence')
    account_id = str(account['id']).removeprefix('act_')
    override = cfg.get('account_column_overrides', {}).get(account_id, {})
    columns = list(cfg['columns'])
    if override.get('status') == 'active':
        if account['name'] != override.get('account_name'):
            raise LayoutError('Account column override identity mismatch')
        columns = list(override['columns'])
    if include_rps:
        columns.insert(columns.index('Bid'), 'RPS')
    aliases = dict(cfg.get('header_aliases', {}))
    if budget_percent:
        aliases['Budget R.'] = 'B.R.%'
    if preview_compact_headers:
        preview = override.get('compact_header_preview', {})
        if preview.get('status') not in ('authorized_preview_pending_visual_approval', 'approved_and_promoted'):
            raise LayoutError('Compact header preview is not authorized for this account')
        if preview_product_max_characters != preview.get('product_max_characters') or preview_remove_product_ellipsis != preview.get('remove_product_ellipsis'):
            raise LayoutError('Compact header preview requires the authorized product presentation')
        aliases.update(preview.get('header_aliases', {}))
    display_columns = [aliases.get(name, name) for name in columns]
    if len(set(display_columns)) != len(display_columns):
        raise LayoutError('Ambiguous report header aliases')
    configuration_columns = bool({'Bid', 'Budget R.'} & set(columns))
    target = date.fromisoformat(model['date'])
    dates = [(target - timedelta(days=n)).isoformat() for n in range(cfg['campaign_roi_history']['days'] - 1, -1, -1)]
    if model.get('history_dates') != dates:
        raise LayoutError('History must contain the exact seven civil dates')
    stamps = model.get('source_timestamps') or {}
    stamp = stamps.get('insights') or model.get('snapshot_at')
    if not stamp:
        raise LayoutError('Missing financial snapshot timestamp')
    cutoff = datetime.fromisoformat(stamp).astimezone(ZoneInfo(account['timezone_name']))
    config_stamp = stamps.get('configuration')
    if configuration_columns and not config_stamp:
        raise LayoutError('Missing configuration snapshot timestamp')
    config_cutoff = datetime.fromisoformat(config_stamp).astimezone(ZoneInfo(account['timezone_name'])) if configuration_columns else None
    rows = copy.deepcopy(model.get('rows', []))
    required = ('id', 'name', 'number', 'product', 'quiz', 'bid', 'spend', 'net_revenue', 'estimated_revenue', 'roi', 'estimated_roi', 'health', 'roas', 'first_delivery', 'history')
    for r in rows:
        missing = [key for key in required if key not in r]
        if missing:
            raise LayoutError('Missing evidence fields: ' + ','.join(missing))
        if configuration_columns:
            if not all(k in r for k in ('budget_remaining', 'cost_per_result_goal', 'bid_strategy_live')):
                raise LayoutError('Missing Budget R./Bid source evidence')
            for key in ('budget_remaining', 'cost_per_result_goal'):
                if r[key] is not None and (number(r[key]) is None or number(r[key]) < 0):
                    raise LayoutError('Invalid configuration metric: ' + key)
            if r['bid_strategy_live'] != 'COST_CAP' and r['cost_per_result_goal'] is not None:
                raise LayoutError('Cost per result goal is only applicable to COST_CAP')
        if not re.fullmatch(r'\d+', r['number']):
            raise LayoutError('Campaign number must be literal digits')
        if not isinstance(r['product'], str):
            raise LayoutError('Product label must be text')
        if include_rps and ('rps' not in r or (r['rps'] is not None and (number(r['rps']) is None or number(r['rps']) < 0))):
            raise LayoutError('Missing or invalid visible SB RPS value')
        if budget_percent and ('daily_budget' not in r or (r['daily_budget'] is not None and (number(r['daily_budget']) is None or number(r['daily_budget']) <= 0))):
            raise LayoutError('Missing or invalid daily budget denominator')
        if number(r['spend']) is None or number(r['spend']) < 0:
            raise LayoutError('Invalid Meta spend')
        equal_metric(r['roi'], roi(r['net_revenue'], r['spend']), 'current ROI')
        equal_metric(r['estimated_roi'], roi(r['estimated_revenue'], r['spend']), 'estimated ROI')
        markers = re.findall(r'\bCOPY\s+C(\d+)\b', r['name'], re.I)
        if len(set(markers)) > 1:
            raise LayoutError('Ambiguous COPY marker')
        r['copy_source_literal'] = markers[0] if markers else None
        r['display'] = r['number'] + (' COPY C' + markers[0] if markers else '')
        if [h.get('date') for h in r['history']] != dates:
            raise LayoutError('Daily campaign coverage mismatch')
        for h in r['history']:
            if not all(k in h for k in ('spend', 'net_revenue', 'roi', 'partial')):
                raise LayoutError('Missing daily source evidence')
            equal_metric(h['roi'], roi(h['net_revenue'], h['spend']), 'daily ROI')
            if h['date'] != dates[-1] and h['partial']:
                raise LayoutError('Past civil date cannot be current partial')
        equal_metric(r['history'][-1]['roi'], r['roi'], 'current history/main snapshot')
    groups, notes = ordered_groups(rows, account, cfg, explicit_sort)
    main_groups, history_groups, history_by_id = [], [], {}
    for group in groups:
        main, history = [], []
        for r in group:
            start = date.fromisoformat(r['first_delivery']).strftime('%d/%m') if r['first_delivery'] else 'n/d'
            age = 'D' + str((target - date.fromisoformat(r['first_delivery'])).days + 1) if r['first_delivery'] else 'n/d'
            balance = number(r['net_revenue']) - number(r['spend']) if number(r['net_revenue']) is not None else None
            values = {'R/E': signal(r['roi']) + signal(r['estimated_roi'], True), 'Início': start, 'Nº': r['display'], 'Produto': product_label(r['product'], remove_ellipsis=preview_remove_product_ellipsis, max_characters=preview_product_max_characters), 'Quiz': r['quiz'], 'Gasto': fmt(r['spend']), 'Receita': fmt(r['net_revenue']), 'Saldo': fmt(balance, signed=True), 'Est.Health': fmt(r['health'], '%'), 'ROI': fmt(r['roi'], '%', True), 'ROI est.': fmt(r['estimated_roi'], '%', True), 'ROAS': fmt(r['roas'], 'x'), 'Lance': r['bid']}
            if include_rps:
                values['RPS'] = fmt(r['rps'])
            if configuration_columns:
                strategy = r['bid_strategy_live']
                remaining, daily = number(r['budget_remaining']), number(r.get('daily_budget'))
                values['Budget R.'] = fmt(remaining * 100 / daily if remaining is not None and daily is not None and daily > 0 else None, '%') if budget_percent else fmt(remaining)
                values['Bid'] = fmt(r['cost_per_result_goal']) if strategy == 'COST_CAP' else '—' if strategy in ('LOWEST_COST_WITHOUT_CAP', 'LOWEST_COST_WITH_BID_CAP') else 'misto' if strategy == 'MIXED' else 'n/d'
            try:
                main.append([values[k] for k in columns])
            except KeyError as exc:
                raise LayoutError('Renderer requires update for new column') from exc
            average, n = mean_roi([h['roi'] for h in r['history']])
            partial = any(h['partial'] and number(h['roi']) is not None for h in r['history'])
            avg = fmt(average, '%', True, 1) + ('*' if partial else '') + (f' ({n}/7)' if 0 < n < 7 else '')
            history_row = [start, r['display'], age] + [fmt(h['roi'], '%', True, 1) + ('*' if h['partial'] and h['roi'] is not None else '') for h in r['history']] + [avg]
            history.append(history_row)
            history_by_id[r['id']] = history_row
        main_groups.append(main)
        history_groups.append(history)
    history_ids = [r['id'] for g in groups for r in g]
    if explicit_sort is not None and explicit_sort.get('history_sort') == 'campaign_number_asc':
        history_ids = [r['id'] for r in sorted(rows, key=lambda r: (int(r['number']), r['id']))]
        history_groups = [[history_by_id[cid]] for cid in history_ids]
    has_partial = any(h['partial'] for r in rows for h in r['history'])
    history_headers = ['Início', 'Nº', 'Dia'] + [date.fromisoformat(dt).strftime('%d/%m') + ('*' if i == len(dates) - 1 and has_partial else '') for i, dt in enumerate(dates)] + ['Média 7d']
    left = {i for i, name in enumerate(columns) if name in cfg['alignment']['main']['left_aligned_exceptions']}
    main_parts = table_parts('SHEIN — principal', display_columns, main_groups, left, ' | ')
    history_parts = table_parts('Histórico ROI real — 7 dias', history_headers, history_groups, set(), ' | ')
    delay = number((model.get('delay') or {}).get('totalMinutes'))
    if delay is None or delay < 0:
        delay_label = 'n/d — fonte indisponível ou inválida'
    else:
        hh, mm = divmod(int(delay), 60)
        delay_label = f'{hh}h {mm:02d}min' if hh else f'{mm}min'
    spend = sum(number(r['spend']) for r in rows)
    revenue = sum(number(r['net_revenue']) for r in rows) if rows and all(number(r['net_revenue']) is not None for r in rows) else None
    estimated = sum(number(r['estimated_revenue']) for r in rows) if rows and all(number(r['estimated_revenue']) is not None for r in rows) else None
    balance = revenue - spend if revenue is not None else None
    header = f"## SHEIN · {account['name']}\n**{target.strftime('%d/%m/%Y')} · até {cutoff.strftime('%H:%M %Z')} · {account['currency']}**\n**⏱️ ATRASO GAM/SB: {delay_label}**\n"
    if configuration_columns:
        financial_label = 'Financeiro preservado' if model.get('financial_snapshot_preserved', True) else 'Financeiro'
        header += f"{financial_label}: {cutoff.strftime('%d/%m %H:%M %Z')}. Bid/B.R.: Meta {config_cutoff.strftime('%d/%m %H:%M %Z')}.\n"
    if include_rps:
        rps_cutoff = datetime.fromisoformat(rps_source['observed_at']).astimezone(ZoneInfo(account['timezone_name']))
        header += f"RPS: coluna da dash SB, consultada em {rps_cutoff.strftime('%d/%m %H:%M %Z')}.\n"
    if preview_product_max_characters is not None:
        qualifier = ', sem reticências' if preview_remove_product_ellipsis else ''
        header = f'**Prévia visual: Produto até {preview_product_max_characters} caracteres{qualifier}; mesmo snapshot financeiro.**\n' + header
    elif preview_remove_product_ellipsis:
        header = '**Prévia visual: Produto sem reticências; mesmo snapshot financeiro.**\n' + header
    if preview_compact_headers:
        header = '**Cabeçalhos compactos: B.R. · Rev · Health · ROI E.**\n' + header
    header += f"Gasto **{fmt(spend)}** · {aliases.get('Receita', 'Receita')} **{fmt(revenue)}** · Saldo **{fmt(balance, signed=True)}** · ROI **{fmt(roi(revenue, spend), '%', True)}** · {aliases.get('ROI est.', 'ROI est.')} **{fmt(roi(estimated, spend), '%', True)}**.\n"
    sort_rule = cfg.get('account_sort_overrides', {}).get(account_id, {})
    if explicit_sort is not None:
        direction = 'do menor para o maior' if explicit_sort['mode'] == 'estimated_roi_asc' else 'do maior para o menor'
        origin = 'Padrão salvo nesta conta' if explicit_sort.get('_canonical_default') else 'Ordenação deste pedido'
        header += f'{origin}: ROI E. {direction}; sem base ao final.\n'
        if explicit_sort.get('history_sort') == 'campaign_number_asc':
            header += 'Histórico de 7 dias: número da campanha em ordem crescente.\n'
    elif sort_rule.get('status') == 'active':
        header += 'Ordenação salva nesta conta: ROI E. do maior para o menor; sem base ao final.\n'
    if not rows:
        header += 'Sem campanhas com entrega no recorte; nenhuma linha financeira foi inventada.\n'
    footer = f"{'* ' + target.strftime('%d/%m') + ' parcial até ' + cutoff.strftime('%H:%M %Z') + '.\n' if has_partial else ''}"
    footer += 'Fontes: Meta Insights × Smart Bidding/Adgroup. ROI = receita líquida/gasto Meta − 1; ROI est. = receita estimada/gasto Meta − 1; ROAS = valor de compras Meta/gasto.\nReceita/ROI sujeitos ao atraso GAM/SB.\n'
    if configuration_columns:
        delay_note = 'Atraso GAM/SB observado no snapshot financeiro preservado.' if model.get('financial_snapshot_preserved', True) else 'Atraso GAM/SB consultado nesta coleta.'
        if budget_percent:
            footer += f"B.R.% = orçamento restante Meta/orçamento diário × 100; Bid em {account['currency']}. {delay_note}\n"
        else:
            footer += f"{aliases.get('Budget R.', 'Budget R.')} = budget_remaining Meta; Bid = meta de custo/resultado em Cost Cap; ambos em {account['currency']}. {delay_note}\n"
        if include_rps:
            footer += f"RPS copiado da coluna da dash Smart Bidding, em {account['currency']} por mil sessões.\n"
        for limitation in model.get('configuration_limitations', []):
            footer += str(limitation) + '\n'
    if cfg.get('legend', {}).get('enabled', False):
        footer += 'Média 7d = média aritmética dos ROIs reais diários válidos; n/d não vira zero; (n/7) indica cobertura incompleta. Produto é rótulo do nome; COPY é origem direta explícita.\n'
    visible_notes = [note for note in notes if not (explicit_sort is not None and explicit_sort.get('hide_copy_origin_notes') and note.startswith('Origem COPY fora do recorte ou ambígua:'))]
    if visible_notes:
        footer += '\n'.join(visible_notes) + '\n'
    footer += f'**Fim do relatório — {len(rows)} campanhas e histórico de 7 dias.**'
    main_delivery = table_parts('SHEIN — principal', display_columns, main_groups, left, ' | ', prefix=header.strip())
    parts = pack_complete_parts([*main_delivery, *history_parts, *prose_parts(footer.strip())])
    result = {'text': '\n\n'.join(parts), 'parts': parts, 'main_parts': main_parts, 'history_parts': history_parts, 'campaign_order': [r['display'] for g in groups for r in g], 'campaign_ids': [r['id'] for g in groups for r in g], 'main_rows': len(rows), 'history_rows': len(rows), 'history_cells': len(rows) * len(dates), 'contract_sha256': hashlib.sha256(json.dumps(cfg, sort_keys=True, ensure_ascii=False).encode()).hexdigest()}
    result['history_campaign_ids'] = history_ids
    result['diagnostics'] = notes
    if any(discord_length(p) > 2000 for p in parts):
        raise LayoutError('Header or footer exceeds Discord capacity')
    return result


def validate_report(model, text, thread_id=None, preview_remove_product_ellipsis=False, preview_product_max_characters=None, preview_compact_headers=False):
    if thread_id is not None:
        check_thread_binding(model, thread_id)
    result = render_model(model, preview_remove_product_ellipsis=preview_remove_product_ellipsis, preview_product_max_characters=preview_product_max_characters, preview_compact_headers=preview_compact_headers)
    if text != result['text']:
        raise LayoutError('Report differs from canonical rendering; do not publish')
    return {'status': 'validated', 'contract_sha256': result['contract_sha256'], 'report_sha256': hashlib.sha256(text.encode()).hexdigest(), 'model_sha256': hashlib.sha256(json.dumps(model, sort_keys=True, ensure_ascii=False).encode()).hexdigest(), 'account_id': model['account']['id'], 'account_name': model['account']['name'], 'thread_id': thread_id, 'report_date': model['date'], 'main_rows': result['main_rows'], 'history_rows': result['history_rows'], 'parts': len(result['parts']), 'max_part_chars': max(map(len, result['parts'])), 'max_part_utf16_units': max(map(discord_length, result['parts'])), 'pagination_policy': 'capacity_first_exact_2000_no_secondary_split', 'preview_remove_product_ellipsis': bool(preview_remove_product_ellipsis), 'preview_product_max_characters': preview_product_max_characters, 'preview_compact_headers': bool(preview_compact_headers)}


def check_thread_binding(model, thread_id):
    index = Path('/root/mgs-agent/data/ares/discord/shein-intraday-report-bindings.json')
    bindings = json.loads(index.read_text())['bindings']
    matches = [b for b in bindings if b['thread_id'] == str(thread_id)]
    if len(matches) != 1:
        raise LayoutError('Thread is not uniquely bound to a SHEIN account')
    account = model.get('account') or {}
    binding = matches[0]
    if str(account.get('id', '')).removeprefix('act_') != binding['account_id'] or account.get('name') != binding['account_name']:
        raise LayoutError('Thread/account identity mismatch')
    return binding


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    render = sub.add_parser('render')
    render.add_argument('--input', required=True)
    render.add_argument('--output', required=True)
    render.add_argument('--thread-id')
    render.add_argument('--preview-remove-product-ellipsis', action='store_true')
    render.add_argument('--preview-product-max-characters', type=int)
    render.add_argument('--preview-compact-headers', action='store_true')
    validate = sub.add_parser('validate')
    validate.add_argument('--input', required=True)
    validate.add_argument('--report', required=True)
    validate.add_argument('--receipt')
    validate.add_argument('--thread-id')
    validate.add_argument('--preview-remove-product-ellipsis', action='store_true')
    validate.add_argument('--preview-product-max-characters', type=int)
    validate.add_argument('--preview-compact-headers', action='store_true')
    args = parser.parse_args()
    try:
        model = json.loads(Path(args.input).read_text())
        if args.thread_id:
            check_thread_binding(model, args.thread_id)
        if args.command == 'render':
            result = render_model(model, preview_remove_product_ellipsis=args.preview_remove_product_ellipsis, preview_product_max_characters=args.preview_product_max_characters, preview_compact_headers=args.preview_compact_headers)
            path = Path(args.output)
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(result['text'])
            path.with_suffix('.parts.json').write_text(json.dumps(result['parts'], ensure_ascii=False, indent=2))
            receipt = validate_report(model, result['text'], args.thread_id, args.preview_remove_product_ellipsis, args.preview_product_max_characters, args.preview_compact_headers)
            receipt['preview_compact_headers'] = args.preview_compact_headers
            receipt['delivery_receipt'] = str(register_report(result))
            print(json.dumps(receipt, ensure_ascii=False))
        else:
            receipt = validate_report(model, Path(args.report).read_text(), args.thread_id, args.preview_remove_product_ellipsis, args.preview_product_max_characters, args.preview_compact_headers)
            receipt['preview_compact_headers'] = args.preview_compact_headers
            result = render_model(model, args.preview_remove_product_ellipsis, args.preview_product_max_characters, args.preview_compact_headers)
            receipt['delivery_receipt'] = str(register_report(result))
            if args.receipt:
                Path(args.receipt).write_text(json.dumps(receipt, ensure_ascii=False, indent=2))
            print(json.dumps(receipt, ensure_ascii=False))
    except (LayoutError, KeyError, ValueError, TypeError) as exc:
        print(json.dumps({'status': 'invalid', 'reason': str(exc)}, ensure_ascii=False))
        return 2
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
