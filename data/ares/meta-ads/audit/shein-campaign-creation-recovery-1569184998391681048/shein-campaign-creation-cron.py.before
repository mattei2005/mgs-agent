#!/usr/bin/env python3
"""Resolve the active Hermes interpreter; deterministic, no agent or footer."""
import os
from pathlib import Path
import sys


def main():
    first = Path('/root/.local/bin/hermes').read_text().splitlines()[0]
    assert first.startswith('#!')
    interpreter = first[2:].strip()
    assert interpreter.startswith('/') and Path(interpreter).is_file()
    os.environ['HERMES_PROFILE'] = 'ares'
    os.environ['HERMES_HOME'] = '/root/.hermes/profiles/ares'
    os.execv(interpreter, [interpreter, '/root/.hermes/profiles/ares/scripts/shein-campaign-creation-daily.py', *sys.argv[1:]])


if __name__ == '__main__':
    main()
