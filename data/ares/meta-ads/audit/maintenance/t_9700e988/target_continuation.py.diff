+def _asap_revision(path, payload, config, receipt):
+    """Version 2 admits an already committed ASAP mapping, never creates one.
+
+    Reuse the original grant's current authority, CAS chain and exact approval
+    representation. Legacy NOW receipts keep their separate contract below.
+    """
+    from . import target_start_revision as revision
+    if receipt.get('kind') != 'committed_asap_partial':
+        raise ValueError('continuation unknown v2 admission kind')
+    context = revision.validate_local(path, config, receipt['original_approved_digest'], receipt['approval_message_id'])
+    grant = context['grant']
+    if context['pending'] or not context['last']:
+        raise ValueError('continuation requires a committed existing ASAP revision')
+    folder, tx = context['last']
+    binding = config['accounts'][receipt['account_id']]['target_page_replacement']['start_revisions'][receipt['request_id']]
+    required = {'request.json', 'manifest.json', 'plan.json', 'summary.json', 'final-approval.json'}
+    if (receipt.get('start_grant_binding') != binding
+            or receipt.get('temporal_revision_digest') != revision.digest(tx)
+            or receipt.get('revision_index') != tx['index']
+            or receipt.get('start_time') != tx['start_time']
+            or receipt.get('instruction_message_id') != grant['instruction_message_id']
+            or receipt.get('authorized_by') != grant['authorized_by']
+            or receipt.get('meta_actor_id') != grant['meta_actor_id']
+            or receipt.get('messages') != grant['messages']
+            or not required <= set(receipt.get('files', {}))
+            or payload != tx['after']['manifest.json']
+            or load(path.parent / 'final-approval.json') != revision.approval_payload(grant, tx)):
+        raise ValueError('continuation ASAP mapping/grant/final approval mismatch')
+    return context
+
