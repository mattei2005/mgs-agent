+def source_cta(creative):
+    """Read exact CTA evidence; never default, normalize text or prefer a shape."""
+    if not isinstance(creative,dict):raise ValueError('source CTA creative must be an object')
+    afs=creative.get('asset_feed_spec',{});story=creative.get('object_story_spec',{})
+    if not isinstance(afs,dict) or not isinstance(story,dict):raise ValueError('source CTA shape malformed')
+    observed=[];native=[]
+    def record(value):
+        if not isinstance(value,str) or re.fullmatch(r'[A-Z][A-Z0-9_]*',value) is None:raise ValueError('source CTA type missing or malformed')
+        observed.append(value)
+    def action(value):
+        if not isinstance(value,dict):raise ValueError('source CTA action malformed')
+        record(value.get('type'))
+        if 'value' in value:
+            destination=value['value']
+            if not isinstance(destination,dict):raise ValueError('source CTA value malformed')
+            if 'app_destination' in destination and destination['app_destination']!='MESSENGER':raise ValueError('source CTA destination conflicts with Messenger mode')
+    if 'call_to_action_types' in afs:
+        types=afs['call_to_action_types']
+        if not isinstance(types,list) or len(types)!=1:raise ValueError('source CTA must be read exactly before rematerialization')
+        record(types[0])
+    if 'call_to_actions' in afs:
+        actions=afs['call_to_actions']
+        if not isinstance(actions,list) or len(actions)!=1:raise ValueError('source CTA actions ambiguous or malformed')
+        action(actions[0])
+    for key,data in story.items():
+        if not key.endswith('_data'):continue
+        if not isinstance(data,dict):raise ValueError('source CTA native shape malformed')
+        if 'call_to_action' not in data:continue
+        if key not in {'video_data','link_data'}:raise ValueError('source CTA native shape unsupported')
+        native.append(key);action(data['call_to_action'])
+    if len(native)>1:raise ValueError('source CTA native branches ambiguous')
+    if not observed:raise ValueError('source CTA missing before rematerialization')
+    if len(set(observed))!=1:raise ValueError('source CTA evidence conflicts')
+    return observed[0]
+
+
