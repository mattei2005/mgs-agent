+            if (waited + delay > _READ_MAX_WAIT
+                    or now - started + delay >= _READ_MAX_ELAPSED):
+                raise ValueError('Discord permission proof rate limit wait bound exceeded')
+            if delay:
+                time.sleep(delay)
