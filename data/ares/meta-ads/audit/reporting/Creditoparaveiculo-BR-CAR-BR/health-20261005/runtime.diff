+def sb_health_pct(cdp_impressions, gam_code_served_count) -> float | None:
+    """Mirror the live Adgroup ESTIMATED_HEALTH calc, not CDP coverage."""
+    try:
+        matched, gam_matched = float(cdp_impressions), float(gam_code_served_count)
+    except (TypeError, ValueError):
+        return None
+    if not all(math.isfinite(value) and value >= 0 for value in (matched, gam_matched)):
+        return None
+    if gam_matched == 0:
+        return 0.0  # Explicit zero counters mirror the dashboard; absent rows remain n/d.
+    ratio = matched * 100.0 / gam_matched
+    return max(0.0, 200.0 - ratio if ratio > 100.0 else ratio)
+
+
+def health_label(value: float | None) -> str:
+    return "n/d" if value is None else f"{value:.2f}%".replace(".", ",")
+
+
+def sb_health_contract() -> dict:
+    return {
+        "source": "Smart Bidding Adgroup ESTIMATED_HEALTH",
+        "provider_frontend": "https://app.smartbiddingdigital.com/assets/fields-BYmzEr04.js",
+        "source_fields": ["CDP_IMPRESSIONS", "GAM_CODE_SERVED_COUNT"],
+        "aggregation": "sum source counters per campaign, then provider formula; never average percentages",
+        "formula": "x=CDP_IMPRESSIONS*100/GAM_CODE_SERVED_COUNT; max(0, x>100 ? 200-x : x); denominator=0 => 0",
+        "missing_data": "n/d when no SB row or any source counter is absent/invalid",
+        "decision_use": "diagnostic only; no change to campaign actions",
+    }
+
