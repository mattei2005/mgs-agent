class DiscordReportChunkingError(RuntimeError):
    """Report cannot be packed safely without breaking Discord formatting."""


class DiscordRateLimitExhausted(RuntimeError):
    """Discord kept returning HTTP 429 after the bounded Retry-After window."""


class DiscordPartialPostError(RuntimeError):
    """At least one Discord chunk exists, so another POST is unsafe."""

    def __init__(self, message_ids: list[str], cause: Exception):
        super().__init__(f"Discord partial post requires GET reconciliation: {type(cause).__name__}")
        self.message_ids = list(message_ids)
        self.cause = cause


def load_module(path: Path, name: str):
    spec = importlib.util.spec_from_file_location(name, str(path))
    if not spec or not spec.loader:
        raise RuntimeError(f"cannot load module {name}")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def as_float(value) -> float:
    try:
        return float(value or 0)
    except (TypeError, ValueError):
        return 0.0


def roi(revenue: float, spend: float) -> float | None:
    return None if spend <= 0 else (revenue - spend) * 100.0 / spend


def money(value: float) -> str:
    return f"${value:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")


def money_brl(value: float) -> str:
    return f"R$ {value:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")


def pct(value: float | None) -> str:
    return "n/d" if value is None else f"{value:+.1f}%".replace(".", ",")


def metric_money(value: float | None) -> str:
    return "n/d" if value is None else money(value)


def pct_unsigned(value: float | None) -> str:
    return "n/d" if value is None else f"{value:.2f}%".replace(".", ",")


def integer_pt(value) -> str:
    return f"{max(0, int(as_float(value))):,}".replace(",", ".")


def duration_hours_minutes(value) -> str:
    total_minutes = max(0, int(as_float(value)))
    hours, minutes = divmod(total_minutes, 60)
    return f"{hours}h {minutes:02d}min" if hours else f"{minutes}min"


def intraday_operational_highlights(delay_minutes, rewarded_current: dict, rewarded_previous: dict) -> list[str]:
    """Render the two operation-level signals Rodolfo needs to spot first."""
    return [
        f"**⏱️ ATRASO SMART BIDDING: {duration_hours_minutes(delay_minutes)}**",
        (
            f"**🎯 COBERTURA REWARDED: {pct_unsigned(rewarded_current.get('coverage_pct'))}** "
            f"· atual {integer_pt(rewarded_current.get('matched'))}/{integer_pt(rewarded_current.get('requests'))}"
        ),
        (
            f"⚪ Referência anterior/cinza: {pct_unsigned(rewarded_previous.get('coverage_pct'))} "
            f"· {integer_pt(rewarded_previous.get('matched'))}/{integer_pt(rewarded_previous.get('requests'))}"
        ),
    ]


def bid_strategy_label(campaign: dict, adsets: list[dict]) -> str:
    """Human reporting label from live campaign/adset bid configuration."""
    if any((row.get("bid_constraints") or {}).get("roas_average_floor") is not None for row in adsets):
        return "ROAS"
    strategy = str(campaign.get("bid_strategy") or "").upper()
    if strategy == "COST_CAP":
        amount = next((as_float(row.get("bid_amount")) for row in adsets if row.get("bid_amount") is not None), 0.0)
        return f"CPA {amount / 100.0:.2f}".replace(".", ",") if amount > 0 else "CPA"
    if strategy == "LOWEST_COST_WITHOUT_CAP":
        return "MAXVOL"
    return strategy or "n/d"


def short_status(value: str | None) -> str:
    text = str(value or "UNKNOWN").upper()
    return "DEL" if text == "ARCHIVED" else text


def operator_status(value: str | None) -> str:
    return {
        "ACTIVE": "ATIVA",
        "PAUSED": "PAUSADA",
        "ARCHIVED": "DELETED",
        "DELETED": "DELETED",
        "IN_PROCESS": "PROCESSANDO",
        "WITH_ISSUES": "COM ERRO",
    }.get(str(value or "UNKNOWN").upper(), str(value or "UNKNOWN").upper())


def daily_signal(actual_roi: float | None) -> str:
    if actual_roi is None:
        return "⚪"
    if actual_roi >= 0:
        return "🟢"
    if actual_roi > -10:
        return "🟡"
    return "🔴"


def roi_direction_signal(value: float | None) -> str:
    if value is None:
        return "⚪"
    if value > 0:
        return "🟢"
    if value < 0:
        return "🔴"
    return "🟡"


def intraday_signal(actual_roi: float | None, estimated_roi: float | None) -> str:
    """Render independent real/estimated ROI direction, in that order."""
    return f"{roi_direction_signal(actual_roi)}{roi_direction_signal(estimated_roi)}"


def intraday_action_display(decision_label: str) -> tuple[str, str]:
    text = str(decision_label or "").upper()
    if text.startswith("OBSERVAR D1/D2"):
        return "🧪", "APRENDIZADO D1/D2"
    if text.startswith("OBSERVAR"):
        return "👁️", text
    if text.startswith("MANTER"):
        return "✅", text
    if text.startswith("ESCALAR") or text.startswith("ESCALADO"):
        return "🚀", text
    if text.startswith("PAUS") or text.startswith("CORTE") or text.startswith("PARAR") or text == "BLOQUEADO":
        return "🛑", text
    if text == "JÁ EXECUTADO":
        return "✅", text
    if text == "PREPARAÇÃO":
        return "⏳", text
    if text.startswith("GATE"):
        return "⚠️", text
    return "➡️", text


def intraday_action_icon(decision_label: str) -> str:
    return intraday_action_display(decision_label)[0]


def intraday_action_label(decision_label: str) -> str:
    return intraday_action_display(decision_label)[1]


def apply_action_result_to_intraday_row(row: dict, action_result: dict | None) -> str:
    """Apply the same-checkpoint action readback before rendering the row."""
    decision_label = str(row.get("recommendation") or "").upper()
    if not action_result:
        return decision_label

    action_status = str(action_result.get("status") or "")
    action_type = str(action_result.get("action_type") or "")
    after = action_result.get("after") or {}
    if action_status in {"executed", "recovered_verified", "already_effective"} and isinstance(after, dict):
        if after.get("status"):
            row["status"] = after["status"]
        if after.get("daily_budget") is not None:
            row["budget_after_usd"] = _minor_units(after["daily_budget"]) / 100.0

    if action_status == "executed" and action_type == "scale_budget":
        decision_label = f"ESCALADO +{action_result.get('percent')}% ✓"
    elif action_status == "executed" and action_type == "pause_campaign":
        decision_label = "PAUSADO ✓"
    elif action_status in {"already_applied", "already_effective", "recovered_verified"}:
        decision_label = "JÁ EXECUTADO"
    elif action_status in {"blocked", "failed", "readback_deferred", "executed_conflict_hold"}:
        decision_label = "BLOQUEADO"
    return decision_label


def intraday_mobile_card(row: dict, decision_label: str, signal: str) -> str:
    """Render one campaign as the operator-approved mobile Discord card."""
    dlabel = f"D{row['cycle_day']}" if row.get("cycle_day") and row["cycle_day"] > 0 else "PREP"
    action_label = intraday_action_label(decision_label)
    budget_label = money(row.get("budget_after_usd", row["budget_usd"]))
    spend_label = money(row["meta_spend"])
    cost_label = "n/d" if row["meta_cost"] is None else money(row["meta_cost"])
    roas_label = "n/d" if row["meta_roas"] is None else f"{row['meta_roas']:.2f}".replace(".", ",")
    rps_label = metric_money(row.get("rps"))
    cpm_label = metric_money(row.get("cpm"))
    history_lines = [
        f"ROI {item['date_label']} {pct(item.get('roi'))}{' parcial' if item.get('partial') else ''}"
        for item in row.get("roi_history") or []
    ]
    metrics = [
        f"Budget {budget_label:<10}Spend {spend_label}",
        f"Custo  {cost_label:<10}ROAS  {roas_label}",
        f"ROI real {pct(row['sb_roi']):<8}ROI est {pct(row['estimated_roi'])}",
        f"RPS {rps_label:<12}CPM {cpm_label}",
    ]
    if history_lines:
        metrics.extend(["", *history_lines])
    return "\n".join(
        [
            f"{signal} **{row['campaign_label']} · {row['lance']} · {dlabel} · {operator_status(row['status'])}**",
            f"{intraday_action_icon(decision_label)} **{action_label}**",
            "```text",
            *metrics,
            "```",
        ]
    )


def daily_mobile_card(row: dict) -> str:
    """Render one Daily campaign card for mobile while desktop keeps its table."""
    signal = daily_signal(row["sb_roi"])
    budget_label = money(row["budget_usd"])
    spend_label = money(row["meta_spend"])
    cost_label = "n/d" if row["meta_cost"] is None else money(row["meta_cost"])
    roas_label = "n/d" if row["meta_roas"] is None else f"{row['meta_roas']:.2f}".replace(".", ",")
    return "\n".join(
        [
            f"{signal} **{row['campaign_label']} · {row['lance']} · {operator_status(row['status'])}**",
            "```text",
            f"Budget {budget_label:<10}Spend {spend_label}",
            f"Custo  {cost_label:<10}ROAS  {roas_label}",
            f"ROI SB  {pct(row['sb_roi'])}",
            "```",
        ]
    )


def aligned_table(headers: list[str], rows: list[list[str]]) -> str:
    def display_width(value) -> int:
        return sum(2 if unicodedata.east_asian_width(char) in {"W", "F"} else 1 for char in str(value))

    def pad(value, width: int) -> str:
        text = str(value)
        return text + " " * max(0, width - display_width(text))

    material = [headers] + rows
    widths = [max(display_width(row[i]) for row in material) for i in range(len(headers))]
    rendered = ["  ".join(pad(value, widths[i]) for i, value in enumerate(row)) for row in rows]
    header = "  ".join(pad(value, widths[i]) for i, value in enumerate(headers))
    divider = "  ".join("─" * width for width in widths)
    return "```text\n" + "\n".join([header, divider, *rendered]) + "\n```"


