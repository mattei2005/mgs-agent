    ]


def atomic_write_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    with temporary.open("w") as handle:
        handle.write(json.dumps(payload, ensure_ascii=False, indent=2) + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)
    directory_fd = os.open(path.parent, os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def load_guardrail_state() -> dict:
    if not GUARDRAIL_STATE.exists():
        return {"schema_version": "1.0", "campaigns": {}}
    try:
        state = json.loads(GUARDRAIL_STATE.read_text())
    except Exception as exc:
        raise RuntimeError("performance guardrail state is invalid; fail closed") from exc
    if not isinstance(state, dict) or not isinstance(state.get("campaigns", {}), dict):
        raise RuntimeError("performance guardrail state schema is invalid; fail closed")
    state.setdefault("schema_version", "1.0")
    state.setdefault("campaigns", {})
    return state


def guardrail_campaign_record(state: dict, row: dict) -> dict:
    campaign_id = str(row.get("campaign_id") or "")
    if not campaign_id:
        raise RuntimeError("campaign ID missing from performance guardrail state")
    record = state.setdefault("campaigns", {}).setdefault(campaign_id, {})
    record.update(
        campaign_id=campaign_id,
        campaign_number=str(row.get("number") or ""),
        cycle_start_date=str(row.get("cycle_start_date") or ""),
    )
    record.setdefault("morning_estimated_roi", {})
    record.setdefault("morning_actual_roi", {})
    record.setdefault("consecutive_16h_failures", 0)
    return record


def d3_estimated_negative_streak(row: dict, state: dict, target_date: str) -> bool:
    """D3 kill gate: estimated ROI negative at D1, D2 and current D3 08:00."""
    if int(row.get("cycle_day") or 0) != 3 or row.get("estimated_roi") is None:
        return False
    if float(row["estimated_roi"]) >= 0:
        return False
    record = (state.get("campaigns") or {}).get(str(row.get("campaign_id") or "")) or {}
    history = record.get("morning_estimated_roi") or {}
    cycle_values = {
        int(item.get("cycle_day") or 0): item.get("estimated_roi")
        for day_key, item in history.items()
        if day_key != target_date and isinstance(item, dict)
    }
    return all(day in cycle_values and cycle_values[day] is not None and float(cycle_values[day]) < 0 for day in (1, 2))


def verified_scale_today(target_date: str, campaign_id: str) -> dict:
    if not ACTION_STATE.exists():
        return {}
    try:
        state = json.loads(ACTION_STATE.read_text())
    except Exception:
        return {}
    key = f"{target_date}:08:{campaign_id}:scale_budget"
    prior = (state.get("applied") or {}).get(key) or {}
    return prior if str(prior.get("status") or "") in {"executed", "already_effective"} else {}


def scaled_today(target_date: str, campaign_id: str) -> bool:
    return bool(verified_scale_today(target_date, campaign_id))


def record_guardrail_checkpoint(rows: list[dict], target_date: str, decision_at_sp: datetime) -> dict:
    """Persist the exact 08:00 estimated ROI and 16:00 decision inputs without Meta writes."""
    if decision_at_sp.hour not in INTRADAY_ACTION_HOURS:
        return load_guardrail_state()
    ACTION_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with ACTION_LOCK.open("a+") as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        try:
            state = load_guardrail_state()
            for row in rows:
                if not row.get("autonomous_write_eligible", True):
                    continue
                record = guardrail_campaign_record(state, row)
                if decision_at_sp.hour == 8:
                    if row.get("estimated_roi") is not None:
                        record["morning_estimated_roi"][target_date] = {
                            "cycle_day": int(row.get("cycle_day") or 0),
                            "estimated_roi": float(row["estimated_roi"]),
                            "captured_at_sp": decision_at_sp.isoformat(),
                            "source": "Smart Bidding estimated ROI",
                        }
                    if row.get("sb_roi") is not None:
                        record["morning_actual_roi"][target_date] = {
                            "cycle_day": int(row.get("cycle_day") or 0),
                            "actual_roi": float(row["sb_roi"]),
                            "captured_at_sp": decision_at_sp.isoformat(),
                            "source": "Smart Bidding actual ROI",
                        }
                if decision_at_sp.hour == 16:
                    was_scaled = scaled_today(target_date, str(row.get("campaign_id") or ""))
                    record["last_16h_snapshot"] = {
                        "date": target_date,
                        "actual_roi": row.get("sb_roi"),
                        "estimated_roi": row.get("estimated_roi"),
                        "scaled_at_08": was_scaled,
                        "captured_at_sp": decision_at_sp.isoformat(),
                    }
                    trigger = (
                        was_scaled
                        and row.get("sb_roi") is not None
                        and float(row["sb_roi"]) < 0
                        and row.get("estimated_roi") is not None
                        and float(row["estimated_roi"]) < 0
                    )
                    breaks_sequence = (
                        not was_scaled
                        or (
                            row.get("sb_roi") is not None
                            and row.get("estimated_roi") is not None
                            and not trigger
                        )
                    )
                    if breaks_sequence:
                        record["consecutive_16h_failures"] = 0
                        record.pop("pending_reactivation", None)
                record["updated_at_sp"] = decision_at_sp.isoformat()
            atomic_write_json(GUARDRAIL_STATE, state)
            return state
        finally:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)


def record_confirmed_guardrail_pause(row: dict, target_date: str, decision_at_sp: datetime, action: str) -> None:
    state = load_guardrail_state()
    record = guardrail_campaign_record(state, row)
    prior_pause = record.get("last_confirmed_pause") or {}
    if prior_pause.get("date") == target_date and prior_pause.get("action") == action and prior_pause.get("verified") is True:
        return
    if action == "PAUSAR 16H TEMPORÁRIO":
        count = int(record.get("consecutive_16h_failures") or 0) + 1
        if count >= 3:
            raise RuntimeError("temporary pause cannot be recorded as a third recurrence")
        record["consecutive_16h_failures"] = count
        record["pending_reactivation"] = {
            "provenance": "post_scale_16h",
            "due_date": (decision_at_sp.date() + timedelta(days=1)).isoformat(),
            "due_time": "00:30",
            "status": "pending",
            "pause_date": target_date,
        }
        record["terminal"] = False
    else:
        if action == "PARAR RECORRÊNCIA":
            record["consecutive_16h_failures"] = max(3, int(record.get("consecutive_16h_failures") or 0) + 1)
        record["terminal"] = True
        record["terminal_reason"] = action
        record.pop("pending_reactivation", None)
    record["last_confirmed_pause"] = {
        "action": action,
        "date": target_date,
        "paused_at_sp": decision_at_sp.isoformat(),
        "actual_roi": row.get("sb_roi"),
        "estimated_roi": row.get("estimated_roi"),
        "verified": True,
    }
    record["updated_at_sp"] = decision_at_sp.isoformat()
    atomic_write_json(GUARDRAIL_STATE, state)


def campaign_number(name: str | None, utm: str | None = None) -> str:
    text = str(name or "").strip()
    match = re.match(r"^(\d{1,3})\s+-", text)
    if match:
        return match.group(1).zfill(2)
    match = re.search(r"b01fb13c(\d{1,3})", str(utm or text), re.I)
    return match.group(1).zfill(2) if match else "??"


def operation_campaign_number(name: str | None, utm: str | None = None) -> str | None:
    """Return the CPV number only for the account-specific UTM lineage."""
    text = f"{name or ''} {utm or ''}"
    match = re.search(r"\bb01fb13c(\d{1,3})\b", text, re.I)
    if not match:
        return None
    number = match.group(1).zfill(2)
    return number if 1 <= int(number) <= 999 else None


def has_material_report_metrics(meta_row: dict | None, sb_row: dict | None) -> bool:
    """Reject zero-only historical/ghost rows that have no current Meta object."""
    meta_row = meta_row or {}
    sb_row = sb_row or {}
    return any(
        abs(as_float(value)) > 1e-9
        for value in (
            meta_row.get("spend"),
            sb_row.get("investment"),
            sb_row.get("net_revenue"),
        )
    )


def report_campaign_ids(
    campaigns: list[dict],
    meta_agg: dict[str, dict] | None = None,
    sb_agg: dict[str, dict] | None = None,
) -> list[str]:
    """Discover report scope dynamically without expanding write authority."""
    meta_agg = meta_agg or {}
    sb_agg = sb_agg or {}
    selected: set[str] = set()
    by_id = {str(row.get("id") or ""): row for row in campaigns if row.get("id")}
    metric_ids = {
        cid
        for cid in set(meta_agg) | set(sb_agg)
        if has_material_report_metrics(meta_agg.get(cid), sb_agg.get(cid))
    }

    for cid, campaign in by_id.items():
        if operation_campaign_number(campaign.get("name")) is None:
            continue
        status = str(campaign.get("configured_status") or campaign.get("status") or "").upper()
        if status not in {"ARCHIVED", "DELETED"} or cid in metric_ids:
            selected.add(cid)

    for cid in metric_ids - set(by_id):
        meta_row = meta_agg.get(cid) or {}
        sb_row = sb_agg.get(cid) or {}
        name = meta_row.get("name") or sb_row.get("name")
        utms = " ".join(sb_row.get("utm_adgroups") or [])
        if operation_campaign_number(name, utms) is not None:
            selected.add(cid)

    def sort_key(cid: str) -> tuple[int, str]:
        campaign = by_id.get(cid) or {}
        meta_row = meta_agg.get(cid) or {}
        sb_row = sb_agg.get(cid) or {}
        number = operation_campaign_number(
            campaign.get("name") or meta_row.get("name") or sb_row.get("name"),
            " ".join(sb_row.get("utm_adgroups") or []),
        )
        return (int(number or 1000), cid)

    return sorted(selected, key=sort_key)


def campaign_cycle_start_date(campaign: dict, configured: dict, today: date) -> str:
    configured_date = str(configured.get("cycle_start_date") or "")
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", configured_date):
        return configured_date

    match = re.match(r"^\d{1,3}\s+-\s+(\d{2})-(\d{2})\s+-", str(campaign.get("name") or ""))
    if match:
        day, month = map(int, match.groups())
        candidates = []
        for year in (today.year - 1, today.year, today.year + 1):
            try:
                candidates.append(date(year, month, day))
            except ValueError:
                pass
        if candidates:
            return min(candidates, key=lambda value: abs((value - today).days)).isoformat()

    for field in ("start_time", "created_time"):
        raw = campaign.get(field)
        if not raw:
            continue
        try:
            return datetime.fromisoformat(str(raw)).astimezone(SP).date().isoformat()
        except ValueError:
            continue
    raise RuntimeError(f"campaign operational start date unavailable: {campaign.get('id')}")


def table_pages(
    headers: list[str],
    rows: list[list[str]],
    page_size: int | None = None,
    max_chars: int = 1800,
) -> list[str]:
    """Paginate by actual rendered size; an explicit row cap is test/compat only."""
    if page_size is not None:
        if page_size < 1:
            raise ValueError("table page_size must be positive")
        return [aligned_table(headers, rows[index:index + page_size]) for index in range(0, len(rows), page_size)]
    if max_chars < 1:
        raise ValueError("table max_chars must be positive")
    pages: list[str] = []
    page_rows: list[list[str]] = []
    for row in rows:
        candidate = aligned_table(headers, [*page_rows, row])
        if len(candidate) <= max_chars:
            page_rows.append(row)
            continue
        if not page_rows:
            raise DiscordReportChunkingError("single rendered table row exceeds safe page limit")
        pages.append(aligned_table(headers, page_rows))
        page_rows = [row]
        if len(aligned_table(headers, page_rows)) > max_chars:
            raise DiscordReportChunkingError("single rendered table row exceeds safe page limit")
    if page_rows:
        pages.append(aligned_table(headers, page_rows))
    return pages


def prefixed_table_pages(
    headers: list[str],
    rows: list[list[str]],
    prefix_lines: list[str],
    *,
    max_chars: int = 1800,
) -> list[str]:
    """Keep a report summary and the first table page in one safe Discord chunk."""
    prefix = "\n".join(line if line else "\u200b" for line in prefix_lines).rstrip()
    if not prefix:
        return table_pages(headers, rows, max_chars=max_chars)
    atomic_separator = "\n\u200b\n"
    first_rows: list[list[str]] = []
    for row in rows:
        candidate_table = aligned_table(headers, [*first_rows, row])
        candidate = f"{prefix}{atomic_separator}{candidate_table}"
        if len(candidate) <= max_chars:
            first_rows.append(row)
            continue
        break
    if rows and not first_rows:
        raise DiscordReportChunkingError("summary plus one table row exceeds safe page limit")
    first_table = aligned_table(headers, first_rows)
    pages = [f"{prefix}{atomic_separator}{first_table}"]
    pages.extend(table_pages(headers, rows[len(first_rows):], max_chars=max_chars))
    return pages


def compact_campaign_label(
    number: str,
    name: str | None,
    *date_candidates: str | None,
) -> str:
    raw_name = str(name or "")
    moto_marker = "M" if re.search(r"(?<![A-Z0-9])MOTO(?![A-Z0-9])", raw_name, re.IGNORECASE) else ""
    match = re.match(r"^\d{1,3}\s+-\s+(\d{2})-(\d{2})\s+-", raw_name)
    if match:
        return f"C{number}{moto_marker}-{match.group(1)}/{match.group(2)}"
    for candidate in date_candidates:
        if not candidate:
            continue
        try:
            raw = str(candidate)
            parsed_date = date.fromisoformat(raw[:10]) if re.fullmatch(r"\d{4}-\d{2}-\d{2}", raw[:10]) else datetime.fromisoformat(raw).astimezone(SP).date()
            return f"C{number}{moto_marker}-{parsed_date.strftime('%d/%m')}"
        except (TypeError, ValueError):
            continue
    return f"C{number}{moto_marker}"


def parse_purchase_roas(row: dict) -> float | None:
    for entry in row.get("purchase_roas") or []:
        if str(entry.get("action_type") or "") == "omni_purchase":
            return as_float(entry.get("value"))
    values = row.get("purchase_roas") or []
    return as_float(values[0].get("value")) if values else None


def parse_action_value(row: dict, action_type: str) -> float:
    for entry in row.get("actions") or []:
        if str(entry.get("action_type") or "") == action_type:
            return as_float(entry.get("value"))
    return 0.0


def graph_pages(meta, path: str, token: str, params: dict) -> list[dict]:
    status, body, _ = meta.graph_get(path, token, params)
    if status != 200 or not isinstance(body, dict):
        raise RuntimeError(f"Meta GET {path} failed HTTP {status}")
    rows = list(body.get("data") or [])
    next_url = (body.get("paging") or {}).get("next")
    while next_url:
        parsed = urllib.parse.urlparse(next_url)
        path_parts = parsed.path.strip("/").split("/", 1)
        next_path = path_parts[1] if len(path_parts) == 2 and re.fullmatch(r"v\d+\.\d+", path_parts[0]) else parsed.path.strip("/")
        next_params = {
            key: values[-1]
            for key, values in urllib.parse.parse_qs(parsed.query).items()
            if key != "access_token"
        }
        status, body, _ = meta.graph_get(next_path, token, next_params)
        if status != 200 or not isinstance(body, dict):
            raise RuntimeError(f"Meta paginated GET {next_path} failed HTTP {status}")
        rows.extend(body.get("data") or [])
        next_url = (body.get("paging") or {}).get("next")
    return rows


def fetch_meta(target_date: str) -> dict:
    meta = load_module(META_COMMON, "ares_meta_common_reports")
    token, field = meta.get_token_from_1password(META_ITEM, force_refresh=False)
    account_status, account, _ = meta.graph_get(
        ACCOUNT_ACT,
        token,
        {"fields": "id,name,currency,timezone_name,account_status,disable_reason"},
    )
    if account_status != 200 or not isinstance(account, dict):
        raise RuntimeError(f"Meta account preflight failed HTTP {account_status}")
    campaigns = graph_pages(
        meta,
        f"{ACCOUNT_ACT}/campaigns",
        token,
        {
            "fields": "id,name,status,effective_status,configured_status,daily_budget,lifetime_budget,bid_strategy,created_time,start_time,stop_time,updated_time",
            "limit": 500,
        },
    )
    adsets = graph_pages(
        meta,
        f"{ACCOUNT_ACT}/adsets",
        token,
        {
            "fields": "id,name,campaign_id,status,effective_status,configured_status,bid_amount,bid_constraints,optimization_goal",
            "limit": 500,
        },
    )
    insights = graph_pages(
        meta,
        f"{ACCOUNT_ACT}/insights",
        token,
        {
            "fields": "campaign_id,campaign_name,spend,purchase_roas,impressions,clicks,actions",
            "level": "campaign",
            "time_increment": 1,
            "time_range": json.dumps({"since": target_date, "until": target_date}, separators=(",", ":")),
            "limit": 500,
        },
    )
    return {
        "account": account,
        "campaigns": campaigns,
        "adsets": adsets,
        "insights": insights,
        "credential_report": {"item": META_ITEM, "field": field, "token_len": len(token)},
    }


def fetch_meta_period_insights(initial_date: str, final_date: str) -> list[dict]:
    """Fetch campaign-level Meta delivery for a bounded decision period."""
    meta = load_module(META_COMMON, "ares_meta_common_period_insights")
    token, _ = meta.get_token_from_1password(META_ITEM, force_refresh=False)
    return graph_pages(
        meta,
        f"{ACCOUNT_ACT}/insights",
        token,
        {
            "fields": "campaign_id,campaign_name,spend,purchase_roas,impressions,clicks,actions",
            "level": "campaign",
            "time_increment": 1,
            "time_range": json.dumps({"since": initial_date, "until": final_date}, separators=(",", ":")),
            "limit": 500,
        },
    )


def fetch_meta_ad_insights(initial_date: str, final_date: str) -> list[dict]:
    """Fetch cumulative ad-level delivery only for creative classification."""
    meta = load_module(META_COMMON, "ares_meta_common_creative_lifecycle")
    token, _ = meta.get_token_from_1password(META_ITEM, force_refresh=False)
    return graph_pages(
        meta,
        f"{ACCOUNT_ACT}/insights",
        token,
        {
            "fields": "campaign_id,campaign_name,ad_id,ad_name,spend,impressions",
            "level": "ad",
            "time_range": json.dumps({"since": initial_date, "until": final_date}, separators=(",", ":")),
            "limit": 500,
        },
    )


def execute_creative_lifecycle(
    rows: list[dict],
    action_results: list[dict],
    target_date: str,
    now_sp: datetime,
    reconciliation: dict,
    operation: dict,
) -> dict:
    policy = operation.get("creative_performance_lifecycle") or {}
    checkpoint_hours = {
        int(str(value).split(":", 1)[0])
        for value in policy.get("checkpoints_sp") or []
        if re.fullmatch(r"\d{2}:\d{2}", str(value))
    }
    if policy.get("enabled") is not True or now_sp.hour not in checkpoint_hours:
        return {"status": "DISABLED_OR_NOT_DUE", "decisions": [], "meta_writes": 0}
    guardrail_state = load_guardrail_state()
    terminal_reasons = set((policy.get("rejected") or {}).get("requires_terminal_reason_any") or [])
    successful_action_statuses = {"executed", "already_applied", "already_effective", "recovered_verified"}
    terminal_campaign_ids = {
        str(item.get("campaign_id") or "")
        for item in action_results
        if str(item.get("recommendation") or "") in terminal_reasons
        and str(item.get("status") or "") in successful_action_statuses
    }
    terminal_campaign_ids.update(
        str(campaign_id)
        for campaign_id, state in (guardrail_state.get("campaigns") or {}).items()
        if state.get("terminal") is True and str(state.get("terminal_reason") or "") in terminal_reasons
    )
    candidates = [
        row
        for row in rows
        if int(row.get("cycle_day") or 0) in {3, 4, 5}
        or str(row.get("campaign_id") or "") in terminal_campaign_ids
    ]
    if not candidates:
        return {"status": "NO_ELIGIBLE_CAMPAIGN_DAY", "decisions": [], "meta_writes": 0}
    initial_date = min(str(row.get("cycle_start_date") or target_date) for row in candidates)
    ad_insights = fetch_meta_ad_insights(initial_date, target_date)
    scripts_path = str(BASE / "scripts")
    if scripts_path not in sys.path:
        sys.path.insert(0, scripts_path)
    from ares_campaign_v3.creative_lifecycle import run_live_lifecycle

    return run_live_lifecycle(
        campaigns=candidates,
        ad_insights=ad_insights,
        checkpoint_state=guardrail_state,
        action_results=action_results,
        now_sp=now_sp,
        lifecycle_policy=policy,
        anomaly=bool(reconciliation.get("anomaly")),
    )


TERMINAL_META_STATUSES = {"DELETED", "ARCHIVED"}
POST_CUT_SUCCESS_ACTION_STATUSES = {"executed", "already_applied", "already_effective", "recovered_verified"}


def _post_cut_finalization_evidence(
    creative_lifecycle: dict,
    campaign_ids: set[str],
    required_assets_per_campaign: int,
) -> dict[str, dict]:
    """Prove each terminal campaign's Drive/inventory finalization, including crash recovery."""
    decisions_by_campaign: dict[str, list[dict]] = defaultdict(list)
    readback_by_asset = {
        str(item.get("asset_id") or ""): item
        for item in creative_lifecycle.get("inventory_readback") or []
    }
    for decision in creative_lifecycle.get("decisions") or []:
        campaign_id = str(decision.get("campaign_id") or "")
        if campaign_id in campaign_ids:
            decisions_by_campaign[campaign_id].append(decision)

    evidence: dict[str, dict] = {}
    for campaign_id, decisions in decisions_by_campaign.items():
        asset_ids = {str(item.get("asset_id") or "") for item in decisions if item.get("asset_id")}
        valid = (
            len(asset_ids) == required_assets_per_campaign
            and all(str(item.get("target_status") or "") in {"03_TESTED", "05_REJECTED"} for item in decisions)
            and all((readback_by_asset.get(asset_id) or {}).get("ok") is True for asset_id in asset_ids)
        )
        if valid:
            evidence[campaign_id] = {
                "source": "current_lifecycle_readback",
                "asset_ids": sorted(asset_ids),
                "count": len(asset_ids),
                "ok": True,
            }

    missing = campaign_ids - set(evidence)
    if not missing:
        return evidence
    inventory_path = BASE / "data/ares/creative-ops/inventory/assets.jsonl"
    inventory = [
        json.loads(line)
        for line in inventory_path.read_text(encoding="utf-8").splitlines()
        if line.strip()
    ]
    recovered: dict[str, set[str]] = defaultdict(set)
    for row in inventory:
        asset_id = str(row.get("asset_id") or "")
        for event in reversed(row.get("classification_history") or []):
            campaign_id = str(event.get("campaign_id") or "")
            if campaign_id not in missing:
                continue
            target = str(event.get("target_status") or "")
            drive_readback = event.get("drive_readback") or {}
            if (
                target in {"03_TESTED", "05_REJECTED"}
                and str(row.get("status") or "") == target
                and str(drive_readback.get("target_status") or "") == target
                and str(drive_readback.get("driveId") or "") == "0AEwt4Ye690ocUk9PVA"
                and str(drive_readback.get("id") or "") == str(row.get("asset_drive_id") or "")
            ):
                recovered[campaign_id].add(asset_id)
            break
    for campaign_id, asset_ids in recovered.items():
        if len(asset_ids) == required_assets_per_campaign:
            evidence[campaign_id] = {
                "source": "inventory_classification_history_recovery",
                "asset_ids": sorted(asset_ids),
                "count": len(asset_ids),
                "ok": True,
            }
    return evidence


def _terminal_campaign_readback(meta, token: str, campaign_id: str, attempts: int = 3) -> tuple[bool, int, dict]:
    last_http = 0
    last_payload: dict = {}
    for attempt in range(attempts):
        last_http, payload, _ = meta.graph_get(
            campaign_id,
            token,
            {"fields": "id,name,status,configured_status,effective_status,daily_budget,updated_time"},
        )
        last_payload = payload if isinstance(payload, dict) else {}
        raw_statuses = {
            str(last_payload.get("status") or "").upper(),
            str(last_payload.get("configured_status") or "").upper(),
            str(last_payload.get("effective_status") or "").upper(),
        }
        if last_http == 200 and raw_statuses & TERMINAL_META_STATUSES:
            return True, last_http, last_payload
        if attempt + 1 < attempts:
            time.sleep(2)
    return False, last_http, last_payload


def execute_terminal_post_cut_cleanup(
    rows: list[dict],
    action_results: list[dict],
    creative_lifecycle: dict,
    now_sp: datetime,
    operation: dict,
) -> dict:
    """Immediately finish creatives and delete campaigns after a verified terminal pause."""
    policy = operation.get("post_cut_lifecycle") or {}
    if policy.get("enabled") is not True:
        return {"status": "DISABLED", "results": [], "meta_writes": 0}
    terminal_reasons = set(policy.get("terminal_reasons") or [])
    if not terminal_reasons:
        return {"status": "BLOCKED_POLICY_EMPTY", "results": [], "meta_writes": 0}
    guardrail = load_guardrail_state()
    rows_by_campaign = {str(row.get("campaign_id") or ""): row for row in rows if row.get("campaign_id")}
    targets: dict[str, str] = {}
    for item in action_results:
        campaign_id = str(item.get("campaign_id") or "")
        reason = str(item.get("recommendation") or "")
        if campaign_id and reason in terminal_reasons and str(item.get("status") or "") in POST_CUT_SUCCESS_ACTION_STATUSES:
            targets[campaign_id] = reason
    for campaign_id, state in (guardrail.get("campaigns") or {}).items():
        reason = str(state.get("terminal_reason") or "")
        row = rows_by_campaign.get(str(campaign_id)) or {}
        status = str(row.get("status") or row.get("configured_status") or "").upper()
        if state.get("terminal") is True and reason in terminal_reasons and status in {"PAUSED", "DELETED", "ARCHIVED"}:
            targets[str(campaign_id)] = reason
    if not targets:
        return {"status": "NO_TERMINAL_CUT", "results": [], "meta_writes": 0}

    required_assets = int(policy.get("required_assets_per_campaign") or 3)
    finalization = _post_cut_finalization_evidence(creative_lifecycle, set(targets), required_assets)
    POST_CUT_LOCK.parent.mkdir(parents=True, exist_ok=True)
    results: list[dict] = []
    meta_writes = 0
    with POST_CUT_LOCK.open("a+") as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        try:
            if POST_CUT_STATE.exists():
                try:
                    state = json.loads(POST_CUT_STATE.read_text(encoding="utf-8"))
                except Exception as exc:
                    raise RuntimeError("post-cut lifecycle state is invalid; fail closed") from exc
            else:
                state = {"schema_version": "1.0", "campaigns": {}}
            state_campaigns = state.setdefault("campaigns", {})
            ready_ids = {campaign_id for campaign_id in targets if (finalization.get(campaign_id) or {}).get("ok") is True}
            meta = None
            token = None
            token_field = None
            if ready_ids:
                meta = load_module(META_COMMON, "ares_meta_common_post_cut_cleanup")
                token, token_field = meta.get_token_from_1password(META_ITEM, force_refresh=False)
            for campaign_id, terminal_reason in sorted(targets.items()):
                proof = finalization.get(campaign_id)
                record = {
                    "campaign_id": campaign_id,
                    "terminal_reason": terminal_reason,
                    "creative_finalization": proof,
                    "status": "pending",
                }
                results.append(record)
                if not proof or proof.get("ok") is not True:
                    record.update(status="blocked", reason="creative_finalization_incomplete")
                    continue
                prior = state_campaigns.get(campaign_id) or {}
                if prior.get("status") == "completed":
                    record.update(status="already_completed", prior=prior)
                    continue
                assert meta is not None and token is not None
                preflight_http, before, _ = meta.graph_get(
                    campaign_id,
                    token,
                    {"fields": "id,name,status,configured_status,effective_status,daily_budget,updated_time"},
                )
                record["preflight_http"] = preflight_http
                record["before"] = before if preflight_http == 200 else _safe_error(meta, before)
                if preflight_http != 200 or not isinstance(before, dict):
                    record.update(status="blocked", reason="campaign_preflight_failed")
                    continue
                before_statuses = {
                    str(before.get("status") or "").upper(),
                    str(before.get("configured_status") or "").upper(),
                    str(before.get("effective_status") or "").upper(),
                }
                if before_statuses & TERMINAL_META_STATUSES:
                    state_campaigns[campaign_id] = {
                        "status": "completed",
                        "terminal_reason": terminal_reason,
                        "completed_at_sp": datetime.now(SP).isoformat(),
                        "recovered_by_get": True,
                        "api_raw_status": sorted(before_statuses & TERMINAL_META_STATUSES)[0],
                        "creative_finalization": proof,
                    }
                    atomic_write_json(POST_CUT_STATE, state)
                    record.update(status="already_deleted_verified", verified=True, after=before)
                    continue
                if "PAUSED" not in before_statuses:
                    record.update(status="blocked", reason="campaign_not_paused_terminal")
                    continue
                fresh_operation = json.loads(OP_PATH.read_text(encoding="utf-8"))
                fresh_policy = fresh_operation.get("post_cut_lifecycle") or {}
                if (
                    fresh_policy.get("enabled") is not True
                    or fresh_policy.get("delete_after_creative_finalization") is not True
                    or int(fresh_policy.get("retention_hours") or 0) != 0
                    or terminal_reason not in set(fresh_policy.get("terminal_reasons") or [])
                ):
                    record.update(status="blocked", reason="post_cut_policy_changed_before_delete")
                    continue
                state_campaigns[campaign_id] = {
                    "status": "delete_in_flight",
                    "terminal_reason": terminal_reason,
                    "expected_status": "PAUSED",
                    "requested_status": "DELETED",
                    "recorded_at_sp": datetime.now(SP).isoformat(),
                    "creative_finalization": proof,
                }
                state["updated_at_sp"] = datetime.now(SP).isoformat()
                atomic_write_json(POST_CUT_STATE, state)
                try:
                    write_http, write_payload, _ = meta.graph_post_once(campaign_id, token, {"status": "DELETED"})
                    meta_writes += 1
                    record["write_http"] = write_http
                    record["write_result"] = write_payload if write_http == 200 else _safe_error(meta, write_payload)
                except Exception as exc:
                    meta_writes += 1
                    record["write_exception"] = type(exc).__name__
                verified, readback_http, after = _terminal_campaign_readback(meta, token, campaign_id)
                record["readback_http"] = readback_http
                record["after"] = after if readback_http == 200 else _safe_error(meta, after)
                if not verified:
                    state_campaigns[campaign_id].update(
                        status="delete_unconfirmed_hold",
                        last_readback_http=readback_http,
                        updated_at_sp=datetime.now(SP).isoformat(),
                    )
                    atomic_write_json(POST_CUT_STATE, state)
                    record.update(status="failed", reason="delete_readback_mismatch_or_deferred")
                    continue
                raw_statuses = {
                    str(after.get("status") or "").upper(),
                    str(after.get("configured_status") or "").upper(),
                    str(after.get("effective_status") or "").upper(),
                }
                raw_terminal = sorted(raw_statuses & TERMINAL_META_STATUSES)[0]
                recovered_after_post_error = bool(record.get("write_http") != 200 or record.get("write_exception"))
                state_campaigns[campaign_id] = {
                    "status": "completed",
                    "terminal_reason": terminal_reason,
                    "completed_at_sp": datetime.now(SP).isoformat(),
                    "api_raw_status": raw_terminal,
                    "recovered_after_post_error": recovered_after_post_error,
                    "creative_finalization": proof,
                }
                state["updated_at_sp"] = datetime.now(SP).isoformat()
                atomic_write_json(POST_CUT_STATE, state)
                record.update(
                    status="executed",
                    verified=True,
                    ads_manager_status="DELETED",
                    api_raw_status=raw_terminal,
                    recovered_after_post_error=recovered_after_post_error,
                )
            audit = {
                "schema_version": "1.0",
                "kind": "terminal_post_cut_lifecycle",
                "created_at_sp": datetime.now(SP).isoformat(),
                "authorized_by": "Rodolfo Mattei",
                "operation_id": operation.get("operation_id"),
                "playbook_version": operation.get("playbook_version"),
                "policy": policy,
                "token_report": ({"item": META_ITEM, "field": token_field, "len": len(token)} if token else None),
                "creative_lifecycle_audit": creative_lifecycle.get("audit"),
                "results": results,
                "meta_writes": meta_writes,
            }
            POST_CUT_AUDIT_ROOT.mkdir(parents=True, exist_ok=True)
            audit_path = POST_CUT_AUDIT_ROOT / f"post-cut-{datetime.now(UTC).strftime('%Y%m%dT%H%M%S%fZ')}.json"
            atomic_write_json(audit_path, audit)
            blocked = [item for item in results if item.get("status") in {"blocked", "failed"}]
            return {
                "status": "PARTIAL_BLOCKED" if blocked else "COMPLETED",
                "results": results,
                "meta_writes": meta_writes,
                "audit": str(audit_path),
            }
        finally:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)


def sb_payload(target_date: str) -> dict:
    return {
        "initialDate": f"{target_date}T00:00:00.000Z",
        "finalDate": f"{target_date}T23:59:59.999Z",
        "publishers": [PUBLISHER],
        "currency": "USD",
    }


def sb_range_payload(initial_date: str, final_date: str) -> dict:
    return {
        "initialDate": f"{initial_date}T00:00:00.000Z",
        "finalDate": f"{final_date}T23:59:59.999Z",
        "publishers": [PUBLISHER],
        "currency": "USD",
    }


def fetch_sb_roi_history(initial_date: str, final_date: str) -> dict:
    """Fetch only acquisition rows for prior daily ROI history in one request."""
    sb = load_module(SB_COMMON, "ares_sb_common_roi_history")
    payload = sb_range_payload(initial_date, final_date)
    status, rows, token_report = sb.api_request(
        "POST", "/report/performance_per_campaigns", payload=payload, item_name=SB_ITEM
    )
    if status not in {200, 201} or not isinstance(rows, list):
        raise RuntimeError(f"SB ROI history report failed HTTP {status}")
    rows = [
        row for row in rows
        if initial_date <= str(row.get("DATE") or "")[:10] <= final_date
        and str(row.get("DOMAIN") or "").lower() == DOMAIN
        and str(row.get("CUSTOMER_ID") or "").replace("act_", "") == ACCOUNT_ID
    ]
    return {"rows": rows, "token_report": token_report, "payload": payload}


def fetch_sb(target_date: str, include_estimated: bool, *, include_sms: bool = True) -> dict:
    sb = load_module(SB_COMMON, "ares_sb_common_reports")
    payload = sb_payload(target_date)
    status, rows, token_report = sb.api_request(
        "POST", "/report/performance_per_campaigns", payload=payload, item_name=SB_ITEM
    )
    if status not in {200, 201} or not isinstance(rows, list):
        raise RuntimeError(f"SB acquisition report failed HTTP {status}")
    rows = [
        row for row in rows
        if str(row.get("DATE") or "")[:10] == target_date
        and str(row.get("DOMAIN") or "").lower() == DOMAIN
        and str(row.get("CUSTOMER_ID") or "").replace("act_", "") == ACCOUNT_ID
    ]
    result = {
        "rows": rows,
        "sms_rows": [],
        "token_report": token_report,
        "payload": payload,
    }
    if include_sms:
        sms_status, sms_rows, _ = sb.api_request(
            "POST", "/report/performance_per_sms", payload=payload, item_name=SB_ITEM
        )
        if sms_status not in {200, 201} or not isinstance(sms_rows, list):
            raise RuntimeError(f"SB SMS report failed HTTP {sms_status}")
        result["sms_rows"] = [
            row for row in sms_rows
            if str(row.get("DATE") or "")[:10] == target_date
            and str(row.get("UTM_CAMPAIGN") or "").lower() == SMS_BUCKET
        ]
    if include_estimated:
        estimated_payload = {"publisherIds": [PUBLISHER], "currency": "USD"}
        d_status, delay, _ = sb.api_request("POST", "/estimated/delay", payload=estimated_payload, item_name=SB_ITEM)
        e_status, estimated, _ = sb.api_request(
            "POST", "/estimated/revenue/utm_adgroup", payload=estimated_payload, item_name=SB_ITEM
        )
        if d_status not in {200, 201} or e_status not in {200, 201}:
            raise RuntimeError(f"SB estimated endpoints failed HTTP {d_status}/{e_status}")
        result["delay"] = delay if isinstance(delay, dict) else {}
        result["estimated"] = estimated if isinstance(estimated, dict) else {}
    return result


def rewarded_coverage_pct(matched: float, requests: float) -> float | None:
    if requests <= 0:
        return None
    value = (Decimal(str(matched)) * Decimal("100") / Decimal(str(requests))).quantize(
        Decimal("0.01"), rounding=ROUND_HALF_UP
    )
    return float(value)


def parse_rewarded_pricing(payload: dict) -> dict:
    """Mirror Pricing filter=rewarded using its live contiguous rec waterfall."""
    if not isinstance(payload, dict):
        raise RuntimeError("Smart Bidding Pricing payload is invalid")
    if str(payload.get("publisherId") or "") != PUBLISHER:
        raise RuntimeError("Smart Bidding Pricing publisher mismatch")
    if str(payload.get("currency") or "").upper() != "USD":
        raise RuntimeError("Smart Bidding Pricing currency is not USD")

    def slot_index(slot_id: str) -> int | None:
        if slot_id == REWARDED_SLOT_BASE:
            return 0
        match = re.fullmatch(rf"{re.escape(REWARDED_SLOT_BASE)}_([1-9]\d*)", slot_id)
        return int(match.group(1)) if match else None

    selected: dict[str, dict] = {}
    selected_indices: dict[int, str] = {}
    for rule in payload.get("rules") or []:
        if not isinstance(rule, dict):
            continue
        targeting = rule.get("targeting") or {}
        slot_id = str(targeting.get("slot_id") or "")
        index = slot_index(slot_id)
        if (
            str(rule.get("operationGroup") or "") != REWARDED_OPERATION_GROUP
            or str(rule.get("operation") or "") != REWARDED_OPERATION
            or str(targeting.get("utm_source") or "").lower() != "facebook"
            or str(targeting.get("vertical") or "").lower() != "car"
            or str(targeting.get("pathname") or "") != REWARDED_PATHNAME
            or str(targeting.get("utm_medium") or "") != ".*-s$"
            or index is None
        ):
            continue
        if slot_id in selected or index in selected_indices:
            raise RuntimeError(f"duplicate rewarded Pricing rule: {slot_id}")
        selected[slot_id] = rule
        selected_indices[index] = slot_id

    if 0 not in selected_indices:
        raise RuntimeError(f"rewarded Pricing waterfall incomplete: missing=['{REWARDED_SLOT_BASE}']")
    expected_indices = set(range(max(selected_indices) + 1))
    if set(selected_indices) != expected_indices:
        missing = [
            REWARDED_SLOT_BASE if index == 0 else f"{REWARDED_SLOT_BASE}_{index}"
            for index in sorted(expected_indices - set(selected_indices))
        ]
        raise RuntimeError(f"rewarded Pricing waterfall incomplete: missing={missing}")
    ordered_slots = [selected_indices[index] for index in sorted(selected_indices)]
    configured_slot_count = len(REWARDED_SLOT_SUFFIXES)

    def snapshot(metric_key: str) -> dict:
        base_metrics = selected[REWARDED_SLOT_BASE].get(metric_key) or {}
        requests = as_float(base_metrics.get("gamRequests"))
        matched = sum(
            as_float((selected[slot].get(metric_key) or {}).get("gamMatchedRequests"))
            for slot in ordered_slots
        )
        dates = {
            str((selected[slot].get(metric_key) or {}).get("date") or "")
            for slot in ordered_slots
            if (selected[slot].get(metric_key) or {}).get("date")
        }
        if len(dates) > 1:
            raise RuntimeError(f"rewarded Pricing dates diverged for {metric_key}")
        return {
            "date": next(iter(dates), None),
            "requests": int(requests),
            "matched": int(matched),
            "coverage_pct": rewarded_coverage_pct(matched, requests),
        }

    return {
        "filter": "rewarded",
        "currency": "USD",
        "operation_group": REWARDED_OPERATION_GROUP,
        "page_type": "rec",
        "slot_base": REWARDED_SLOT_BASE,
        "slot_ids": ordered_slots,
        "slot_count": len(ordered_slots),
        "configured_reference_slot_count": configured_slot_count,
        "topology_changed": len(ordered_slots) != configured_slot_count,
        "topology_policy": "accept live terminal shrink/expansion; reject missing base, interior gaps or duplicates",
        "formula": "sum(gamMatchedRequests across live contiguous rewarded waterfall) / gamRequests rewarded base * 100",
        "current": snapshot("metricsToday"),
        "previous_gray": snapshot("metricsYesterday"),
        "metrics_date": payload.get("metricsDate"),
    }


def fetch_rewarded_pricing() -> dict:
    sb = load_module(SB_COMMON, "ares_sb_common_rewarded_pricing")
    status, payload, token_report = sb.api_request(
        "GET", PRICING_ENDPOINT, item_name=SB_ITEM
    )
    if status != 200:
        raise RuntimeError(f"Smart Bidding Pricing rewarded report failed HTTP {status}")
    result = parse_rewarded_pricing(payload)
    result["endpoint"] = PRICING_ENDPOINT
    result["token_report"] = token_report
    return result


def fetch_sms_vendor_totals(target_date: str) -> dict:
    """Read SMS Funnel campaign sequences explicitly mapped to manager G006."""
    vault = os.environ.get("OP_DEFAULT_VAULT", "MGS Conteúdo")
    command = [
        "op", "item", "get", "SMS Funnel Dashboard", "--vault", vault,
        "--format", "json", "--reveal",
    ]
    proc = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60, check=False)
    if proc.returncode != 0:
        return {"status": "unavailable", "reason": "credential_unavailable"}
    fields = {
        str(item.get("label") or item.get("id") or "").lower(): str(item.get("value") or "")
        for item in json.loads(proc.stdout).get("fields", [])
    }
    email = fields.get("username") or fields.get("email") or ""
    password = fields.get("password") or ""
    if not email or not password:
        return {"status": "unavailable", "reason": "credential_incomplete"}
    import requests
    session = requests.Session()
    session.headers.update({"User-Agent": "MGS-Ares-SMSFunnel-ReadOnly/1.0"})
    login = session.post(
        "https://web2.smsfunnel.com.br/api/login",
        json={"email": email, "password": password, "utm": ""},
        timeout=30,
    )
    if login.status_code != 200:
        return {"status": "unavailable", "reason": f"login_http_{login.status_code}"}
    token = str((login.json() or {}).get("access_token") or "")
    if not token:
        return {"status": "unavailable", "reason": "login_token_missing"}
    headers = {"Authorization": f"Bearer {token}"}
    common_params = {"global": "false", "t": str(int(time.time() * 1000))}
    campaign_filter = json.dumps(
        {"name": "g006", "active": None, "integration": None, "list": None},
        separators=(",", ":"),
    )
    campaigns_response = session.get(
        "https://web2.smsfunnel.com.br/api/campaigns",
        params={"page": 1, "per_page": 100, "filter": campaign_filter, **common_params},
        headers=headers,
        timeout=60,
    )
    if campaigns_response.status_code != 200:
        return {"status": "unavailable", "reason": f"campaigns_http_{campaigns_response.status_code}"}
    campaign_payload = campaigns_response.json() or {}
    campaigns = campaign_payload.get("data") if isinstance(campaign_payload, dict) else campaign_payload
    campaigns = campaigns if isinstance(campaigns, list) else []
    campaigns = [
        row for row in campaigns
        if re.search(r"\bG006\b", str(row.get("name") or ""), re.IGNORECASE)
        and "CREDITOPARAVEICULO" in str(row.get("name") or "").upper()
        and any(kind in str(row.get("name") or "").upper() for kind in ("QUIZ", "CHAT"))
    ]
    if not campaigns:
        return {"status": "unavailable", "reason": "g006_campaigns_not_found"}
    breakdown = []
    for campaign in campaigns:
        campaign_id = str(campaign.get("id") or "")
        if not campaign_id:
            continue
        sequences_response = session.get(
            f"https://web2.smsfunnel.com.br/api/analytics/funnel-performance/{campaign_id}/sequences",
            params={"start_date": target_date, "end_date": target_date, **common_params},
            headers=headers,
            timeout=60,
        )
        if sequences_response.status_code != 200:
            return {
                "status": "unavailable",
                "reason": f"sequences_http_{sequences_response.status_code}",
                "campaign_id": campaign_id,
            }
        sequence_payload = sequences_response.json() or {}
        sequences = sequence_payload.get("data") if isinstance(sequence_payload, dict) else sequence_payload
        sequences = sequences if isinstance(sequences, list) else []
        sent = sum(int(as_float(row.get("sms_sent"))) for row in sequences)
        api_cost = sum(as_float(row.get("cost")) for row in sequences)
        name = str(campaign.get("name") or "")
        breakdown.append(
            {
                "campaign_id": campaign_id,
                "campaign_name": name,
                "experience": "quiz" if "QUIZ" in name.upper() else "chat",
                "sms_sent": sent,
                "api_cost_brl": round(api_cost, 2),
            }
        )

    # The consolidated endpoint treats end_date as an exclusive upper bound,
    # while the sequence drill-down is inclusive and uses the same civil date.
    next_date = (date.fromisoformat(target_date) + timedelta(days=1)).isoformat()
    report = session.get(
        "https://web2.smsfunnel.com.br/api/analytics/funnel-performance",
        params={"start_date": target_date, "end_date": next_date, **common_params},
        headers=headers,
        timeout=60,
    )
    if report.status_code != 200:
        return {"status": "unavailable", "reason": f"report_http_{report.status_code}"}
    totals = ((report.json() or {}).get("data") or {}).get("totals") or {}
    global_sent = int(as_float(totals.get("total_sms_sent")))
    global_cost = as_float(totals.get("total_cost"))
    unit_cost = as_float(totals.get("sms_unit_cost")) or 0.08
    sent = sum(int(row["sms_sent"]) for row in breakdown)
    api_cost = sum(as_float(row["api_cost_brl"]) for row in breakdown)
    total_cost = round(sent * unit_cost, 2)
    arithmetic_ok = abs(api_cost - total_cost) <= 0.02
    if not arithmetic_ok:
        return {
            "status": "unavailable",
            "reason": "g006_cost_arithmetic_mismatch",
            "total_sms_sent": sent,
            "sms_unit_cost_brl": unit_cost,
            "api_cost_brl": round(api_cost, 2),
            "formula_cost_brl": total_cost,
        }
    return {
        "status": "ok",
        "scope": "g006_campaign_sequence_readback",
        "period": target_date,
        "timezone": "America/Sao_Paulo",
        "total_sms_sent": sent,
        "sms_unit_cost_brl": unit_cost,
        "total_cost_brl": total_cost,
        "arithmetic_ok": arithmetic_ok,
        "campaigns": breakdown,
        "global_not_attributed_to_g006": {
            "total_sms_sent": global_sent,
            "total_cost_brl": global_cost,
            "other_or_unattributed_sms": max(0, global_sent - sent),
        },
        "credential": {"item": "SMS Funnel Dashboard", "status": "login_ok_read_only"},
    }


def fetch_bcb_usd_brl_ptax(target_date: str) -> dict:
    """Return the official BCB PTAX sell rate on or before the target date."""
    endpoint = "https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata/CotacaoDolarDia(dataCotacao=@dataCotacao)"
    target = date.fromisoformat(target_date)
    errors = []
    for fallback_days in range(0, 8):
        rate_date = target - timedelta(days=fallback_days)
        params = urllib.parse.urlencode(
            {
                "@dataCotacao": f"'{rate_date.strftime('%m-%d-%Y')}'",
                "$format": "json",
            }
        )
        url = f"{endpoint}?{params}"
        request = urllib.request.Request(
            url,
            headers={"User-Agent": "MGS-Ares-BCB-PTAX-ReadOnly/1.0"},
        )
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                status = response.status
                body = json.load(response)
        except Exception as exc:
            errors.append(f"{rate_date.isoformat()}:{type(exc).__name__}")
            continue
        if status != 200:
            errors.append(f"{rate_date.isoformat()}:http_{status}")
            continue
        rows = body.get("value") if isinstance(body, dict) else None
        rows = rows if isinstance(rows, list) else []
        if not rows:
            continue
        latest = max(rows, key=lambda row: str(row.get("dataHoraCotacao") or ""))
        sell = as_float(latest.get("cotacaoVenda"))
        buy = as_float(latest.get("cotacaoCompra"))
        if sell <= 0:
            errors.append(f"{rate_date.isoformat()}:invalid_sell_rate")
            continue
        return {
            "status": "ok",
            "source": "Banco Central do Brasil PTAX",
            "series": "CotacaoDolarDia",
            "rate_type": "cotacaoVenda",
            "rate_brl_per_usd": sell,
            "buy_rate_brl_per_usd": buy,
            "target_date": target_date,
            "rate_date": rate_date.isoformat(),
            "rate_timestamp": latest.get("dataHoraCotacao"),
            "fallback_days": fallback_days,
            "endpoint": endpoint,
        }
    return {
        "status": "unavailable",
        "reason": "bcb_ptax_not_found_on_or_before_target",
        "target_date": target_date,
        "attempts": errors,
    }


def current_campaign_index(campaigns: list[dict]) -> tuple[dict[str, dict], dict[str, dict]]:
    by_id = {str(row.get("id")): row for row in campaigns}
    by_num = {}
    for row in campaigns:
        number = campaign_number(row.get("name"))
        if number != "??":
            by_num[number] = row
    return by_id, by_num


def historical_adsets_from_snapshots(campaign_ids: list[str]) -> dict[str, list[dict]]:
    """Recover immutable bid details that Meta hides after campaign deletion."""
    wanted = {str(item) for item in campaign_ids if item}
    recovered: dict[str, list[dict]] = defaultdict(list)
    if not wanted or not SNAPSHOT_ROOT.exists():
        return {}
    snapshots = sorted(SNAPSHOT_ROOT.glob("snapshot-*.json"), reverse=True)[:HISTORICAL_SNAPSHOT_SCAN_LIMIT]
    seen_adsets: set[str] = set()
    for snapshot_path in snapshots:
        try:
            payload = json.loads(snapshot_path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        for adset in payload.get("meta_adsets") or []:
            campaign_id = str(adset.get("campaign_id") or "")
            adset_id = str(adset.get("id") or "")
            if campaign_id not in wanted or not adset_id or adset_id in seen_adsets:
                continue
            recovered[campaign_id].append(dict(adset))
            seen_adsets.add(adset_id)
        if wanted.issubset(recovered):
            break
    return dict(recovered)


def hydrate_missing_report_campaigns(
    campaigns: list[dict],
    adsets: list[dict],
    campaign_ids: list[str],
) -> tuple[list[dict], list[dict], list[dict]]:
    """Hydrate metric-bearing campaigns omitted by Meta's account collection.

    Insights can keep returning spend for deleted campaigns after the account
    campaigns/adsets edges stop listing them. Direct campaign GET supplies the
    live DELETED status and last budget/bid strategy. The latest continuity
    snapshot supplies adset-only bid details such as ``bid_amount`` and
    ``roas_average_floor``. If direct status readback fails, block the report
    instead of publishing UNKNOWN/n/d/$0.00.
    """
    current_ids = {str(row.get("id") or "") for row in campaigns}
    missing_ids = [str(cid) for cid in campaign_ids if str(cid) not in current_ids]
    if not missing_ids:
        return list(campaigns), list(adsets), []

    meta = load_module(META_COMMON, "ares_meta_common_historical_reports")
    token, field = meta.get_token_from_1password(META_ITEM, force_refresh=False)
    snapshot_adsets = historical_adsets_from_snapshots(missing_ids)
    hydrated_campaigns = [dict(row) for row in campaigns]
    hydrated_adsets = [dict(row) for row in adsets]
    audit = []
    campaign_fields = (
        "id,name,status,effective_status,configured_status,daily_budget,"
        "lifetime_budget,bid_strategy,created_time,start_time,stop_time,updated_time"
    )
    adset_fields = (
        "id,name,campaign_id,status,effective_status,configured_status,"
        "bid_amount,bid_constraints,optimization_goal"
    )
    for campaign_id in missing_ids:
        status, campaign, _ = meta.graph_get(campaign_id, token, {"fields": campaign_fields})
        if status != 200 or not isinstance(campaign, dict) or campaign.get("error") or not campaign.get("id"):
            raise RuntimeError(
                f"historical campaign readback failed for metric-bearing campaign {campaign_id}; report blocked"
            )
        if operation_campaign_number(campaign.get("name")) is None:
            raise RuntimeError(f"historical campaign {campaign_id} is outside the CPV lineage; report blocked")
        hydrated_campaigns.append(dict(campaign))

        live_adsets = graph_pages(
            meta,
            f"{campaign_id}/adsets",
            token,
            {"fields": adset_fields, "limit": 50},
        )
        recovered_adsets = live_adsets or snapshot_adsets.get(campaign_id) or []
        hydrated_adsets.extend(dict(row) for row in recovered_adsets)
        audit.append(
            {
                "campaign_id": campaign_id,
                "status": campaign.get("configured_status") or campaign.get("status"),
                "daily_budget_usd": as_float(campaign.get("daily_budget")) / 100.0,
                "bid_strategy": campaign.get("bid_strategy"),
                "adset_source": "live" if live_adsets else ("continuity_snapshot" if recovered_adsets else "unavailable"),
                "adset_count": len(recovered_adsets),
                "credential": {"item": META_ITEM, "field": field, "token_len": len(token)},
            }
        )
    return hydrated_campaigns, hydrated_adsets, audit


def sb_health_pct(cdp_impressions, gam_code_served_count) -> float | None:
    """Mirror the live Adgroup ESTIMATED_HEALTH calc, not CDP coverage."""
    try:
        matched, gam_matched = float(cdp_impressions), float(gam_code_served_count)
    except (TypeError, ValueError):
        return None
    if not all(math.isfinite(value) and value >= 0 for value in (matched, gam_matched)):
        return None
    if gam_matched == 0:
        return 0.0  # Explicit zero counters mirror the dashboard; absent rows remain n/d.
    ratio = matched * 100.0 / gam_matched
    return max(0.0, 200.0 - ratio if ratio > 100.0 else ratio)


def health_label(value: float | None) -> str:
    return "n/d" if value is None else f"{value:.2f}%".replace(".", ",")


def sb_health_contract() -> dict:
    return {
        "source": "Smart Bidding Adgroup ESTIMATED_HEALTH",
        "provider_frontend": "https://app.smartbiddingdigital.com/assets/fields-BYmzEr04.js",
        "source_fields": ["CDP_IMPRESSIONS", "GAM_CODE_SERVED_COUNT"],
        "aggregation": "sum source counters per campaign, then provider formula; never average percentages",
        "formula": "x=CDP_IMPRESSIONS*100/GAM_CODE_SERVED_COUNT; max(0, x>100 ? 200-x : x); denominator=0 => 0",
        "missing_data": "n/d when no SB row or any source counter is absent/invalid",
        "decision_use": "diagnostic only; no change to campaign actions",
    }


def aggregate_sb(rows: list[dict]) -> dict[str, dict]:
    out: dict[str, dict] = {}
    for row in rows:
        cid = str(row.get("CAMPAIGN_ID") or "")
        if not cid:
            continue
        item = out.setdefault(
            cid,
            {
                "campaign_id": cid,
                "name": str(row.get("CAMPAIGN_NAME") or ""),
                "utm_adgroups": set(),
                "investment": 0.0,
                "net_revenue": 0.0,
                "gross_revenue": 0.0,
                "sessions": 0.0,
                "pageviews": 0.0,
                "gam_impressions": 0.0,
                "cdp_impressions": 0.0,
                "gam_code_served_count": 0.0,
                "health_source_complete": True,
                "avg_price_weighted": 0.0,
                "avg_price_weight": 0.0,
            },
        )
        item["investment"] += as_float(row.get("INVESTIMENT"))
        item["net_revenue"] += as_float(row.get("NET_REVENUE"))
        item["gross_revenue"] += as_float(row.get("REVENUE"))
        item["sessions"] += as_float(row.get("SESSIONS"))
        item["pageviews"] += as_float(row.get("PAGEVIEWS"))
        item["gam_impressions"] += as_float(row.get("GAM_IMPRESSIONS"))
        if sb_health_pct(row.get("CDP_IMPRESSIONS"), row.get("GAM_CODE_SERVED_COUNT")) is None:
            item["health_source_complete"] = False
        else:
            item["cdp_impressions"] += float(row["CDP_IMPRESSIONS"])
            item["gam_code_served_count"] += float(row["GAM_CODE_SERVED_COUNT"])
        weight = max(as_float(row.get("GAM_IMPRESSIONS")), 1.0)
        item["avg_price_weighted"] += as_float(row.get("AVG_PRICE")) * weight
        item["avg_price_weight"] += weight
        utm = str(row.get("UTM_ADGROUP") or "").strip().lower()
        if utm:
            item["utm_adgroups"].add(utm)
    for item in out.values():
        item["utm_adgroups"] = sorted(item["utm_adgroups"])
        item["roi"] = roi(item["net_revenue"], item["investment"])
        item["health_pct"] = (
            sb_health_pct(item["cdp_impressions"], item["gam_code_served_count"])
            if item["health_source_complete"] else None
        )
        item["rps"] = (
            item["net_revenue"] * 1000.0 / item["sessions"]
            if item["sessions"] > 0 else None
        )
        item["cpm"] = (
            item["net_revenue"] * 1000.0 / item["gam_impressions"]
            if item["gam_impressions"] > 0 else None
        )
        item["avg_price"] = (
            item["avg_price_weighted"] / item["avg_price_weight"]
            if item["avg_price_weight"] else None
        )
    return out


def aggregate_sb_daily_roi(rows: list[dict]) -> dict[str, dict[str, float | None]]:
    """Aggregate Smart Bidding NET_REVENUE ROI by campaign and calendar date."""
    totals: dict[str, dict[str, dict[str, float]]] = defaultdict(
        lambda: defaultdict(lambda: {"investment": 0.0, "net_revenue": 0.0})
    )
    for row in rows:
        campaign_id = str(row.get("CAMPAIGN_ID") or "")
        row_date = str(row.get("DATE") or "")[:10]
        if not campaign_id or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", row_date):
            continue
        totals[campaign_id][row_date]["investment"] += as_float(row.get("INVESTIMENT"))
        totals[campaign_id][row_date]["net_revenue"] += as_float(row.get("NET_REVENUE"))
    return {
        campaign_id: {
            row_date: roi(values["net_revenue"], values["investment"])
            for row_date, values in by_date.items()
        }
        for campaign_id, by_date in totals.items()
    }


def campaign_roi_history(
    campaign_id: str,
    target_date: str,
    current_roi: float | None,
    prior_daily_roi: dict[str, dict[str, float | None]],
    *,
    current_is_partial: bool,
    days: int = INTRADAY_ROI_HISTORY_DAYS,
) -> list[dict]:
    """Return the current date plus prior dates, oldest first, with explicit labels."""
    if days < 1:
        raise ValueError("ROI history days must be positive")
    target = date.fromisoformat(target_date)
    history = []
    for offset in range(days - 1, -1, -1):
        item_date = target - timedelta(days=offset)
        iso_date = item_date.isoformat()
        history.append(
            {
                "date": iso_date,
                "date_label": item_date.strftime("%d/%m"),
                "roi": current_roi if offset == 0 else (prior_daily_roi.get(str(campaign_id)) or {}).get(iso_date),
                "partial": bool(offset == 0 and current_is_partial),
            }
        )
    return history


def aggregate_meta(insights: list[dict]) -> dict[str, dict]:
    out = {}
    for row in insights:
        cid = str(row.get("campaign_id") or "")
        if not cid:
            continue
        item = out.setdefault(
            cid,
            {
                "campaign_id": cid,
                "name": str(row.get("campaign_name") or ""),
                "spend": 0.0,
                "impressions": 0,
                "clicks": 0,
                "omni_purchases": 0.0,
                "roas_num": 0.0,
                "roas_weight": 0.0,
            },
        )
        spend = as_float(row.get("spend"))
        item["spend"] += spend
        item["impressions"] += int(as_float(row.get("impressions")))
        item["clicks"] += int(as_float(row.get("clicks")))
        item["omni_purchases"] += parse_action_value(row, "omni_purchase")
        value = parse_purchase_roas(row)
        if value is not None:
            item["roas_num"] += value * max(spend, 0.01)
            item["roas_weight"] += max(spend, 0.01)
    for item in out.values():
        item["purchase_roas"] = item["roas_num"] / item["roas_weight"] if item["roas_weight"] else None
        item["cost_per_purchase"] = (
            item["spend"] / item["omni_purchases"] if item["omni_purchases"] > 0 else None
        )
    return out


def estimated_by_utm(payload: dict) -> dict[str, dict]:
    grouped = payload.get("grouped") or []
    return {str(row.get("utm_adgroup") or "").lower(): row for row in grouped if row.get("utm_adgroup")}


def estimate_campaign(item: dict, estimates: dict[str, dict]) -> dict:
    matched = [estimates[utm] for utm in item.get("utm_adgroups") or [] if utm in estimates]
    revenue = sum(as_float(row.get("estimatedRevenue")) for row in matched)
    confidence_values = [as_float(row.get("confidence")) for row in matched if row.get("confidence") is not None]
    confidence = min(confidence_values) if confidence_values else None
    return {
        "estimated_revenue": revenue if matched else None,
        "estimated_roi": roi(revenue, item.get("investment") or 0) if matched else None,
        "confidence": confidence,
        "matched_adgroups": len(matched),
    }


def cycle_day_from_operational_start(start_date: str, today: date) -> int | None:
    try:
        started = date.fromisoformat(str(start_date))
    except (TypeError, ValueError):
        return None
    delta = (today - started).days
    return delta + 1


def _load_provenance_audit(reference: str) -> dict | None:
    """Load a local audit reference without treating an unreadable file as proof."""
    audit_ref = str(reference or "").strip()
    if not audit_ref:
        return None
    audit_path = Path(audit_ref) if audit_ref.startswith("/") else BASE / audit_ref
    try:
        payload = json.loads(audit_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return payload if isinstance(payload, dict) else None


def _engine_v3_live_audit_proves_campaign(config: dict) -> bool:
    """Require a terminal Engine v3 audit matching request and campaign IDs."""
    request_id = str(config.get("request_id") or "").strip()
    campaign_id = str(config.get("campaign_id") or "").strip()
    if not request_id or not campaign_id:
        return False
    default_ref = f"data/ares/meta-ads/engine-v3/audit/{request_id}.json"
    audit = _load_provenance_audit(str(config.get("readback_audit") or default_ref))
    if not audit:
        return False
    result = audit.get("result") if isinstance(audit.get("result"), dict) else {}
    audit_status = str(audit.get("status") or "").upper()
    result_status = str(result.get("status") or "").upper()
    campaign_ids = {str(value) for value in (result.get("campaign_ids") or []) if str(value)}
    return (
        int(audit.get("engine_version") or 0) == 3
        and str(audit.get("request_id") or "") == request_id
        and audit_status in {"COMPLETE", "COMPLETE_FUTURE_ACTIVE", "COMPLETED"}
        and result_status in {"COMPLETE", "COMPLETE_FUTURE_ACTIVE", "COMPLETED"}
        and campaign_id in campaign_ids
        and str(config.get("authorized_by") or "") == "Rodolfo Mattei"
        and bool(str(config.get("authorization_source") or ""))
    )


def _manual_copy_terminal_audit_proves_campaign(number: str, config: dict) -> bool:
    """Validate the terminal readback for a Rodolfo-created manual copy."""
    request_id = str(config.get("request_id") or "").strip()
    campaign_id = str(config.get("campaign_id") or "").strip()
    audit = _load_provenance_audit(str(config.get("cleanup_audit") or ""))
    if not request_id or not campaign_id or not audit:
        return False
    authorization = audit.get("authorization") if isinstance(audit.get("authorization"), dict) else {}
    campaign_results = audit.get("campaign_results") if isinstance(audit.get("campaign_results"), dict) else {}
    result = campaign_results.get(str(number)) if isinstance(campaign_results.get(str(number)), dict) else {}
    after = result.get("after") if isinstance(result.get("after"), dict) else {}
    terminal_status = str(
        after.get("configured_status") or after.get("status") or result.get("api_raw_status") or ""
    ).upper()
    return (
        str(audit.get("request_id") or "") == request_id
        and bool(audit.get("complete"))
        and str(audit.get("stage") or "").upper() in {"COMPLETE", "COMPLETED"}
        and str(authorization.get("authorized_by") or "") == "Rodolfo Mattei"
        and bool(str(authorization.get("source") or ""))
        and str(config.get("cleanup_authorization_source") or "") == str(authorization.get("source") or "")
        and bool(result.get("verified"))
        and str(after.get("id") or "") == campaign_id
        and terminal_status in {"DELETED", "ARCHIVED"}
    )


def validated_allowed_campaigns(operation: dict) -> dict[str, dict]:
    scope = ((operation.get("management_scope") or {}).get("autonomous_action_scope") or {})
    allowed = scope.get("allowed_campaigns") or {}
    configured_numbers = set(allowed)
    if not set(AUTONOMOUS_WRITE_NUMBERS).issubset(configured_numbers):
        raise RuntimeError("autonomous campaign base allowlist drift")
    for number, config in allowed.items():
        if not re.fullmatch(r"\d{2}", str(number)) or not 1 <= int(number) <= 59:
            raise RuntimeError("autonomous campaign allowlist number is invalid")
        if number not in AUTONOMOUS_WRITE_NUMBERS:
            config = config or {}
            source = str(config.get("source") or "")
            cycle_date_ok = bool(re.fullmatch(r"\d{4}-\d{2}-\d{2}", str(config.get("cycle_start_date") or "")))
            if source == "campaign_engine_v3_daily_readback":
                provenance_ok = bool(str(config.get("request_id") or ""))
            elif source == "campaign_engine_v3_live_readback":
                provenance_ok = _engine_v3_live_audit_proves_campaign(config)
            elif source in {"rodolfo_manual_ui_replacement_readback", "c20_advideo_canary_readback", "c20_lineage_rebuild_readback"}:
                audit_ref = str(config.get("readback_audit") or "")
                audit_path = Path(audit_ref) if audit_ref.startswith("/") else BASE / audit_ref
                provenance_ok = (
                    str(config.get("authorized_by") or "") == "Rodolfo Mattei"
                    and bool(str(config.get("authorization_source") or ""))
                    and audit_path.is_file()
                )
            elif source == "rodolfo_manual_copy_c07_readback":
                provenance_ok = _manual_copy_terminal_audit_proves_campaign(str(number), config)
            else:
                provenance_ok = False
            if not cycle_date_ok or not provenance_ok:
                raise RuntimeError("dynamic autonomous campaign lacks v3 readback provenance")
    ids = [str((allowed[number] or {}).get("campaign_id") or "") for number in sorted(allowed)]
    if any(not value for value in ids) or len(ids) != len(set(ids)):
        raise RuntimeError("autonomous campaign allowlist has missing or duplicate IDs")
    return {str(number): dict(config) for number, config in allowed.items()}


def recommendation(
    cycle: int | None,
    actual_roi: float | None,
    estimated_roi: float | None,
    hour: int,
    *,
    d3_negative_estimated_streak: bool = False,
    d3_reality_gate: bool = False,
    manual_d3_v2: bool = False,
    scaled_at_08: bool = False,
    prior_16h_failures: int = 0,
) -> str:
    if cycle is not None and cycle <= 0:
        return "PREPARAÇÃO"
    if hour == 8 and cycle == 3 and d3_negative_estimated_streak:
        return "PARAR D3 ESTIMADO"
    if cycle == 3 and d3_reality_gate and (hour in {8, 12} or manual_d3_v2):
        return "PARAR D3 REAL+ROAS"
    if hour == 16 and scaled_at_08 and actual_roi is not None and actual_roi < 0:
        if estimated_roi is None:
            return "GATE SEM ESTIMADO"
        if estimated_roi < 0:
            return "PARAR RECORRÊNCIA" if int(prior_16h_failures) >= 2 else "PAUSAR 16H TEMPORÁRIO"
        return "MANTER ESTIMADO POSITIVO"
    if actual_roi is None:
        return "OBSERVAR D1/D2" if cycle in {1, 2} else "OBSERVAR"
    if hour == 8:
        if actual_roi > 40:
            return "ESCALAR +30%"
        if actual_roi > 30:
            return "ESCALAR +20%"
        if actual_roi > 20:
            return "ESCALAR +10%"
    if 10 < actual_roi <= 20:
        return "MANTER SEM ESCALA"
    return "OBSERVAR D1/D2" if cycle in {1, 2} else "OBSERVAR"


def d3_reality_metrics(
    campaign_id: str,
    cycle_start_date: str,
    target_date: str,
    sb_rows: list[dict],
    meta_period_agg: dict[str, dict],
    *,
    current_meta_spend: float,
) -> dict:
    """Materialize the approved D3 real-ROI + Meta-ROAS terminal gate."""
    defaults = {
        "d3_daily_real_roi": [],
        "d3_negative_real_days": 0,
        "d3_cumulative_roi": None,
        "d3_meta_roas": None,
        "d3_meta_spend": 0.0,
        "d3_current_meta_spend": current_meta_spend,
        "d3_sb_investment": 0.0,
        "d3_sb_match_count": 0,
        "d3_reconciliation_available": False,
        "d3_reality_gate": False,
    }
    try:
        start = date.fromisoformat(cycle_start_date)
        target = date.fromisoformat(target_date)
    except ValueError:
        return defaults
    if (target - start).days != 2:
        return defaults
    dates = [(start + timedelta(days=offset)).isoformat() for offset in range(3)]
    selected = [
        item for item in sb_rows
        if str(item.get("CAMPAIGN_ID") or "") == campaign_id
        and str(item.get("DATE") or "")[:10] in dates
    ]
    daily = aggregate_sb_daily_roi(selected).get(campaign_id) or {}
    daily_rois = [daily.get(day) for day in dates]
    period_sb = aggregate_sb(selected).get(campaign_id) or {}
    period_meta = meta_period_agg.get(campaign_id) or {}
    cumulative_roi = period_sb.get("roi")
    meta_roas = period_meta.get("purchase_roas")
    sb_investment = as_float(period_sb.get("investment"))
    sb_match_count = len(period_sb.get("utm_adgroups") or [])
    negative_days = sum(value is not None and float(value) < 0 for value in daily_rois)
    current_roi = daily_rois[-1] if daily_rois else None
    reconciliation_available = (
        current_meta_spend >= 5.0
        and sb_investment > 0
        and sb_match_count == 1
        and all(value is not None for value in daily_rois)
    )
    gate = (
        reconciliation_available
        and negative_days >= 2
        and cumulative_roi is not None
        and float(cumulative_roi) <= -10.0
        and current_roi is not None
        and float(current_roi) < 0
        and meta_roas is not None
        and float(meta_roas) < 1.20
    )
    return {
        "d3_daily_real_roi": daily_rois,
        "d3_negative_real_days": negative_days,
        "d3_cumulative_roi": cumulative_roi,
        "d3_meta_roas": meta_roas,
        "d3_meta_spend": as_float(period_meta.get("spend")),
        "d3_current_meta_spend": current_meta_spend,
        "d3_sb_investment": sb_investment,
        "d3_sb_match_count": sb_match_count,
        "d3_reconciliation_available": reconciliation_available,
        "d3_reality_gate": gate,
    }


def _minor_units(value) -> int:
    try:
        return int(Decimal(str(value or 0)).quantize(Decimal("1"), rounding=ROUND_HALF_UP))
    except Exception:
        return 0


def _strict_minor_units(value, field: str) -> int:
    try:
        parsed = Decimal(str(value))
    except Exception as exc:
        raise RuntimeError(f"invalid {field}") from exc
    if not parsed.is_finite() or parsed != parsed.to_integral_value() or parsed <= 0:
        raise RuntimeError(f"invalid {field}")
    return int(parsed)


def _active_budget_minor(campaigns: list[dict]) -> int:
    total = 0
    for campaign in campaigns:
        configured = str(campaign.get("configured_status") or campaign.get("status") or "").upper()
        if configured == "ACTIVE":
            total += _strict_minor_units(campaign.get("daily_budget"), f"daily_budget:{campaign.get('id')}")
    return total


def _effective_account_cap_minor(policy: dict, required_minor: int, scope: str) -> dict:
    base_cap_minor = _strict_minor_units(
        Decimal(str(policy.get("operational_account_cap_usd", 0))) * 100,
        "account_budget_floor_minor",
    )
    dynamic = policy.get("dynamic_account_cap") or {}
    allowed_scopes = {str(item) for item in dynamic.get("allowed_scopes") or []}
    dynamic_enabled = dynamic.get("enabled") is True and scope in allowed_scopes
    cap_minor = max(base_cap_minor, required_minor) if dynamic_enabled else base_cap_minor
    return {
        "base_cap_minor": base_cap_minor,
        "account_cap_minor": cap_minor,
        "cap_adjusted_minor": max(0, cap_minor - base_cap_minor),
        "dynamic_enabled": dynamic_enabled,
    }


def _action_key(target_date: str, decision_hour: int, row: dict, action: str) -> str:
    if str(action).startswith("ESCALAR"):
        slot, action_class = f"{decision_hour:02d}", "scale_budget"
    else:
        slot, action_class = "day", "pause_campaign"
    return f"{target_date}:{slot}:{row.get('campaign_id')}:{action_class}"


def _safe_error(meta, payload) -> dict:
    if isinstance(payload, dict):
        return meta.safe_meta_error(payload)
    return {"raw": str(payload)[:700]}


def campaign_hierarchy_snapshot(meta, token: str, campaign_id: str) -> tuple[bool, dict]:
    adset_http, adset_payload, _ = meta.graph_get(
        f"{campaign_id}/adsets", token, {"fields": "id,status,effective_status", "limit": 20}
    )
    ads_http, ads_payload, _ = meta.graph_get(
        f"{campaign_id}/ads", token, {"fields": "id,status,effective_status", "limit": 50}
    )
    if adset_http != 200 or ads_http != 200 or not isinstance(adset_payload, dict) or not isinstance(ads_payload, dict):
        return False, {"adsets_http": adset_http, "ads_http": ads_http}
    adsets = list(adset_payload.get("data") or [])
    ads = list(ads_payload.get("data") or [])
    snapshot = {
        "adsets_http": adset_http,
        "ads_http": ads_http,
        "adset_statuses": {str(item.get("id") or ""): str(item.get("status") or "").upper() for item in adsets},
        "ad_statuses": {str(item.get("id") or ""): str(item.get("status") or "").upper() for item in ads},
    }
    active_adsets = sum(1 for value in snapshot["adset_statuses"].values() if value == "ACTIVE")
    active_ads = sum(1 for value in snapshot["ad_statuses"].values() if value == "ACTIVE")
    snapshot.update(active_adsets=active_adsets, active_ads=active_ads)
    return active_adsets == 1 and active_ads == 3, snapshot


def bounded_campaign_readback(
    meta,
    token: str,
    campaign_id: str,
    *,
    desired_budget_minor: int | None = None,
    desired_status: str | None = None,
    attempts: int = 4,
) -> tuple[bool, int, dict]:
    last_http, last_payload = 0, {}
    for attempt in range(attempts):
        last_http, last_payload, _ = meta.graph_get(
            campaign_id,
            token,
            {"fields": "id,name,status,effective_status,daily_budget,updated_time"},
        )
        if last_http == 200 and isinstance(last_payload, dict):
            configured = str(last_payload.get("status") or "").upper()
            effective = str(last_payload.get("effective_status") or "").upper()
            if desired_budget_minor is not None:
                ok = (
                    configured == "ACTIVE"
                    # Meta can transiently expose IN_PROCESS immediately after
                    # accepting an exact campaign budget update. The configured
                    # state and desired absolute budget are the write readback;
                    # hierarchy is verified independently immediately after.
                    and effective in {"ACTIVE", "IN_PROCESS"}
                    and _minor_units(last_payload.get("daily_budget")) == desired_budget_minor
                )
            else:
                target = str(desired_status or "").upper()
                ok = configured == target and effective in {target, f"CAMPAIGN_{target}"}
            if ok:
                return True, last_http, last_payload
        if attempt + 1 < attempts:
            time.sleep(2)
    return False, last_http, last_payload


def execute_intraday_actions(
    rows: list[dict],
    meta_account: dict,
    meta_campaigns: list[dict],
    source_context: dict,
    reconciliation: dict,
    target_date: str,
    decision_at_sp: datetime,
    *,
    manual_d3_v2: bool = False,
) -> tuple[list[dict], str | None]:
    """Execute only operation-approved campaign-level actions with idempotency and readback."""
    operation = json.loads(OP_PATH.read_text())
    management = operation.get("management_scope") or {}
    if not management.get("write_enabled") or management.get("reporting_mode") != "autonomous_guarded":
        return [], None

    record_guardrail_checkpoint(rows, target_date, decision_at_sp)
    candidates = []
    pause_actions = {
        "PARAR D3 ESTIMADO",
        "PARAR D3 REAL+ROAS",
        "PAUSAR 16H TEMPORÁRIO",
        "PARAR RECORRÊNCIA",
    }
    for row in rows:
        action = str(row.get("recommendation") or "")
        if re.fullmatch(r"ESCALAR \+(10|20|30)%", action) or action in pause_actions:
            candidates.append(row)
    if not candidates:
        return [], None

    ACTION_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with ACTION_LOCK.open("a+") as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        try:
            if ACTION_STATE.exists():
                try:
                    state = json.loads(ACTION_STATE.read_text())
                except Exception as exc:
                    raise RuntimeError("intraday action state is invalid; fail closed") from exc
            else:
                state = {"schema_version": "1.0", "applied": {}}
            applied = state.setdefault("applied", {})

            meta = load_module(META_COMMON, "ares_meta_common_intraday_actions")
            token, token_field = meta.get_token_from_1password(META_ITEM, force_refresh=False)
            allowed_campaigns = validated_allowed_campaigns(operation)
            account_id_live = str(meta_account.get("id") or "").replace("act_", "")
            if account_id_live != ACCOUNT_ID:
                raise RuntimeError("Meta account identity mismatch")
            if str(meta_account.get("currency") or "").upper() != "USD":
                raise RuntimeError("Meta account currency mismatch")
            if str(meta_account.get("timezone_name") or "") != "America/Sao_Paulo":
                raise RuntimeError("Meta account timezone mismatch")
            if int(as_float(meta_account.get("account_status"))) != 1 or int(as_float(meta_account.get("disable_reason"))) != 0:
                raise RuntimeError("Meta account is not healthy for autonomous writes")
            if target_date != str(source_context.get("current_date") or ""):
                raise RuntimeError("historical or mismatched date cannot write")

            budget_policy = operation.get("daily_budget_policy") or {}
            campaign_cap_minor = _strict_minor_units(
                Decimal(str(budget_policy.get("campaign_daily_ceiling_usd", 150))) * 100,
                "campaign_cap_minor",
            )
            active_total_minor = _active_budget_minor(meta_campaigns)
            active_total_initial_minor = active_total_minor
            account_envelope = _effective_account_cap_minor(
                budget_policy,
                active_total_minor,
                "roi_scale",
            )
            account_cap_minor = int(account_envelope["account_cap_minor"])
            holds = {str(item).strip().lower() for item in management.get("manual_holds") or []}

            scope = (management.get("autonomous_action_scope") or {})
            scale_gate = scope.get("scale_execution_gate") or {}
            scale_window_minutes = int(scale_gate.get("window_minutes") or 0)
            delay_value = ((source_context.get("delay") or {}).get("totalMinutes"))
            try:
                delay_minutes = Decimal(str(delay_value))
            except Exception:
                delay_minutes = Decimal("NaN")
            max_delay = Decimal(str(scale_gate.get("max_smart_bidding_delay_minutes") or 0))
            source_fresh = delay_minutes.is_finite() and delay_minutes >= 0 and max_delay > 0 and delay_minutes <= max_delay

            campaigns_by_id = {str(item.get("id") or ""): item for item in meta_campaigns}
            nonarchived_by_number: dict[str, list[str]] = defaultdict(list)
            for campaign in meta_campaigns:
                if str(campaign.get("status") or "").upper() == "ARCHIVED":
                    continue
                parsed_number = campaign_number(campaign.get("name"))
                if parsed_number != "??":
                    nonarchived_by_number[parsed_number].append(str(campaign.get("id") or ""))

            plan_blocks: dict[str, str] = {}
            planned_deltas: dict[str, int] = {}
            for row in candidates:
                action = str(row.get("recommendation") or "")
                scale_match = re.fullmatch(r"ESCALAR \+(10|20|30)%", action)
                if not scale_match:
                    continue
                cid = str(row.get("campaign_id") or "")
                number = str(row.get("number") or "")
                cfg = allowed_campaigns.get(number) or {}
                if str(cfg.get("campaign_id") or "") != cid:
                    plan_blocks[cid] = "campaign_not_allowlisted"
                    continue
                if nonarchived_by_number.get(number) != [cid]:
                    plan_blocks[cid] = "campaign_number_collision_or_drift"
                    continue
                if decision_at_sp.hour != 8 or decision_at_sp.minute > scale_window_minutes:
                    plan_blocks[cid] = "outside_scale_checkpoint_window"
                    continue
                if not source_fresh:
                    plan_blocks[cid] = "smart_bidding_source_stale_or_unknown"
                    continue
                if int(row.get("matched_adgroups") or 0) != int(scale_gate.get("required_matched_adgroups") or 1):
                    plan_blocks[cid] = "smart_bidding_join_incomplete"
                    continue
                try:
                    actual_roi = Decimal(str(row.get("sb_roi")))
                    if not actual_roi.is_finite():
                        raise ValueError
                except Exception:
                    plan_blocks[cid] = "actual_roi_missing_or_nonfinite"
                    continue
                snapshot = campaigns_by_id.get(cid) or {}
                try:
                    current_minor = _strict_minor_units(snapshot.get("daily_budget"), f"daily_budget:{cid}")
                except RuntimeError:
                    plan_blocks[cid] = "campaign_budget_missing_or_malformed"
                    continue
                percent = int(scale_match.group(1))
                target_minor = _minor_units(Decimal(current_minor) * (Decimal(100 + percent) / Decimal(100)))
                if target_minor > campaign_cap_minor:
                    plan_blocks[cid] = "campaign_cap_exceeded"
                    continue
                planned_deltas[cid] = target_minor - current_minor
            planned_required_minor = active_total_minor + sum(planned_deltas.values())
            account_envelope = _effective_account_cap_minor(
                budget_policy,
                planned_required_minor,
                "roi_scale",
            )
            account_cap_minor = int(account_envelope["account_cap_minor"])
            if planned_required_minor > account_cap_minor:
                for cid in planned_deltas:
                    plan_blocks[cid] = "batch_account_operational_cap_exceeded"

            results = []

            for row in candidates:
                action = str(row.get("recommendation") or "")
                campaign_id = str(row.get("campaign_id") or "")
                number = str(row.get("number") or "")
                key = _action_key(target_date, decision_at_sp.hour, row, action)
                decision_context = {
                    "target_date": target_date,
                    "decision_at_sp": decision_at_sp.isoformat(),
                    "campaign_id": campaign_id,
                    "recommendation": action,
                    "sb_roi": row.get("sb_roi"),
                    "estimated_roi": row.get("estimated_roi"),
                    "matched_adgroups": row.get("matched_adgroups"),
                    "d3_daily_real_roi": row.get("d3_daily_real_roi"),
                    "d3_negative_real_days": row.get("d3_negative_real_days"),
                    "d3_cumulative_roi": row.get("d3_cumulative_roi"),
                    "d3_meta_roas": row.get("d3_meta_roas"),
                    "d3_current_meta_spend": row.get("d3_current_meta_spend"),
                    "d3_reconciliation_available": row.get("d3_reconciliation_available"),
                    "manual_d3_v2": manual_d3_v2,
                    "currency": "USD",
                    "playbook_version": operation.get("playbook_version"),
                    "authorized_by": "Rodolfo Mattei",
                }
                decision_fingerprint = hashlib.sha256(
                    json.dumps(decision_context, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()
                ).hexdigest()
                record = {
                    "action_key": key,
                    "decision_fingerprint": decision_fingerprint,
                    "campaign_number": number,
                    "campaign_id": campaign_id,
                    "recommendation": action,
                    "decision_at_sp": decision_at_sp.isoformat(),
                    "status": "pending",
                }
                if not campaign_id:
                    record.update(status="blocked", reason="campaign_id_missing")
                    results.append(record)
                    continue
                prior = applied.get(key)
                if prior:
                    prior_status = str(prior.get("status") or "")
                    if prior_status in {"executed", "already_effective"}:
                        record.update(status="already_applied", prior=prior)
                        results.append(record)
                        continue
                    if prior_status in {"in_flight", "write_unconfirmed_hold"}:
                        recovery_http, recovery_live, _ = meta.graph_get(
                            campaign_id,
                            token,
                            {"fields": "id,name,status,effective_status,daily_budget,updated_time"},
                        )
                        record["recovery_http"] = recovery_http
                        if recovery_http != 200 or not isinstance(recovery_live, dict):
                            record.update(status="blocked", reason="pending_action_recovery_read_failed")
                            results.append(record)
                            continue
                        action_type = str(prior.get("action_type") or "")
                        if action_type == "scale_budget":
                            live_minor = _minor_units(recovery_live.get("daily_budget"))
                            desired_minor = _minor_units(prior.get("requested_minor"))
                            original_minor = _minor_units(prior.get("expected_minor"))
                            if live_minor == desired_minor:
                                applied[key] = {
                                    **prior,
                                    "status": "executed",
                                    "recovered_by_get": True,
                                    "verified_at_sp": datetime.now(SP).isoformat(),
                                }
                                atomic_write_json(ACTION_STATE, state)
                                record.update(status="recovered_verified", action_type=action_type, after=recovery_live)
                                results.append(record)
                                continue
                            if live_minor == original_minor:
                                applied.pop(key, None)
                                atomic_write_json(ACTION_STATE, state)
                            else:
                                record.update(status="blocked", reason="pending_action_third_budget_value", live=recovery_live)
                                results.append(record)
                                continue
                        elif action_type == "pause_campaign":
                            live_status = str(recovery_live.get("status") or "").upper()
                            desired_status = str(prior.get("requested_status") or "").upper()
                            original_status = str(prior.get("expected_status") or "").upper()
                            if live_status == desired_status:
                                applied[key] = {
                                    **prior,
                                    "status": "executed",
                                    "recovered_by_get": True,
                                    "verified_at_sp": datetime.now(SP).isoformat(),
                                }
                                atomic_write_json(ACTION_STATE, state)
                                record.update(status="recovered_verified", action_type=action_type, after=recovery_live)
                                record_confirmed_guardrail_pause(row, target_date, decision_at_sp, action)
                                results.append(record)
                                continue
                            if live_status == original_status:
                                applied.pop(key, None)
                                atomic_write_json(ACTION_STATE, state)
                            else:
                                record.update(status="blocked", reason="pending_action_third_status_value", live=recovery_live)
                                results.append(record)
                                continue
                        else:
                            record.update(status="blocked", reason="pending_action_type_unknown")
                            results.append(record)
                            continue
                    else:
                        record.update(status="blocked", reason=f"action_state_hold:{prior_status or 'unknown'}", prior=prior)
                        results.append(record)
                        continue
                cfg = allowed_campaigns.get(number) or {}
                if str(cfg.get("campaign_id") or "") != campaign_id:
                    record.update(status="blocked", reason="campaign_not_allowlisted")
                    results.append(record)
                    continue
                if nonarchived_by_number.get(number) != [campaign_id]:
                    record.update(status="blocked", reason="campaign_number_collision_or_drift")
                    results.append(record)
                    continue
                if campaign_id in plan_blocks:
                    record.update(status="blocked", reason=plan_blocks[campaign_id])
                    results.append(record)
                    continue
                if campaign_id.lower() in holds or number.lower() in holds or str(row.get("name") or "").lower() in holds:
                    record.update(status="blocked", reason="manual_hold")
                    results.append(record)
                    continue

                get_status, before, _ = meta.graph_get(
                    campaign_id,
                    token,
                    {"fields": "id,name,status,effective_status,daily_budget,updated_time"},
                )
                record["preflight_http"] = get_status
                if get_status != 200 or not isinstance(before, dict):
                    record.update(status="blocked", reason="preflight_failed", error=_safe_error(meta, before))
                    results.append(record)
                    continue
                record["before"] = before
                configured = str(before.get("status") or "").upper()
                effective = str(before.get("effective_status") or "").upper()
                try:
                    current_minor = _strict_minor_units(before.get("daily_budget"), f"preflight_daily_budget:{campaign_id}")
                except RuntimeError:
                    record.update(status="blocked", reason="preflight_budget_missing_or_malformed")
                    results.append(record)
                    continue

                scale_match = re.fullmatch(r"ESCALAR \+(10|20|30)%", action)
                if scale_match:
                    if configured != "ACTIVE" or effective != "ACTIVE":
                        record.update(status="blocked", reason="campaign_not_active")
                        results.append(record)
                        continue
                    hierarchy_ok, hierarchy_before = campaign_hierarchy_snapshot(meta, token, campaign_id)
                    record["hierarchy_before"] = hierarchy_before
                    if not hierarchy_ok:
                        record.update(status="blocked", reason="campaign_hierarchy_not_1x1x3_active")
                        results.append(record)
                        continue
                    percent = int(scale_match.group(1))
                    try:
                        expected_minor = _strict_minor_units(
                            Decimal(str(row.get("budget_usd"))) * 100,
                            f"decision_budget:{campaign_id}",
                        )
                    except RuntimeError:
                        record.update(status="blocked", reason="decision_budget_missing_or_malformed")
                        results.append(record)
                        continue
                    target_minor = _minor_units(
                        Decimal(current_minor) * (Decimal(100 + percent) / Decimal(100))
                    )
                    expected_target_minor = _minor_units(
                        Decimal(expected_minor) * (Decimal(100 + percent) / Decimal(100))
                    )
                    record.update(
                        action_type="scale_budget",
                        percent=percent,
                        expected_before_minor=expected_minor,
                        target_minor=target_minor,
                    )
                    if current_minor == expected_target_minor and current_minor != expected_minor:
                        record.update(status="already_effective", reason="live_budget_matches_expected_target")
                        applied[key] = {
                            "status": "already_effective",
                            "budget_minor": current_minor,
                            "verified_at_sp": datetime.now(SP).isoformat(),
                        }
                        results.append(record)
                        continue
                    if current_minor != expected_minor:
                        record.update(status="blocked", reason="budget_changed_since_decision")
                        results.append(record)
                        continue
                    if target_minor <= current_minor:
                        record.update(status="blocked", reason="invalid_scale_target")
                        results.append(record)
                        continue
                    if target_minor > campaign_cap_minor:
                        record.update(status="blocked", reason="campaign_cap_exceeded", cap_minor=campaign_cap_minor)
                        results.append(record)
                        continue
                    delta = target_minor - current_minor
                    if active_total_minor + delta > account_cap_minor:
                        record.update(
                            status="blocked",
                            reason="account_operational_cap_exceeded",
                            active_total_minor=active_total_minor,
                            cap_minor=account_cap_minor,
                        )
                        results.append(record)
                        continue
                    fresh_operation = json.loads(OP_PATH.read_text())
                    fresh_management = fresh_operation.get("management_scope") or {}
                    if not fresh_management.get("write_enabled") or fresh_management.get("reporting_mode") != "autonomous_guarded":
                        record.update(status="blocked", reason="authorization_changed_before_post")
                        results.append(record)
                        continue
                    fresh_envelope = _effective_account_cap_minor(
                        fresh_operation.get("daily_budget_policy") or {},
                        active_total_minor + delta,
                        "roi_scale",
                    )
                    if active_total_minor + delta > int(fresh_envelope["account_cap_minor"]):
                        record.update(status="blocked", reason="budget_policy_changed_before_post")
                        results.append(record)
                        continue
                    fresh_allowed = validated_allowed_campaigns(fresh_operation)
                    if str((fresh_allowed.get(number) or {}).get("campaign_id") or "") != campaign_id:
                        record.update(status="blocked", reason="allowlist_changed_before_post")
                        results.append(record)
                        continue
                    fresh_holds = {str(item).strip().lower() for item in fresh_management.get("manual_holds") or []}
                    if campaign_id.lower() in fresh_holds or number.lower() in fresh_holds or str(row.get("name") or "").lower() in fresh_holds:
                        record.update(status="blocked", reason="manual_hold_added_before_post")
                        results.append(record)
                        continue
                    final_preflight_http, final_preflight, _ = meta.graph_get(
                        campaign_id,
                        token,
                        {"fields": "id,name,status,effective_status,daily_budget,updated_time"},
                    )
                    record["final_preflight_http"] = final_preflight_http
                    record["final_preflight"] = final_preflight if final_preflight_http == 200 else _safe_error(meta, final_preflight)
                    protected_fields = ["id", "name", "status", "effective_status", "daily_budget", "updated_time"]
                    if (
                        final_preflight_http != 200
                        or not isinstance(final_preflight, dict)
                        or any(str(final_preflight.get(field)) != str(before.get(field)) for field in protected_fields)
                    ):
                        record.update(status="blocked", reason="campaign_changed_before_post")
                        results.append(record)
                        continue
                    applied[key] = {
                        "status": "in_flight",
                        "action_type": "scale_budget",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                        "expected_minor": current_minor,
                        "requested_minor": target_minor,
                        "recorded_at_sp": datetime.now(SP).isoformat(),
                    }
                    atomic_write_json(ACTION_STATE, state)
                    write_status, write_payload, _ = meta.graph_post_once(
                        campaign_id, token, {"daily_budget": str(target_minor)}
                    )
                    record["write_http"] = write_status
                    record["write_result"] = write_payload if write_status == 200 else _safe_error(meta, write_payload)
                    if write_status != 200:
                        postcheck_ok, postcheck_http, postcheck = bounded_campaign_readback(
                            meta, token, campaign_id, desired_budget_minor=target_minor
                        )
                        record["post_error_readback_http"] = postcheck_http
                        record["post_error_readback"] = postcheck if postcheck_http == 200 else _safe_error(meta, postcheck)
                        if postcheck_ok:
                            hierarchy_after_ok, hierarchy_after = campaign_hierarchy_snapshot(meta, token, campaign_id)
                            record["hierarchy_after"] = hierarchy_after
                            hierarchy_unchanged = (
                                hierarchy_after_ok
                                and hierarchy_after.get("adset_statuses") == hierarchy_before.get("adset_statuses")
                                and hierarchy_after.get("ad_statuses") == hierarchy_before.get("ad_statuses")
                            )
                            if not hierarchy_unchanged:
                                record.update(status="failed", reason="budget_verified_but_hierarchy_changed")
                                applied[key] = {
                                    "status": "executed_conflict_hold",
                                    "action_type": "scale_budget",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                                    "before_minor": current_minor,
                                    "after_minor": target_minor,
                                    "recorded_at_sp": datetime.now(SP).isoformat(),
                                }
                                results.append(record)
                                continue
                            active_total_minor += delta
                            record.update(status="executed", verified=True, recovered_after_post_error=True)
                            applied[key] = {
                                "status": "executed",
                                "action_type": "scale_budget",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                                "before_minor": current_minor,
                                "after_minor": target_minor,
                                "recovered_after_post_error": True,
                                "verified_at_sp": datetime.now(SP).isoformat(),
                            }
                            results.append(record)
                            continue
                        applied[key] = {
                            "status": "write_failed_hold",
                            "action_type": "scale_budget",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                            "expected_minor": current_minor,
                            "requested_minor": target_minor,
                            "recorded_at_sp": datetime.now(SP).isoformat(),
                        }
                        record.update(status="failed", reason="single_post_failed_or_unknown")
                        results.append(record)
                        continue
                    verified_readback, verify_status, after = bounded_campaign_readback(
                        meta, token, campaign_id, desired_budget_minor=target_minor
                    )
                    record["readback_http"] = verify_status
                    record["after"] = after if verify_status == 200 else _safe_error(meta, after)
                    if not verified_readback:
                        record.update(status="failed", reason="readback_mismatch_or_deferred")
                        applied[key] = {
                            "status": "write_unconfirmed_hold",
                            "action_type": "scale_budget",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                            "expected_minor": current_minor,
                            "requested_minor": target_minor,
                            "recorded_at_sp": datetime.now(SP).isoformat(),
                        }
                        results.append(record)
                        continue
                    hierarchy_after_ok, hierarchy_after = campaign_hierarchy_snapshot(meta, token, campaign_id)
                    record["hierarchy_after"] = hierarchy_after
                    hierarchy_unchanged = (
                        hierarchy_after_ok
                        and hierarchy_after.get("adset_statuses") == hierarchy_before.get("adset_statuses")
                        and hierarchy_after.get("ad_statuses") == hierarchy_before.get("ad_statuses")
                    )
                    if not hierarchy_unchanged:
                        record.update(status="failed", reason="budget_verified_but_hierarchy_changed")
                        applied[key] = {
                            "status": "executed_conflict_hold",
                            "action_type": "scale_budget",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                            "before_minor": current_minor,
                            "after_minor": target_minor,
                            "recorded_at_sp": datetime.now(SP).isoformat(),
                        }
                        results.append(record)
                        continue
                    active_total_minor += delta
                    record.update(status="executed", verified=True)
                    applied[key] = {
                        "status": "executed",
                        "action_type": "scale_budget",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                        "before_minor": current_minor,
                        "after_minor": target_minor,
                        "verified_at_sp": datetime.now(SP).isoformat(),
                    }
                    results.append(record)
                    continue

                if action in pause_actions:
                    record["action_type"] = "pause_campaign"
                    if not source_fresh:
                        record.update(status="blocked", reason="smart_bidding_source_stale_or_unknown")
                        results.append(record)
                        continue
                    if action != "PARAR D3 REAL+ROAS" and row.get("estimated_roi") is None:
                        record.update(status="blocked", reason="estimated_roi_missing")
                        results.append(record)
                        continue
                    if action == "PARAR D3 ESTIMADO":
                        live_guardrail = load_guardrail_state()
                        if decision_at_sp.hour != 8 or int(row.get("cycle_day") or 0) != 3:
                            record.update(status="blocked", reason="outside_d3_estimated_checkpoint")
                            results.append(record)
                            continue
                        if not d3_estimated_negative_streak(row, live_guardrail, target_date):
                            record.update(status="blocked", reason="d1_d2_d3_estimated_negative_streak_not_proven")
                            results.append(record)
                            continue
                    elif action == "PARAR D3 REAL+ROAS":
                        if int(row.get("cycle_day") or 0) != 3:
                            record.update(status="blocked", reason="outside_d3_reality_cycle")
                            results.append(record)
                            continue
                        if decision_at_sp.hour not in {8, 12} and not manual_d3_v2:
                            record.update(status="blocked", reason="outside_d3_reality_checkpoint")
                            results.append(record)
                            continue
                        if not bool(row.get("d3_reality_gate")):
                            record.update(status="blocked", reason="d3_reality_gate_not_proven")
                            results.append(record)
                            continue
                    else:
                        if decision_at_sp.hour != 16:
                            record.update(status="blocked", reason="outside_16h_guardrail_checkpoint")
                            results.append(record)
                            continue
                        if not scaled_today(target_date, campaign_id):
                            record.update(status="blocked", reason="campaign_not_scaled_at_08")
                            results.append(record)
                            continue
                        if row.get("sb_roi") is None or float(row["sb_roi"]) >= 0 or float(row["estimated_roi"]) >= 0:
                            record.update(status="blocked", reason="16h_negative_actual_and_estimated_gate_not_met")
                            results.append(record)
                            continue
                        guardrail_record = (load_guardrail_state().get("campaigns") or {}).get(campaign_id) or {}
                        prior_failures = int(guardrail_record.get("consecutive_16h_failures") or 0)
                        if action == "PAUSAR 16H TEMPORÁRIO" and prior_failures >= 2:
                            record.update(status="blocked", reason="third_recurrence_requires_terminal_action")
                            results.append(record)
                            continue
                        if action == "PARAR RECORRÊNCIA" and prior_failures < 2:
                            record.update(status="blocked", reason="third_recurrence_not_proven")
                            results.append(record)
                            continue
                    if configured == "PAUSED":
                        record.update(status="blocked", reason="campaign_already_paused_unknown_origin")
                        results.append(record)
                        continue
                    if configured != "ACTIVE":
                        record.update(status="blocked", reason="campaign_not_active")
                        results.append(record)
                        continue
                    fresh_operation = json.loads(OP_PATH.read_text())
                    fresh_management = fresh_operation.get("management_scope") or {}
                    if not fresh_management.get("write_enabled") or fresh_management.get("reporting_mode") != "autonomous_guarded":
                        record.update(status="blocked", reason="authorization_changed_before_post")
                        results.append(record)
                        continue
                    fresh_allowed = validated_allowed_campaigns(fresh_operation)
                    if str((fresh_allowed.get(number) or {}).get("campaign_id") or "") != campaign_id:
                        record.update(status="blocked", reason="allowlist_changed_before_post")
                        results.append(record)
                        continue
                    fresh_holds = {str(item).strip().lower() for item in fresh_management.get("manual_holds") or []}
                    if campaign_id.lower() in fresh_holds or number.lower() in fresh_holds or str(row.get("name") or "").lower() in fresh_holds:
                        record.update(status="blocked", reason="manual_hold_added_before_post")
                        results.append(record)
                        continue
                    final_preflight_http, final_preflight, _ = meta.graph_get(
                        campaign_id,
                        token,
                        {"fields": "id,name,status,effective_status,daily_budget,updated_time"},
                    )
                    record["final_preflight_http"] = final_preflight_http
                    record["final_preflight"] = final_preflight if final_preflight_http == 200 else _safe_error(meta, final_preflight)
                    protected_fields = ["id", "name", "status", "effective_status", "daily_budget", "updated_time"]
                    if (
                        final_preflight_http != 200
                        or not isinstance(final_preflight, dict)
                        or any(str(final_preflight.get(field)) != str(before.get(field)) for field in protected_fields)
                    ):
                        record.update(status="blocked", reason="campaign_changed_before_post")
                        results.append(record)
                        continue
                    applied[key] = {
                        "status": "in_flight",
                        "action_type": "pause_campaign",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                        "expected_status": configured,
                        "requested_status": "PAUSED",
                        "recorded_at_sp": datetime.now(SP).isoformat(),
                    }
                    atomic_write_json(ACTION_STATE, state)
                    write_status, write_payload, _ = meta.graph_post_once(campaign_id, token, {"status": "PAUSED"})
                    record["write_http"] = write_status
                    record["write_result"] = write_payload if write_status == 200 else _safe_error(meta, write_payload)
                    if write_status != 200:
                        postcheck_ok, postcheck_http, postcheck = bounded_campaign_readback(
                            meta, token, campaign_id, desired_status="PAUSED"
                        )
                        record["post_error_readback_http"] = postcheck_http
                        record["post_error_readback"] = postcheck if postcheck_http == 200 else _safe_error(meta, postcheck)
                        if postcheck_ok:
                            record.update(status="executed", verified=True, recovered_after_post_error=True)
                            applied[key] = {
                                "status": "executed",
                                "action_type": "pause_campaign",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                                "campaign_status": "PAUSED",
                                "recovered_after_post_error": True,
                                "verified_at_sp": datetime.now(SP).isoformat(),
                            }
                            record_confirmed_guardrail_pause(row, target_date, decision_at_sp, action)
                            results.append(record)
                            continue
                        applied[key] = {
                            "status": "write_failed_hold",
                            "action_type": "pause_campaign",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                            "expected_status": configured,
                            "requested_status": "PAUSED",
                            "recorded_at_sp": datetime.now(SP).isoformat(),
                        }
                        record.update(status="failed", reason="single_post_failed_or_unknown")
                        results.append(record)
                        continue
                    verified_readback, verify_status, after = bounded_campaign_readback(
                        meta, token, campaign_id, desired_status="PAUSED"
                    )
                    record["readback_http"] = verify_status
                    record["after"] = after if verify_status == 200 else _safe_error(meta, after)
                    if not verified_readback:
                        record.update(status="failed", reason="readback_mismatch_or_deferred")
                        applied[key] = {
                            "status": "write_unconfirmed_hold",
                            "action_type": "pause_campaign",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                            "expected_status": configured,
                            "requested_status": "PAUSED",
                            "recorded_at_sp": datetime.now(SP).isoformat(),
                        }
                        results.append(record)
                        continue
                    record.update(status="executed", verified=True)
                    applied[key] = {
                        "status": "executed",
                        "action_type": "pause_campaign",
                            "decision_fingerprint": decision_fingerprint,
                            "decision_context": decision_context,
                        "campaign_status": "PAUSED",
                        "verified_at_sp": datetime.now(SP).isoformat(),
                    }
                    record_confirmed_guardrail_pause(row, target_date, decision_at_sp, action)
                    results.append(record)

            try:
                final_campaigns = graph_pages(
                    meta,
                    f"{ACCOUNT_ACT}/campaigns",
                    token,
                    {"fields": "id,name,status,effective_status,daily_budget", "limit": 500},
                )
                final_active_total_minor = _active_budget_minor(final_campaigns)
                batch_verification = {
                    "ok": final_active_total_minor <= account_cap_minor,
                    "active_total_minor": final_active_total_minor,
                    "account_cap_minor": account_cap_minor,
                }
                if not batch_verification["ok"]:
                    for item in results:
                        if item.get("status") == "executed":
                            item.update(status="executed_conflict_hold", reason="final_account_cap_exceeded")
                            if item.get("action_key") in applied:
                                applied[item["action_key"]]["status"] = "executed_conflict_hold"
            except Exception as exc:
                batch_verification = {"ok": False, "deferred": True, "reason": type(exc).__name__}
                for item in results:
                    if item.get("status") == "executed":
                        item.update(status="readback_deferred", reason="final_batch_readback_deferred")
                        if item.get("action_key") in applied:
                            applied[item["action_key"]]["status"] = "readback_deferred"

            state["updated_at_sp"] = datetime.now(SP).isoformat()
            atomic_write_json(ACTION_STATE, state)
            audit = {
                "schema_version": "1.0",
                "kind": "intraday_automated_actions",
                "created_at_sp": datetime.now(SP).isoformat(),
                "authorized_by": "Rodolfo Mattei",
                "operation_id": operation.get("operation_id"),
                "account_id": ACCOUNT_ID,
                "target_date": target_date,
                "decision_at_sp": decision_at_sp.isoformat(),
                "mode": "autonomous_guarded",
                "manual_d3_v2": manual_d3_v2,
                "playbook_version": operation.get("playbook_version"),
                "authorization": management.get("autonomous_action_scope"),
                "account_preflight": meta_account,
                "source_context": source_context,
                "token_report": {"item": META_ITEM, "field": token_field, "len": len(token)},
                "limits": {
                    "campaign_cap_minor": campaign_cap_minor,
                    **account_envelope,
                    "active_total_before_minor": active_total_initial_minor,
                    "active_total_after_verified_minor": active_total_minor,
                },
                "plan": {"planned_deltas": planned_deltas, "blocks": plan_blocks},
                "batch_verification": batch_verification,
                "reconciliation": reconciliation,
                "results": results,
            }
            ACTION_AUDIT_ROOT.mkdir(parents=True, exist_ok=True)
            audit_path = ACTION_AUDIT_ROOT / f"actions-{datetime.now(UTC).strftime('%Y%m%dT%H%M%S%fZ')}.json"
            atomic_write_json(audit_path, audit)
            return results, str(audit_path)
        finally:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)


def execute_guardrail_reactivations(now_sp: datetime) -> tuple[list[dict], str | None]:
    """At 00:30, reactivate only verified temporary guardrail pauses."""
    operation = json.loads(OP_PATH.read_text())
    management = operation.get("management_scope") or {}
    if not management.get("write_enabled") or management.get("reporting_mode") != "autonomous_guarded":
        return [], None
    ACTION_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with ACTION_LOCK.open("a+") as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        try:
            state = load_guardrail_state()
            due = []
            for campaign_id, record in (state.get("campaigns") or {}).items():
                pending = record.get("pending_reactivation") or {}
                if (
                    not record.get("terminal")
                    and pending.get("provenance") in {"post_scale_16h", "first_delivery_guardrail"}
                    and pending.get("due_date") == now_sp.date().isoformat()
                    and pending.get("due_time") == "00:30"
                    and pending.get("status") in {"pending", "in_flight", "write_unconfirmed_hold"}
                ):
                    due.append((str(campaign_id), record))
            if not due:
                return [], None

            meta = load_module(META_COMMON, "ares_meta_common_guardrail_reactivation")
            token, token_field = meta.get_token_from_1password(META_ITEM, force_refresh=False)
            account_http, account, _ = meta.graph_get(
                ACCOUNT_ACT,
                token,
                {"fields": "id,currency,timezone_name,account_status,disable_reason"},
            )
            if account_http != 200 or not isinstance(account, dict):
                raise RuntimeError("Meta account preflight failed for guardrail reactivation")
            if (
                str(account.get("id") or "").replace("act_", "") != ACCOUNT_ID
                or str(account.get("currency") or "").upper() != "USD"
                or str(account.get("timezone_name") or "") != "America/Sao_Paulo"
                or int(as_float(account.get("account_status"))) != 1
                or int(as_float(account.get("disable_reason"))) != 0
            ):
                raise RuntimeError("Meta account is not healthy for guardrail reactivation")
            campaigns = graph_pages(
                meta,
                f"{ACCOUNT_ACT}/campaigns",
                token,
                {"fields": "id,name,status,effective_status,daily_budget,updated_time", "limit": 500},
            )
            campaigns_by_id = {str(item.get("id") or ""): item for item in campaigns}
            active_total_minor = _active_budget_minor(campaigns)
            budget_policy = operation.get("daily_budget_policy") or {}
            account_envelope = _effective_account_cap_minor(
                budget_policy,
                active_total_minor,
                "guardrail_reactivation",
            )
            account_cap_minor = int(account_envelope["account_cap_minor"])
            allowed = validated_allowed_campaigns(operation)
            holds = {str(item).strip().lower() for item in management.get("manual_holds") or []}
            results = []
            for campaign_id, record in due:
                number = str(record.get("campaign_number") or "")
                result = {"campaign_id": campaign_id, "campaign_number": number, "status": "pending"}
                if str((allowed.get(number) or {}).get("campaign_id") or "") != campaign_id:
                    result.update(status="blocked", reason="campaign_not_allowlisted")
                    results.append(result)
                    continue
                if campaign_id.lower() in holds or number.lower() in holds:
                    result.update(status="blocked", reason="manual_hold")
                    results.append(result)
                    continue
                live = campaigns_by_id.get(campaign_id) or {}
                configured = str(live.get("status") or "").upper()
                budget_minor = _strict_minor_units(live.get("daily_budget"), f"daily_budget:{campaign_id}")
                if configured == "ACTIVE":
                    record["pending_reactivation"]["status"] = "completed"
                    record["pending_reactivation"]["completed_at_sp"] = now_sp.isoformat()
                    record["last_reactivation"] = {"status": "already_active_no_post", "verified_at_sp": now_sp.isoformat()}
                    result.update(status="already_active_no_post", verified=True)
                    results.append(result)
                    continue
                if configured != "PAUSED":
                    result.update(status="blocked", reason="campaign_not_paused")
                    results.append(result)
                    continue
                account_envelope = _effective_account_cap_minor(
                    budget_policy,
                    active_total_minor + budget_minor,
                    "guardrail_reactivation",
                )
                account_cap_minor = int(account_envelope["account_cap_minor"])
                if active_total_minor + budget_minor > account_cap_minor:
                    result.update(status="blocked", reason="account_operational_cap_exceeded")
                    results.append(result)
                    continue
                hierarchy_ok, hierarchy = campaign_hierarchy_snapshot(meta, token, campaign_id)
                result["hierarchy_before"] = hierarchy
                if not hierarchy_ok:
                    result.update(status="blocked", reason="campaign_hierarchy_not_1x1x3_active")
                    results.append(result)
                    continue
                record["pending_reactivation"].update(status="in_flight", started_at_sp=now_sp.isoformat())
                atomic_write_json(GUARDRAIL_STATE, state)
                write_http, write_payload, _ = meta.graph_post_once(campaign_id, token, {"status": "ACTIVE"})
                result["write_http"] = write_http
                result["write_result"] = write_payload if write_http == 200 else _safe_error(meta, write_payload)
                verified, readback_http, after = bounded_campaign_readback(
                    meta, token, campaign_id, desired_status="ACTIVE"
                )
                result["readback_http"] = readback_http
                result["after"] = after if readback_http == 200 else _safe_error(meta, after)
                if not verified:
                    record["pending_reactivation"]["status"] = "write_unconfirmed_hold"
                    result.update(status="failed", reason="reactivation_readback_mismatch_or_deferred")
                    results.append(result)
                    continue
                active_total_minor += budget_minor
                record["pending_reactivation"].update(status="completed", completed_at_sp=now_sp.isoformat())
                record["last_reactivation"] = {
                    "status": "ACTIVE",
                    "verified_at_sp": now_sp.isoformat(),
                    "write_http": write_http,
                }
                result.update(status="executed", verified=True)
                results.append(result)
            state["updated_at_sp"] = now_sp.isoformat()
            atomic_write_json(GUARDRAIL_STATE, state)
            audit = {
                "schema_version": "1.0",
                "kind": "guardrail_00_30_reactivation",
                "created_at_sp": now_sp.isoformat(),
                "authorized_by": "Rodolfo Mattei",
                "operation_id": operation.get("operation_id"),
                "account_id": ACCOUNT_ID,
                "playbook_version": operation.get("playbook_version"),
                "token_report": {"item": META_ITEM, "field": token_field, "len": len(token)},
                "account_budget_envelope": account_envelope,
                "results": results,
            }
            ACTION_AUDIT_ROOT.mkdir(parents=True, exist_ok=True)
            audit_path = ACTION_AUDIT_ROOT / f"reactivate-{datetime.now(UTC).strftime('%Y%m%dT%H%M%S%fZ')}.json"
            atomic_write_json(audit_path, audit)
            return results, str(audit_path)
        finally:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)


def build_daily(target_date: str, now_sp: datetime) -> tuple[str, dict]:
    current_day = target_date == now_sp.date().isoformat()
    target_day = date.fromisoformat(target_date)
    operation = json.loads(OP_PATH.read_text())
    allowed_campaigns = (
        (((operation.get("management_scope") or {}).get("autonomous_action_scope") or {}).get("allowed_campaigns"))
        or {}
    )
    period_kind = "current_day" if current_day else "previous_closed_day"
    period_label = (
        f"Mesmo dia até {now_sp.strftime('%H:%M')} SP"
        if current_day
        else "Dia anterior fechado"
    )
    meta = fetch_meta(target_date)
    sb = fetch_sb(target_date, include_estimated=False, include_sms=False)
    meta_agg = aggregate_meta(meta["insights"])
    sb_agg = aggregate_sb(sb["rows"])
    campaign_ids = report_campaign_ids(meta["campaigns"], meta_agg, sb_agg)
    meta["campaigns"], meta["adsets"], historical_readback = hydrate_missing_report_campaigns(
        meta["campaigns"],
        meta["adsets"],
        campaign_ids,
    )
    current_by_id, _ = current_campaign_index(meta["campaigns"])
    adsets_by_campaign: dict[str, list[dict]] = defaultdict(list)
    for adset in meta["adsets"]:
        adsets_by_campaign[str(adset.get("campaign_id") or "")].append(adset)
    rows = []
    for cid in campaign_ids:
        current = current_by_id.get(cid) or {}
        m = meta_agg.get(cid) or {}
        s = sb_agg.get(cid) or {}
        name = current.get("name") or m.get("name") or s.get("name") or ""
        number = campaign_number(name, " ".join(s.get("utm_adgroups") or []))
        cycle_campaign = dict(current)
        cycle_campaign["name"] = name
        cycle_start_date = campaign_cycle_start_date(
            cycle_campaign,
            allowed_campaigns.get(number) or {},
            target_day,
        )
        cycle = cycle_day_from_operational_start(cycle_start_date, target_day)
        if cycle is None:
            raise RuntimeError(f"invalid daily operational cycle start: {number}")
        rows.append(
            {
                "number": number,
                "campaign_label": compact_campaign_label(
                    number,
                    name,
                    current.get("start_time"),
                    current.get("created_time"),
                ),
                "campaign_id": cid,
                "name": name,
                "status": current.get("configured_status") or current.get("status") or "UNKNOWN",
                "lance": bid_strategy_label(current, adsets_by_campaign.get(cid) or []),
                "cycle_day": cycle,
                "cycle_start_date": cycle_start_date,
                "budget_usd": as_float(current.get("daily_budget")) / 100.0,
                "meta_spend": as_float(m.get("spend")),
                "meta_roas": m.get("purchase_roas"),
                "meta_cost": m.get("cost_per_purchase"),
                "sb_investment": as_float(s.get("investment")),
                "sb_revenue": as_float(s.get("net_revenue")),
                "sb_roi": s.get("roi"),
                "health_pct": s.get("health_pct"),
                "health_source": {key: s.get(key) for key in ("cdp_impressions", "gam_code_served_count", "health_source_complete")},
            }
        )
    total_meta_spend = sum(row["meta_spend"] for row in rows)
    total_sb_investment = sum(row["sb_investment"] for row in rows)
    acquisition_revenue = sum(row["sb_revenue"] for row in rows)
    acquisition_roi = roi(acquisition_revenue, total_meta_spend)
    spend_diff = total_meta_spend - total_sb_investment
    anomaly = abs(spend_diff) > max(1.0, total_meta_spend * 0.02)
    campaign_table_rows = []
    for row in rows:
        roas_label = "n/d" if row["meta_roas"] is None else f"{row['meta_roas']:.2f}".replace(".", ",")
        cost_label = "n/d" if row["meta_cost"] is None else money(row["meta_cost"])
        campaign_table_rows.append(
            [
                daily_signal(row["sb_roi"]),
                row["campaign_label"],
                row["lance"],
                f"D{row['cycle_day']}" if row["cycle_day"] > 0 else "PREP",
                operator_status(row["status"]),
                money(row["budget_usd"]),
                money(row["meta_spend"]),
                cost_label,
                pct(row["sb_roi"]),
                roas_label,
                health_label(row.get("health_pct")),
            ]
        )
    lines = [
        f"📊 DIÁRIO — Creditoparaveiculo 13 G006 — {datetime.strptime(target_date, '%Y-%m-%d').strftime('%d/%m/%Y')}",
        f"{period_label} | USD | Smart Bidding NET_REVENUE com revenue share",
        "",
        "**Tabela consolidada — visão desktop**",
        "",
    ]
    if campaign_table_rows:
        lines.extend(
            table_pages(
                ["Sinal", "Camp", "Lance", "Dia", "Status", "Budget", "Spend", "Custo", "ROI SB", "ROAS", "Health"],
                campaign_table_rows,
            )
        )
    else:
        lines.append("⚪ Nenhuma campanha da conta teve spend no dia.")
    summary_rows = daily_acquisition_summary_rows(
        account_label="conta 13",
        meta_spend=total_meta_spend,
        acquisition_revenue=acquisition_revenue,
        acquisition_roi=acquisition_roi,
        spend_diff=spend_diff,
        anomaly=anomaly,
    )
    lines.extend(["", "**Resumo da conta**", aligned_table(["Sinal", "Indicador", "Resultado"], summary_rows)])
    lines.append("SMS não atribuído por conta — consultar CPV Diário Geral.")
    lines.append("Budget = valor atual na Meta; Custo = spend ÷ omni_purchase do dia.")
    lines.append("Health = indicador do Adgroup SB (ESTIMATED HEALTH), calculado pelos contadores CDP/GAM; não é cobertura rewarded.")
    lines.append("Legenda: 🟢 saudável | 🟡 atenção | 🔴 crítico | ⚪ sem leitura")
    report = {
        "kind": "daily",
        "health_contract": sb_health_contract(),
        "generated_at_sp": now_sp.isoformat(),
        "target_date": target_date,
        "period_kind": period_kind,
        "currency": "USD",
        "presentation": {"mobile_campaign_cards": False, "layout": "desktop_tables_only"},
        "campaigns": rows,
        "totals": {
            "meta_spend": total_meta_spend,
            "sb_investment": total_sb_investment,
            "acquisition_net_revenue": acquisition_revenue,
            "roi_acquisition_pct": acquisition_roi,
        },
        "sms_policy": {
            "status": "excluded_from_account_report",
            "reason": "SMS G006 is not attributable between account 13 and account 05",
            "destination_thread_id": "1543826231831560343",
            "destination": "CPV Diário Geral",
        },
        "reconciliation": {"spend_diff": spend_diff, "anomaly": anomaly},
        "source_status": {"meta": "ok", "smart_bidding": "ok"},
        "historical_campaign_readback": historical_readback,
    }
    return "\n".join(lines), report


def prior_scale_history(target_date: str, row: dict, *, compact: bool = False) -> str | None:
    if not ACTION_STATE.exists():
        return None
    try:
        state = json.loads(ACTION_STATE.read_text())
    except Exception:
        return None
    key = f"{target_date}:08:{row.get('campaign_id')}:scale_budget"
    prior = (state.get("applied") or {}).get(key) or {}
    if str(prior.get("status") or "") not in {"executed", "already_effective"}:
        return None
    before_minor = _minor_units(prior.get("before_minor") or prior.get("expected_minor"))
    after_minor = _minor_units(prior.get("after_minor") or prior.get("requested_minor") or prior.get("budget_minor"))
    if before_minor <= 0 or after_minor <= before_minor:
        return None
    verified = str(prior.get("verified_at_sp") or "")
    hour_label = "08h"
    try:
        parsed = datetime.fromisoformat(verified)
        hour_label = parsed.astimezone(SP).strftime("%H:%M")
    except Exception:
        pass
    if compact:
        return f"✅ {money(before_minor / 100.0)}→{money(after_minor / 100.0)} · {hour_label}"
    return f"✅ Escalada {money(before_minor / 100.0)} → {money(after_minor / 100.0)} às {hour_label}"


def build_intraday(
    target_date: str,
    now_sp: datetime,
    execute_actions: bool = False,
    *,
    manual_d3_v2: bool = False,
) -> tuple[str, dict]:
    operation = json.loads(OP_PATH.read_text())
    allowed_campaigns = validated_allowed_campaigns(operation)
    meta = fetch_meta(target_date)
    sb = fetch_sb(target_date, include_estimated=(target_date == now_sp.date().isoformat()), include_sms=False)
    rewarded_pricing = fetch_rewarded_pricing()
    rewarded_current = rewarded_pricing["current"]
    rewarded_previous = rewarded_pricing["previous_gray"]
    target_day = date.fromisoformat(target_date)
    history_start = (target_day - timedelta(days=INTRADAY_ROI_HISTORY_DAYS - 1)).isoformat()
    history_end = (target_day - timedelta(days=1)).isoformat()
    sb_history = fetch_sb_roi_history(history_start, history_end)
    prior_daily_roi = aggregate_sb_daily_roi(sb_history["rows"])
    d3_period_start = (target_day - timedelta(days=2)).isoformat()
    meta_period_agg = aggregate_meta(fetch_meta_period_insights(d3_period_start, target_date))
    sb_cycle_rows = [*sb_history["rows"], *sb["rows"]]
    meta_agg = aggregate_meta(meta["insights"])
    sb_agg = aggregate_sb(sb["rows"])
    current_by_id, _ = current_campaign_index(meta["campaigns"])
    adsets_by_campaign: dict[str, list[dict]] = defaultdict(list)
    for adset in meta["adsets"]:
        adsets_by_campaign[str(adset.get("campaign_id") or "")].append(adset)
    nonarchived_by_number: dict[str, list[str]] = defaultdict(list)
    for campaign in meta["campaigns"]:
        if str(campaign.get("status") or "").upper() == "ARCHIVED":
            continue
        number = campaign_number(campaign.get("name"))
        if number != "??":
            nonarchived_by_number[number].append(str(campaign.get("id") or ""))
    estimates = estimated_by_utm(sb.get("estimated") or {})
    guardrail_state = load_guardrail_state()
    rows = []
    for cid in report_campaign_ids(meta["campaigns"]):
        current = current_by_id.get(cid) or {}
        number = operation_campaign_number(current.get("name"))
        if number is None:
            continue
        target_cfg = allowed_campaigns.get(number) or {}
        m = meta_agg.get(cid) or {}
        s = sb_agg.get(cid) or {"investment": 0.0, "net_revenue": 0.0, "roi": None, "utm_adgroups": [f"b01fb13c{number}g01"]}
        estimate = estimate_campaign(s, estimates)
        name = str(current.get("name") or s.get("name") or f"Campaign {number}")
        cycle_start_date = campaign_cycle_start_date(current, target_cfg, now_sp.date())
        cycle = cycle_day_from_operational_start(cycle_start_date, now_sp.date())
        if cycle is None:
            raise RuntimeError(f"invalid operational cycle start: {number}")
        autonomous_write_eligible = (
            str(target_cfg.get("campaign_id") or "") == cid
            and nonarchived_by_number.get(number) == [cid]
        )
        row = {
            "number": number,
            "campaign_label": compact_campaign_label(
                number,
                name,
                cycle_start_date,
            ),
            "campaign_id": cid,
            "name": name,
            "status": current.get("configured_status") or current.get("status") or "UNKNOWN",
            "lance": bid_strategy_label(current, adsets_by_campaign.get(cid) or []),
            "budget_usd": as_float(current.get("daily_budget")) / 100.0,
            "cycle_day": cycle,
            "cycle_start_date": cycle_start_date,
            "autonomous_write_eligible": autonomous_write_eligible,
            "meta_spend": as_float(m.get("spend")),
            "meta_roas": m.get("purchase_roas"),
            "meta_cost": m.get("cost_per_purchase"),
            "sb_investment": as_float(s.get("investment")),
            "sb_revenue": as_float(s.get("net_revenue")),
            "sb_roi": s.get("roi"),
            "rps": s.get("rps"),
            "cpm": s.get("cpm"),
            "health_pct": s.get("health_pct"),
            "health_source": {key: s.get(key) for key in ("cdp_impressions", "gam_code_served_count", "health_source_complete")},
            "rewarded_coverage": rewarded_current.get("coverage_pct"),
            "rewarded_coverage_previous": rewarded_previous.get("coverage_pct"),
            "roi_history": campaign_roi_history(
                cid,
                target_date,
                s.get("roi"),
                prior_daily_roi,
                current_is_partial=(target_date == now_sp.date().isoformat()),
            ),
            **estimate,
        }
        row.update(
            d3_reality_metrics(
                cid,
                cycle_start_date,
                target_date,
                sb_cycle_rows,
                meta_period_agg,
                current_meta_spend=row["meta_spend"],
            )
        )
        prior_guardrail = (guardrail_state.get("campaigns") or {}).get(cid) or {}
        verified_scale = verified_scale_today(target_date, cid)
        row["recommendation"] = recommendation(
            cycle,
            row.get("sb_roi"),
            row.get("estimated_roi"),
            now_sp.hour,
            d3_negative_estimated_streak=d3_estimated_negative_streak(row, guardrail_state, target_date),
            d3_reality_gate=bool(row.get("d3_reality_gate")),
            manual_d3_v2=manual_d3_v2,
            scaled_at_08=bool(verified_scale),
            prior_16h_failures=int(prior_guardrail.get("consecutive_16h_failures") or 0),
        )
        if now_sp.hour == 8 and verified_scale:
            prior_recommendation = str((verified_scale.get("decision_context") or {}).get("recommendation") or "")
            prior_percent = re.search(r"\+(10|20|30)%", prior_recommendation)
            row["recommendation"] = (
                f"ESCALADO +{prior_percent.group(1)}% ✓" if prior_percent else "JÁ EXECUTADO"
            )
        rows.append(row)
    total_meta_spend = sum(row["meta_spend"] for row in rows)
    total_sb_investment = sum(row["sb_investment"] for row in rows)
    spend_diff = total_meta_spend - total_sb_investment
    anomaly = abs(spend_diff) > max(1.0, total_meta_spend * 0.02)
    reconciliation = {"spend_diff": spend_diff, "anomaly": anomaly}
    delay = sb.get("delay") or {}
    action_results, action_audit = ([], None)
    if execute_actions:
        action_results, action_audit = execute_intraday_actions(
            [row for row in rows if row.get("autonomous_write_eligible")],
            meta["account"],
            meta["campaigns"],
            {"delay": delay, "current_date": now_sp.date().isoformat()},
            reconciliation,
            target_date,
            now_sp,
            manual_d3_v2=manual_d3_v2,
        )
    creative_lifecycle = (
        execute_creative_lifecycle(rows, action_results, target_date, now_sp, reconciliation, operation)
        if execute_actions
        else {"status": "REPORT_ONLY_NO_WRITE", "decisions": [], "meta_writes": 0}
    )
    post_cut_cleanup = (
        execute_terminal_post_cut_cleanup(rows, action_results, creative_lifecycle, now_sp, operation)
        if execute_actions
        else {"status": "REPORT_ONLY_NO_WRITE", "results": [], "meta_writes": 0}
    )
    action_by_campaign = {str(item.get("campaign_id") or ""): item for item in action_results}
    post_cut_by_campaign = {
        str(item.get("campaign_id") or ""): item
        for item in post_cut_cleanup.get("results") or []
    }
    desktop_table_rows = []
    history_table_rows = []
    real_roi_counts = Counter()
    estimated_roi_counts = Counter()
    for row in rows:
        campaign_id = str(row.get("campaign_id") or "")
        action_result = action_by_campaign.get(campaign_id)
        decision_label = apply_action_result_to_intraday_row(row, action_result)
        cleanup_result = post_cut_by_campaign.get(campaign_id) or {}
        if str(cleanup_result.get("status") or "") in {
            "executed",
            "already_deleted_verified",
            "already_completed",
        }:
            row["status"] = "DELETED"
            row["configured_status"] = "DELETED"
            row["post_cut_complete"] = True
        real_signal = roi_direction_signal(row.get("sb_roi"))
        estimated_signal = roi_direction_signal(row.get("estimated_roi"))
        signal = f"{real_signal}{estimated_signal}"
        real_roi_counts[real_signal] += 1
        estimated_roi_counts[estimated_signal] += 1
        cost_label = "n/d" if row["meta_cost"] is None else money(row["meta_cost"])
        roas_label = "n/d" if row["meta_roas"] is None else f"{row['meta_roas']:.2f}".replace(".", ",")
        desktop_table_rows.append(
            [
                signal,
                row["campaign_label"],
                row["lance"],
                f"D{row['cycle_day']}" if row["cycle_day"] and row["cycle_day"] > 0 else "PREP",
                operator_status(row["status"]),
                money(row.get("budget_after_usd", row["budget_usd"])),
                money(row["meta_spend"]),
                cost_label,
                roas_label,
                pct(row["sb_roi"]),
                pct(row["estimated_roi"]),
                metric_money(row.get("rps")),
                metric_money(row.get("cpm")),
                health_label(row.get("health_pct")),
                f"{intraday_action_icon(decision_label)} {intraday_action_label(decision_label)}",
            ]
        )
        history_table_rows.append(
            [
                row["campaign_label"],
                f"D{row['cycle_day']}" if row["cycle_day"] and row["cycle_day"] > 0 else "PREP",
                *[
                    f"{pct(item.get('roi'))}{'*' if item.get('partial') else ''}"
                    for item in row.get("roi_history") or []
                ],
            ]
        )
    mode_label = "autonomia ativa" if execute_actions else "reemissão visual; nenhuma ação neste envio"
    summary_lines = [
        f"📈 INTRADAY — Creditoparaveiculo 13 G006 — {now_sp.strftime('%d/%m %H:%M')} SP",
        f"USD | SB real/estimado | {mode_label}",
        *intraday_operational_highlights(
            delay.get("totalMinutes"),
            rewarded_current,
            rewarded_previous,
        ),
        "",
        f"ROI real: 🟢 {real_roi_counts['🟢']} positivas   🔴 {real_roi_counts['🔴']} negativas   🟡 {real_roi_counts['🟡']} zero   ⚪ {real_roi_counts['⚪']} n/d",
        f"ROI estimado: 🟢 {estimated_roi_counts['🟢']} positivas   🔴 {estimated_roi_counts['🔴']} negativas   🟡 {estimated_roi_counts['🟡']} zero   ⚪ {estimated_roi_counts['⚪']} n/d",
    ]
    lines = []
    desktop_headers = ["R/E", "Camp", "Lance", "Dia", "Status", "Budget", "Spend", "Custo", "ROAS", "ROI real", "ROI est.", "RPS", "CPM", "Health", "Ação"]
    desktop_prefix_lines = [*summary_lines, "", "**Tabela consolidada — visão desktop**"]
    desktop_table_pages = prefixed_table_pages(
        desktop_headers,
        desktop_table_rows,
        desktop_prefix_lines,
    )
    lines.append("")
    for page_index, page in enumerate(desktop_table_pages):
        lines.append(page)
        if page_index < len(desktop_table_pages) - 1:
            lines.append("")
    history_headers = ["Camp", "Dia"] + [
        item["date_label"] for item in (rows[0].get("roi_history") or [])
    ] if rows else ["Camp", "Dia"]
    if history_table_rows:
        lines.extend([
            "",
            "**Histórico ROI SB — visão desktop**",
            "",
            aligned_table(history_headers, history_table_rows),
        ])
        if any(item.get("partial") for item in rows[0].get("roi_history") or []):
            lines.append(f"*{history_headers[-1]} parcial até {now_sp.strftime('%H:%M')} SP.*")
    lines.extend([
        "",
        f"Spend monitorado: {money(total_meta_spend)}",
        f"Conciliação Meta×SB: {'🔴 INVESTIGAR' if anomaly else '🟢 OK'} — diferença {money(spend_diff)}",
        "ROI líquido real da Smart Bidding decide; Custo e ROAS são sinais da Meta.",
        "Custo = spend ÷ omni_purchase da Meta.",
        "RPS/CPM = NET_REVENUE em USD com revenue share ÷ sessões/impressões GAM × 1.000.",
        "Health = ESTIMATED HEALTH do Adgroup SB: x = CDP matched ÷ GAM matched × 100; acima de 100%, usa max(0, 200 − x). Não é cobertura rewarded.",
        f"CR = GAM matched da cascata rewarded viva ({rewarded_pricing['slot_count']} blocos) ÷ GAM requests do bloco rewarded base; cinza = consolidado anterior.",
        "n/d = razão ainda não calculável: sem spend/evento Meta ou sem investimento/match no Smart Bidding.",
        "ROI R/E: 1ª bolinha = real | 2ª = estimado | 🟢 positivo | 🔴 negativo | 🟡 zero | ⚪ n/d",
        "Ação: 🧪 aprendizado D1/D2 | 👁️ observar | ✅ manter | 🚀 escalar | 🛑 pausar/bloquear",
    ])
    report = {
        "kind": "intraday",
        "health_contract": sb_health_contract(),
        "generated_at_sp": now_sp.isoformat(),
        "target_date": target_date,
        "currency": "USD",
        "presentation": {"mobile_campaign_cards": False, "layout": "desktop_tables_only"},
        "signal_semantics": {
            "order": ["real_roi", "estimated_roi"],
            "positive": "🟢",
            "negative": "🔴",
            "zero": "🟡",
            "unavailable": "⚪",
            "action_is_separate": True,
        },
        "delay": delay,
        "roi_history": {
            "days": INTRADAY_ROI_HISTORY_DAYS,
            "start_date": history_start,
            "end_date": target_date,
            "current_date_partial": target_date == now_sp.date().isoformat(),
            "source": "Smart Bidding NET_REVENUE USD with revenue share",
        },
        "rewarded_coverage": rewarded_pricing,
        "campaigns": rows,
        "totals": {"meta_spend": total_meta_spend, "sb_investment": total_sb_investment},
        "reconciliation": reconciliation,
        "decision_mode": "autonomous_guarded" if execute_actions else "report_only_no_write",
        "actions": action_results,
        "action_audit": action_audit,
        "creative_lifecycle": creative_lifecycle,
        "post_cut_cleanup": post_cut_cleanup,
    }
    return "\n".join(lines), report


def build_snapshot(now_sp: datetime) -> dict:
    closed_date = (now_sp.date() - timedelta(days=1)).isoformat()
    meta = fetch_meta(closed_date)
    sb = fetch_sb(closed_date, include_estimated=False)
    op = json.loads(OP_PATH.read_text())
    counts = Counter(short_status(row.get("configured_status") or row.get("status")) for row in meta["campaigns"])
    monitored = []
    current_by_id, _ = current_campaign_index(meta["campaigns"])
    for campaign_id in report_campaign_ids(meta["campaigns"]):
        row = current_by_id.get(campaign_id) or {}
        number = operation_campaign_number(row.get("name")) or "??"
        monitored.append(
            {
                "number": number,
                "campaign_id": row.get("id"),
                "name": row.get("name"),
                "status": row.get("configured_status") or row.get("status"),
                "daily_budget_usd": as_float(row.get("daily_budget")) / 100.0,
            }
        )
    return {
        "kind": "continuity_snapshot",
        "created_at_sp": now_sp.isoformat(),
        "closed_date": closed_date,
        "operation_id": op.get("operation_id"),
        "playbook_version": op.get("playbook_version"),
        "account": meta.get("account"),
        "manager": op.get("manager"),
        "campaign_status_counts": dict(counts),
        "monitored_campaigns": monitored,
        "meta_campaigns": meta.get("campaigns", []),
        "meta_adsets": meta.get("adsets", []),
        "meta_closed_day_insights": meta.get("insights", []),
        "smart_bidding_acquisition_rows": sb.get("rows", []),
        "smart_bidding_sms_rows": sb.get("sms_rows", []),
        "source_readback": {
            "meta": meta.get("credential_report"),
            "smart_bidding": sb.get("token_report"),
        },
        "learning_policy": op.get("learning_policy"),
        "daily_budget_policy": op.get("daily_budget_policy"),
        "sms_reporting": op.get("sms_reporting"),
        "discord_operational_structure": op.get("discord_operational_structure"),
        "history_policy": {
            "discord_threads": "preserved; no automatic deletion",
            "report_json": str(REPORT_ROOT),
            "context_management": "Hermes native context compaction; no scheduled session reset",
        },
        "next_step": "Use this daily snapshot + archived report JSON + operation config + current direct-traffic-cbo-operations skill + session_search/Discord thread import for continuity; no session reset performed.",
    }


def archive_scoped_threads() -> list[dict]:
    """Archive only the three fixed CPV threads approved by Rodolfo."""
    importer = BASE / "scripts/import-discord-thread.py"
    out_dir = SNAPSHOT_ROOT / "thread-history"
    out_dir.mkdir(parents=True, exist_ok=True)
    env = os.environ.copy()
    env.pop("DISCORD_BOT_TOKEN", None)
    archived = []
    for key, thread_id in THREAD_HISTORY_SCOPE.items():
        result = subprocess.run(
            [sys.executable, str(importer), "--profile", "ares", "--out-dir", str(out_dir), thread_id],
            cwd=str(BASE),
            env=env,
            capture_output=True,
            text=True,
            timeout=300,
            check=False,
        )
        if result.returncode != 0:
            safe = (result.stderr or result.stdout or "thread import failed").replace("\n", " ")[-500:]
            raise RuntimeError(f"scoped Discord archive failed for {key} HTTP/import: {safe}")
        json_path = out_dir / f"{thread_id}.json"
        md_path = out_dir / f"{thread_id}.md"
        payload = json.loads(json_path.read_text())
        archived.append(
            {
                "key": key,
                "thread_id": thread_id,
                "message_count": payload.get("message_count"),
                "imported_at_utc": payload.get("imported_at_utc"),
                "json_path": str(json_path),
                "markdown_path": str(md_path),
                "json_sha256": hashlib.sha256(json_path.read_bytes()).hexdigest(),
                "markdown_sha256": hashlib.sha256(md_path.read_bytes()).hexdigest(),
            }
        )
    return archived


def report_atomic_sections(text: str) -> list[str]:
    """Split only on blank lines outside fenced blocks."""
    sections: list[str] = []
    current: list[str] = []
    fence_open = False
    for line in text.strip().splitlines():
        if not fence_open and not line.strip():
            if current:
                sections.append("\n".join(current).strip("\n"))
                current = []
            continue
        current.append(line)
        if line.strip().startswith("```"):
            fence_open = not fence_open
    if fence_open:
        raise DiscordReportChunkingError("unbalanced fenced block in Discord report")
    if current:
        sections.append("\n".join(current).strip("\n"))
    return [section for section in sections if section]


def reflow_fenced_table_section(section: str, limit: int) -> list[str]:
    """Paginate one oversized aligned table with balanced fences and repeated headers."""
    lines = section.splitlines()
    if len(lines) < 5 or not lines[0].strip().startswith("```") or lines[-1].strip() != "```":
        raise DiscordReportChunkingError("oversized non-table Discord section cannot be reflowed safely")
    opening = lines[0]
    body = lines[1:-1]
    repeated_header = body[:2]
    data_rows = body[2:]
    if not data_rows:
        raise DiscordReportChunkingError("oversized fenced table has no pageable rows")
    pages: list[str] = []
    page_rows: list[str] = []
    for row in data_rows:
        candidate = "\n".join([opening, *repeated_header, *page_rows, row, "```"])
        if len(candidate) <= limit:
            page_rows.append(row)
            continue
        if not page_rows:
            raise DiscordReportChunkingError("single Discord table row exceeds safe chunk limit")
        pages.append("\n".join([opening, *repeated_header, *page_rows, "```"]))
        page_rows = [row]
        if len("\n".join([opening, *repeated_header, row, "```"])) > limit:
            raise DiscordReportChunkingError("single Discord table row exceeds safe chunk limit")
    if page_rows:
        pages.append("\n".join([opening, *repeated_header, *page_rows, "```"]))
    return pages


def split_message(text: str, limit: int = 1900, *, reflow_oversized_tables: bool = False) -> list[str]:
    if limit < 1:
        raise ValueError("Discord chunk limit must be positive")
    sections = report_atomic_sections(text)
    if reflow_oversized_tables:
        safe_sections: list[str] = []
        for section in sections:
            safe_sections.extend(
                reflow_fenced_table_section(section, limit) if len(section) > limit else [section]
            )
        sections = safe_sections
    chunks: list[str] = []
    current = ""
    for section in sections:
        if len(section) > limit:
            raise DiscordReportChunkingError("single Discord report section exceeds safe chunk limit")
        candidate = section if not current else f"{current}\n\n{section}"
        if len(candidate) <= limit:
            current = candidate
            continue
        if current:
            chunks.append(current)
        current = section
    if current:
        chunks.append(current)
    return chunks


def load_discord_token() -> str:
    for line in (PROFILE / ".env").read_text(errors="ignore").splitlines():
        if line.startswith("DISCORD_BOT_TOKEN="):
            return line.split("=", 1)[1].strip().strip('"').strip("'")
    raise RuntimeError("Ares Discord token unavailable")


def discord_retry_after_seconds(exc: urllib.error.HTTPError) -> float:
    retry_after = None
    try:
        body = json.loads(exc.read().decode("utf-8", errors="replace") or "{}")
        retry_after = body.get("retry_after")
    except Exception:
        retry_after = None
    if retry_after is None:
        retry_after = exc.headers.get("Retry-After") if exc.headers else None
    try:
        return max(0.05, float(retry_after))
    except (TypeError, ValueError):
        return 1.0


def discord_api_json(request: urllib.request.Request, *, expected_statuses: set[int]) -> tuple[int, dict]:
    """Execute one Discord request with bounded Retry-After handling for explicit HTTP 429."""
    waited = 0.0
    for retry_index in range(DISCORD_RATE_LIMIT_MAX_RETRIES + 1):
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                status = int(response.status)
                if status not in expected_statuses:
                    raise RuntimeError(f"unexpected Discord HTTP status {status}")
                raw = response.read()
                return status, (json.loads(raw) if raw else {})
        except urllib.error.HTTPError as exc:
            if exc.code != 429:
                raise
            retry_after = discord_retry_after_seconds(exc)
            if (
                retry_index >= DISCORD_RATE_LIMIT_MAX_RETRIES
                or waited + retry_after > DISCORD_RATE_LIMIT_MAX_WAIT_SECONDS
            ):
                raise DiscordRateLimitExhausted("Discord HTTP 429 persisted after bounded Retry-After") from exc
            time.sleep(retry_after)
            waited += retry_after
    raise DiscordRateLimitExhausted("Discord HTTP 429 retry loop exhausted")


def discord_message_plan(text: str) -> tuple[list[str], bool]:
    """Pack once, then retry once with safe fenced-table pagination before failing closed."""
    chunking_retry_used = False
    try:
        chunks = split_message(text, limit=1875)
    except DiscordReportChunkingError:
        chunking_retry_used = True
        chunks = split_message(text, limit=1875, reflow_oversized_tables=True)
    if any(chunk.count("```") % 2 for chunk in chunks):
        raise DiscordReportChunkingError("report exceeds safe Discord fenced-table chunking after bounded retry")
    # Desktop-only reports already carry semantic continuation headers. Avoid
    # transport-oriented [parte N/M] labels in the operator-facing messages.
    contents = list(chunks)
    if any(len(content) > 1900 for content in contents):
        raise DiscordReportChunkingError("Discord report chunk exceeds the 1900-character safety contract")
    return contents, chunking_retry_used


def discord_message_contents(text: str) -> list[str]:
    return discord_message_plan(text)[0]


def post_discord(thread_id: str, text: str) -> list[str]:
    token = load_discord_token()
    message_ids = []
    for content in discord_message_contents(text):
        payload = json.dumps({"content": content, "allowed_mentions": {"parse": []}}, ensure_ascii=False).encode()
        request = urllib.request.Request(
            f"https://discord.com/api/v10/channels/{thread_id}/messages",
            data=payload,
            headers={
                "Authorization": f"Bot {token}",
                "Content-Type": "application/json",
                "User-Agent": "MGS-Ares-Creditoparaveiculo-Reports/1.0",
            },
            method="POST",
        )
        try:
            _, body = discord_api_json(request, expected_statuses={200})
        except Exception as exc:
            if message_ids:
                raise DiscordPartialPostError(message_ids, exc) from exc
            raise
        message_id = str(body.get("id") or "")
        if not message_id:
            exc = RuntimeError("Discord POST response missing message ID")
            if message_ids:
                raise DiscordPartialPostError(message_ids, exc) from exc
            raise exc
        message_ids.append(message_id)
    return message_ids


def readback_discord_messages(thread_id: str, message_ids: list[str], expected_text: str | None = None) -> dict:
    token = load_discord_token()
    messages = []
    expected_contents = discord_message_contents(expected_text) if expected_text is not None else []
    for index, message_id in enumerate(message_ids):
        request = urllib.request.Request(
            f"https://discord.com/api/v10/channels/{thread_id}/messages/{message_id}",
            headers={
                "Authorization": f"Bot {token}",
                "User-Agent": "MGS-Ares-Creditoparaveiculo-Reports/1.0",
            },
        )
        status, body = discord_api_json(request, expected_statuses={200})
        actual_content = str(body.get("content") or "")
        item = {
            "message_id": str(body.get("id") or ""),
            "channel_id": str(body.get("channel_id") or ""),
            "http_status": status,
            "content_length": len(actual_content),
            "content_sha256": hashlib.sha256(actual_content.encode()).hexdigest(),
        }
        expected_content = expected_contents[index] if index < len(expected_contents) else None
        item["verified"] = (
            status == 200
            and item["message_id"] == str(message_id)
            and item["channel_id"] == str(thread_id)
            and item["content_length"] > 0
            and (expected_content is None or actual_content == expected_content)
        )
        messages.append(item)
    count_ok = expected_text is None or len(messages) == len(expected_contents)
    return {"ok": bool(messages) and count_ok and all(item["verified"] for item in messages), "messages": messages}


def deliver_report_once(
    delivery_key: str,
    thread_id: str,
    text: str,
    *,
    force: bool = False,
) -> tuple[list[str], dict, bool]:
    """Post once per automatic slot; forced operator reissues replace the slot record."""
    DELIVERY_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with DELIVERY_LOCK.open("a+") as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        try:
            if DELIVERY_STATE.exists():
                try:
                    state = json.loads(DELIVERY_STATE.read_text())
                except Exception as exc:
                    raise RuntimeError("report delivery state is invalid; fail closed") from exc
            else:
                state = {"schema_version": "1.0", "deliveries": {}}
            deliveries = state.setdefault("deliveries", {})
            prior = deliveries.get(delivery_key)
            if prior and not force:
                if str(prior.get("status") or "") == "verified":
                    ids = [str(item) for item in prior.get("message_ids") or []]
                    try:
                        delivery = readback_discord_messages(thread_id, ids)
                    except DiscordRateLimitExhausted:
                        return ids, {"ok": False, "deferred": True, "reason": "discord_rate_limit", "suppressed_duplicate": True}, True
                    observed_hashes = [item.get("content_sha256") for item in delivery.get("messages") or []]
                    if delivery.get("ok") and observed_hashes == list(prior.get("message_sha256") or []):
                        return ids, {**delivery, "suppressed_duplicate": True}, True
                    raise RuntimeError("verified delivery no longer passes Discord readback")
                ids = [str(item) for item in prior.get("message_ids") or []]
                if ids:
                    try:
                        delivery = readback_discord_messages(thread_id, ids)
                    except DiscordRateLimitExhausted:
                        return ids, {"ok": False, "deferred": True, "reason": "discord_rate_limit", "suppressed_duplicate": True}, True
                    observed_hashes = [item.get("content_sha256") for item in delivery.get("messages") or []]
                    if delivery.get("ok") and observed_hashes == list(prior.get("message_sha256") or []):
                        prior.update(status="verified", recovered_by_get=True, verified_at_sp=datetime.now(SP).isoformat())
                        atomic_write_json(DELIVERY_STATE, state)
                        return ids, {**delivery, "suppressed_duplicate": True, "recovered": True}, True
                raise RuntimeError("pending report delivery requires manual recovery; duplicate blocked")

            content_hash = hashlib.sha256(text.encode()).hexdigest()
            planned_contents, chunking_retry_used = discord_message_plan(text)
            message_hashes = [hashlib.sha256(content.encode()).hexdigest() for content in planned_contents]
            deliveries[delivery_key] = {
                "status": "in_flight",
                "thread_id": str(thread_id),
                "content_sha256": content_hash,
                "message_sha256": message_hashes,
                "chunking_retry_used": chunking_retry_used,
                "started_at_sp": datetime.now(SP).isoformat(),
            }
            atomic_write_json(DELIVERY_STATE, state)
            try:
                ids = post_discord(thread_id, text)
            except DiscordPartialPostError as exc:
                deliveries[delivery_key].update(
                    status="partial_post",
                    message_ids=exc.message_ids,
                    partial_post_at_sp=datetime.now(SP).isoformat(),
                    recovery_required="GET existing IDs before any new POST",
                )
                atomic_write_json(DELIVERY_STATE, state)
                raise
            deliveries[delivery_key].update(status="posted", message_ids=ids, posted_at_sp=datetime.now(SP).isoformat())
            atomic_write_json(DELIVERY_STATE, state)
            try:
                delivery = readback_discord_messages(thread_id, ids, expected_text=text)
            except DiscordRateLimitExhausted:
                deliveries[delivery_key].update(
                    status="readback_deferred",
                    readback_deferred_at_sp=datetime.now(SP).isoformat(),
                    deferred_reason="discord_rate_limit",
                )
                atomic_write_json(DELIVERY_STATE, state)
                return ids, {"ok": False, "deferred": True, "reason": "discord_rate_limit"}, False
            if not delivery.get("ok"):
                raise RuntimeError("Discord report readback mismatch")
            deliveries[delivery_key].update(status="verified", verified_at_sp=datetime.now(SP).isoformat())
            atomic_write_json(DELIVERY_STATE, state)
            return ids, delivery, False
        finally:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)


def save_report(kind: str, payload: dict, now_sp: datetime) -> Path:
    path = REPORT_ROOT / kind
    path.mkdir(parents=True, exist_ok=True)
    target = path / f"{kind}-{now_sp.astimezone(UTC).strftime('%Y%m%dT%H%M%SZ')}.json"
    target.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n")
    return target


def intraday_gate_due(hour: int, *, actions_only: bool) -> bool:
    return hour in INTRADAY_ACTION_HOURS if actions_only else hour in INTRADAY_REPORT_HOURS


def daily_target_date(now_sp: datetime, override: str | None = None) -> str:
    """Resolve the Daily period from the approved São Paulo dispatch slot."""
    if override:
        return override
    if now_sp.hour == 7:
        return (now_sp.date() - timedelta(days=1)).isoformat()
    return now_sp.date().isoformat()


def snapshot_due(now_sp: datetime) -> bool:
    if not SNAPSHOT_STATE.exists():
        return True
    try:
        previous = datetime.fromisoformat(json.loads(SNAPSHOT_STATE.read_text()).get("last_snapshot_sp"))
        return previous.astimezone(SP).date() != now_sp.date()
    except Exception:
        return True


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", choices=["daily", "intraday", "reactivate", "snapshot"], required=True)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--report-only", action="store_true", help="Post/read report without campaign writes")
    parser.add_argument("--actions-only", action="store_true", help="Run campaign actions without posting the Intraday report")
    parser.add_argument("--gate", action="store_true", help="Exit silently outside the approved São Paulo schedule")
    parser.add_argument("--date", help="Override report date YYYY-MM-DD for testing")
    args = parser.parse_args()
    if args.actions_only and args.mode != "intraday":
        parser.error("--actions-only requires --mode intraday")
    if args.actions_only and args.report_only:
        parser.error("--actions-only and --report-only are mutually exclusive")
    now_sp = datetime.now(SP)
    if args.gate and not args.dry_run:
        if args.mode == "daily" and now_sp.hour not in DAILY_REPORT_HOURS:
            return 0
        if args.mode == "intraday" and not intraday_gate_due(now_sp.hour, actions_only=args.actions_only):
            return 0
        if args.mode == "reactivate" and (
            now_sp.hour != GUARDRAIL_REACTIVATION_HOUR or now_sp.minute != GUARDRAIL_REACTIVATION_MINUTE
        ):
            return 0
        if args.mode == "snapshot" and (now_sp.hour != 3 or not snapshot_due(now_sp)):
            return 0
    if args.mode == "reactivate":
        if args.dry_run:
            state = load_guardrail_state()
            due = [
                campaign_id
                for campaign_id, record in (state.get("campaigns") or {}).items()
                if not record.get("terminal")
                and (record.get("pending_reactivation") or {}).get("due_date") == now_sp.date().isoformat()
            ]
            print(json.dumps({"status": "DRY_RUN_OK", "due_campaign_ids": due, "meta_writes": 0}, indent=2))
            return 0
        execute_guardrail_reactivations(now_sp)
        return 0
    if args.mode == "daily":
        target = daily_target_date(now_sp, args.date)
        text, payload = build_daily(target, now_sp)
        path = save_report("daily", payload, now_sp)
        if args.dry_run:
            print(text)
            print(f"\n[DRY-RUN audit={path} chunks={len(split_message(text))} max={max(map(len, split_message(text)))}]")
        else:
            ids, delivery, suppressed = deliver_report_once(
                f"daily:{target}:{now_sp.hour:02d}", THREAD_DAILY, text, force=(not args.gate or args.report_only)
            )
            payload["discord_readback"] = {
                "thread_id": THREAD_DAILY,
                "message_ids": ids,
                "chunks": len(ids),
                "suppressed_duplicate": suppressed,
                **delivery,
            }
            path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n")
        return 0
    if args.mode == "intraday":
        target = args.date or now_sp.date().isoformat()
        execute_actions = not args.dry_run and not args.report_only and args.date is None
        text, payload = build_intraday(target, now_sp, execute_actions=execute_actions)
        path = save_report("intraday", payload, now_sp)
        if args.dry_run:
            print(text)
            print(f"\n[DRY-RUN audit={path} chunks={len(split_message(text))} max={max(map(len, split_message(text)))}]")
        elif args.actions_only:
            payload["actions_only"] = True
            payload["discord_posted"] = False
            path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n")
        else:
            ids, delivery, suppressed = deliver_report_once(
                f"intraday:{target}:{now_sp.hour:02d}",
                THREAD_INTRADAY,
                text,
                force=(not args.gate or args.report_only),
            )
            payload["discord_readback"] = {
                "thread_id": THREAD_INTRADAY,
                "message_ids": ids,
                "chunks": len(ids),
                "suppressed_duplicate": suppressed,
                **delivery,
            }
            path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n")
        return 0
    snapshot = build_snapshot(now_sp)
    if args.dry_run:
        print(json.dumps({
            "status": "DRY_RUN_OK",
            "kind": snapshot["kind"],
            "created_at_sp": snapshot["created_at_sp"],
            "campaign_status_counts": snapshot["campaign_status_counts"],
            "monitored_campaigns": snapshot["monitored_campaigns"],
            "would_reset_session": False,
        }, ensure_ascii=False, indent=2))
        return 0
    snapshot["thread_history_archive"] = archive_scoped_threads()
    snapshot["thread_history_scope"] = {
        "included_thread_ids": list(THREAD_HISTORY_SCOPE.values()),
        "other_threads": "untouched; follow the standard agreed with Zeus",
    }
    SNAPSHOT_ROOT.mkdir(parents=True, exist_ok=True)
    target = SNAPSHOT_ROOT / f"snapshot-{now_sp.astimezone(UTC).strftime('%Y%m%dT%H%M%SZ')}.json"
    target.write_text(json.dumps(snapshot, ensure_ascii=False, indent=2) + "\n")
    SNAPSHOT_STATE.parent.mkdir(parents=True, exist_ok=True)
    SNAPSHOT_STATE.write_text(json.dumps({"last_snapshot_sp": now_sp.isoformat(), "path": str(target)}, ensure_ascii=False, indent=2) + "\n")
    print(f"Snapshot local concluído — Creditoparaveiculo 13 G006 — {now_sp.strftime('%d/%m/%Y %H:%M')} SP.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        safe = str(exc).replace("\n", " ")[-700:]
        mode = ""
        if "--mode" in sys.argv:
            try:
                mode = sys.argv[sys.argv.index("--mode") + 1]
            except (ValueError, IndexError):
                mode = ""
        if (
            "--dry-run" not in sys.argv
            and mode in {"daily", "intraday"}
            and not isinstance(exc, (DiscordRateLimitExhausted, DiscordPartialPostError))
        ):
            try:
                target_thread = THREAD_DAILY if mode == "daily" else THREAD_INTRADAY
                failure_kind = "checkpoint automático" if "--actions-only" in sys.argv else f"relatório {mode}"
                post_discord(
                    target_thread,
                    f"Falha no {failure_kind} — Creditoparaveiculo 13 G006. Dados não publicados para evitar valores incompletos. Motivo: {type(exc).__name__}: {safe}",
                )
            except Exception:
                pass
        print(f"Falha no relatório Creditoparaveiculo 13 G006: {type(exc).__name__}: {safe}", file=sys.stderr)
        raise SystemExit(1)
