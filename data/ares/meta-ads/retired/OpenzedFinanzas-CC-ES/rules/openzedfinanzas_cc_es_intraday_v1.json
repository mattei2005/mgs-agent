{
  "schema_version": "1.3",
  "ruleset": "openzedfinanzas_cc_es_intraday_v1",
  "operation_id": "OpenzedFinanzas-CC-ES",
  "mode": "dry_run_until_write_approved",
  "rules": [
    {
      "id": "R1",
      "enabled": true,
      "status": "proposed_pending_dry_run",
      "description": "MO = 0 and spend > USD 5.00 => pause campaign",
      "metric_source": "meta_insights_actions_complete_registration",
      "metric_name": [
        "MO",
        "CPMO",
        "spend"
      ],
      "window": "intraday_current_day",
      "condition": {
        "all": [
          {
            "metric": "MO",
            "op": "eq",
            "value": 0
          },
          {
            "metric": "spend",
            "op": "gt",
            "value": 5.0,
            "currency": "USD"
          }
        ]
      },
      "action": "pause_campaign",
      "priority": 1,
      "exclusions": [
        "TEST_grace_3_days",
        "reactivate_exclusion_list"
      ],
      "notes": "Rodolfo correction: Europe/GDPR operation uses MO=complete_registration; USD account."
    },
    {
      "id": "R2",
      "enabled": true,
      "status": "proposed_pending_dry_run",
      "description": "MO > 0 and CPMO > USD 3.25 => pause campaign",
      "metric_source": "meta_insights_actions_complete_registration",
      "metric_name": [
        "MO",
        "CPMO",
        "spend"
      ],
      "window": "intraday_current_day",
      "condition": {
        "all": [
          {
            "metric": "MO",
            "op": "gt",
            "value": 0
          },
          {
            "metric": "CPMO",
            "op": "gt",
            "value": 3.25,
            "currency": "USD"
          }
        ]
      },
      "action": "pause_campaign",
      "priority": 2,
      "exclusions": [
        "TEST_grace_3_days",
        "reactivate_exclusion_list"
      ],
      "notes": "Suggested from month analysis; dry-run before write."
    },
    {
      "id": "R3",
      "enabled": true,
      "status": "proposed_pending_dry_run",
      "description": "MO = 1 and spend > USD 5.00 => pause campaign",
      "metric_source": "meta_insights_actions_complete_registration",
      "metric_name": [
        "MO",
        "CPMO",
        "spend"
      ],
      "window": "intraday_current_day",
      "condition": {
        "all": [
          {
            "metric": "MO",
            "op": "eq",
            "value": 1
          },
          {
            "metric": "spend",
            "op": "gt",
            "value": 5.0,
            "currency": "USD"
          }
        ]
      },
      "action": "pause_campaign",
      "priority": 3,
      "exclusions": [
        "TEST_grace_3_days",
        "reactivate_exclusion_list"
      ],
      "notes": "Canonical Europe rule from reference image; dry-run before write."
    },
    {
      "id": "R4",
      "enabled": true,
      "status": "proposed_pending_dry_run",
      "description": "LOWEST_COST with MO >= 2, CPMO > USD 2.00 and spend >= USD 8.00 => pause campaign",
      "metric_source": "meta_insights_actions_complete_registration",
      "metric_name": [
        "MO",
        "CPMO",
        "spend"
      ],
      "window": "intraday_current_day",
      "condition": {
        "all": [
          {
            "field": "bid_strategy",
            "op": "eq",
            "value": "LOWEST_COST"
          },
          {
            "metric": "MO",
            "op": "gte",
            "value": 2
          },
          {
            "metric": "CPMO",
            "op": "gt",
            "value": 2.0,
            "currency": "USD"
          },
          {
            "metric": "spend",
            "op": "gte",
            "value": 8.0,
            "currency": "USD"
          }
        ]
      },
      "action": "pause_campaign",
      "priority": 4,
      "exclusions": [
        "TEST_grace_3_days",
        "reactivate_exclusion_list",
        "COST_CAP_no_cost_pause"
      ],
      "notes": "COST_CAP still excluded from cost-based pause."
    },
    {
      "id": "R5",
      "enabled": true,
      "status": "proposed_pending_dry_run",
      "description": "Paused campaign with MO >= 2 and CPMO < USD 2.50 => reactivate campaign",
      "metric_source": "meta_insights_actions_complete_registration",
      "metric_name": [
        "effective_status",
        "MO",
        "CPMO"
      ],
      "window": "intraday_current_day",
      "condition": {
        "all": [
          {
            "field": "effective_status",
            "op": "eq",
            "value": "PAUSED"
          },
          {
            "metric": "MO",
            "op": "gte",
            "value": 2
          },
          {
            "metric": "CPMO",
            "op": "lt",
            "value": 2.5,
            "currency": "USD"
          }
        ]
      },
      "action": "reactivate_campaign",
      "priority": 5,
      "exclusions": [
        "TEST_grace_3_days",
        "reactivate_exclusion_list"
      ],
      "notes": "Reactivation is conservative; dry-run before write."
    }
  ],
  "reactivate_all": {
    "enabled": true,
    "time": "00:30",
    "timezone": "meta_ad_account_timezone",
    "scope": "all_paused_campaigns",
    "exclusion_list": [],
    "ask_before_adding_exclusion": true
  },
  "rules_definition_status": "MO_CPMO_USD_rules_proposed_pending_Rodolfo_approval",
  "next_action": "run_dry_run_R1_R5_with_MO_CPMO_USD_then_confirm_before_write",
  "threshold_currency": "USD",
  "calibration_policy": "Thresholds in USD because the Business Manager/ad account is USD. Proposed values require dry-run and Rodolfo approval before write.",
  "global_exceptions": [
    {
      "id": "TEST_grace_3_days",
      "condition": {
        "campaign_name_contains": "TEST",
        "active_age_days_lt": 3
      },
      "effect": "immune_to_all_intraday_rules",
      "source_preference": [
        "meta_created_time",
        "first_seen_at"
      ]
    },
    {
      "id": "COST_CAP_no_cost_pause",
      "condition": {
        "bid_strategy": "COST_CAP",
        "rule_metric": [
          "CPS",
          "CPMO"
        ]
      },
      "effect": "do_not_pause_by_cost_rules",
      "rationale": "Bid cap controls cost."
    }
  ],
  "metric_mapping": {
    "mapping_id": "openzedfinanzas_cc_es_metrics_v1",
    "mapping_path": "/root/mgs-agent/data/ares/meta-ads/metrics/openzedfinanzas_cc_es_metrics_v1.json",
    "MO_action_type": "complete_registration",
    "CPMO_formula": "spend / MO",
    "intraday_policy": "Europe/GDPR uses MO/CPMO, not subs/CPS"
  },
  "updated_at": "2026-06-17T19:21:09.520730+00:00"
}
