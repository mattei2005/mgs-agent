[Unit]
Description=MGS Router - routes and administrative panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mgs-router
Group=mgs-router
ExecStart=/opt/mgs-router/mgs-router --listen 0.0.0.0:443 --state /var/lib/mgs-router --origin https://route.mgsdigitalcorp.com --tls-cert /run/credentials/mgs-router.service/origin-cert --tls-key /run/credentials/mgs-router.service/origin-key --trusted-edge-file /opt/mgs-router/cloudflare-edges.txt
LoadCredential=origin-cert:/root/.local/share/mgs-router-private/origin.pem
LoadCredential=origin-key:/root/.local/share/mgs-router-private/origin.key
StateDirectory=mgs-router
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
CPUQuota=50%
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
