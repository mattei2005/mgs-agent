[Unit]
Description=MGS Finance live Meta account lookup (read-only BM)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/root/mgs-agent/apps/finance-system
ExecStart=/usr/bin/python3 /root/mgs-agent/apps/finance-system/meta-lookup-worker.py
Restart=on-failure
RestartSec=20
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=400M
CPUQuota=25%
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
