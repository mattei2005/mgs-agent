 def browser_exec(code: str, session: str = "", timeout_s: int = _DEFAULT_TIMEOUT_S,
                  task_id: Optional[str] = None, local: bool = False):
+    """Admit the entire action BEFORE backend routing can spawn a browser."""
+    from contextlib import ExitStack
+    from tools.registry import tool_error
+    with ExitStack() as stack:
+        try:
+            budget_path = _read_browser_cfg().get("resource_budget_module")
+            if budget_path:
+                import importlib.util
+                spec = importlib.util.spec_from_file_location("mgs_browser_action_budget", budget_path)
+                if spec is None or spec.loader is None:
+                    raise RuntimeError("configured browser budget module cannot be loaded")
+                budget = importlib.util.module_from_spec(spec)
+                spec.loader.exec_module(budget)
+                stack.enter_context(budget.browser_lease())
+        except (OSError, RuntimeError, ValueError) as e:
+            return tool_error(f"Browser admission failed: {e}")
+        return _browser_exec_admitted(code, session, timeout_s, task_id, local)
+
+
+def _browser_exec_admitted(code: str, session: str = "", timeout_s: int = _DEFAULT_TIMEOUT_S,
+                           task_id: Optional[str] = None, local: bool = False):
     """Run Python code through the browser-use CLI, and return its output"""
