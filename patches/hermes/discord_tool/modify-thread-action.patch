+def _modify_thread(
+    token: str, channel_id: str,
+    name: Optional[str] = None,
+    archived: Optional[bool] = None,
+    auto_archive_duration: Optional[int] = None,
+    locked: Optional[bool] = None,
+    **_kwargs: Any,
+) -> str:
+    """Modify thread properties (rename, archive, lock).
+
+    channel_id: thread ID to modify.
+    name: new thread name (max 100 chars).
+    archived: archive (True) or unarchive (False) the thread.
+    auto_archive_duration: minutes (60, 1440, 4320, 10080).
+    locked: lock (True) or unlock (False) the thread.
+    """
+    body: Dict[str, Any] = {}
+    if name is not None:
+        body["name"] = name[:100]
+    if archived is not None:
+        body["archived"] = archived
+    if auto_archive_duration is not None:
+        body["auto_archive_duration"] = auto_archive_duration
+    if locked is not None:
+        body["locked"] = locked
+
+    if not body:
+        return json.dumps({"success": False, "error": "no_fields_to_update"})
+
+    thread = _discord_request("PATCH", f"/channels/{channel_id}", token, body=body)
+    return json.dumps({
+        "success": True,
+        "thread_id": thread["id"],
+        "name": thread.get("name"),
+        "archived": thread.get("thread_metadata", {}).get("archived"),
+    })
+
+
 def _add_role(token: str, guild_id: str, user_id: str, role_id: str, **_kwargs: Any) -> str:
     """Add a role to a guild member."""
     _discord_request("PUT", f"/guilds/{guild_id}/members/{user_id}/roles/{role_id}", token)
