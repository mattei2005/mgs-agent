+})
+
+_DISCORD_BOT_LOOP_NOISE_PREFIXES = (
+    "⚠️ empty response from model",
+    "empty response from model",
+    "⚠️ no reply: the model returned empty content",
+    "no reply: the model returned empty content",
+    "❌ model returned no content after all retries",
+    "model returned no content after all retries",
+    "codex response remained incomplete",
+    "⚠️ processing stopped: codex response remained incomplete",
+)
+
