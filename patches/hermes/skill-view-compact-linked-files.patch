+_LINKED_FILES_COMPACT_THRESHOLD = 40
+_LINKED_FILES_MODES = {"auto", "compact", "full"}
+
+
+def _linked_files_for_view(
+    linked_files: Dict[str, List[str]],
+    rendered_content: str,
+    hermes_meta: Dict[str, Any],
+) -> Tuple[Dict[str, List[str]], Optional[Dict[str, Any]]]:
+    """Return a context-efficient linked-file index for a main skill view.
+
+    Small inventories preserve the historical full-list response. Large
+    inventories default to ``auto`` mode: only files explicitly named in the
+    rendered SKILL.md are returned, while deterministic per-category counts
+    preserve visibility into omitted support files. Direct ``file_path`` reads
+    return earlier in :func:`skill_view` and are therefore unchanged.
+
+    Rollback/override controls, read on every call:
+
+    - ``skills.linked_files_mode`` in config: ``auto`` (default), ``compact``,
+      or ``full``.
+    - ``metadata.hermes.linked_files_mode`` in SKILL.md overrides config for
+      one skill.
+    - ``skills.linked_files_compact_threshold`` changes the auto threshold
+      (default 40 total files).
+    """
+    normalized = {
+        category: list(files) for category, files in linked_files.items() if files
+    }
+    total = sum(len(files) for files in normalized.values())
+    if not total:
+        return normalized, None
+
+    mode = "auto"
+    threshold = _LINKED_FILES_COMPACT_THRESHOLD
+    try:
+        from hermes_cli.config import load_config
+
+        skills_cfg = (load_config() or {}).get("skills", {})
+        mode = str(skills_cfg.get("linked_files_mode", mode)).strip().lower()
+        threshold = int(
+            skills_cfg.get("linked_files_compact_threshold", threshold)
+        )
+    except (TypeError, ValueError):
+        threshold = _LINKED_FILES_COMPACT_THRESHOLD
+    except Exception:
+        logger.debug("Could not load linked-files view policy", exc_info=True)
+
+    mode = str(hermes_meta.get("linked_files_mode", mode)).strip().lower()
+    if mode not in _LINKED_FILES_MODES:
+        mode = "auto"
+    threshold = max(1, min(threshold, 1000))
+
+    should_compact = mode == "compact" or (mode == "auto" and total > threshold)
+    if not should_compact:
+        return normalized, None
+
+    content = (rendered_content or "").replace("\\", "/")
+    visible: Dict[str, List[str]] = {}
+    totals: Dict[str, int] = {}
+    shown: Dict[str, int] = {}
+    omitted: Dict[str, int] = {}
+    for category, files in normalized.items():
+        selected = [path for path in files if path.replace("\\", "/") in content]
+        if selected:
+            visible[category] = selected
+        totals[category] = len(files)
+        shown[category] = len(selected)
+        omitted[category] = len(files) - len(selected)
+
+    omitted_total = sum(omitted.values())
+    if omitted_total == 0:
+        return normalized, None
+
+    summary = {
+        "compacted": True,
+        "mode": mode,
+        "threshold": threshold,
+        "total_files": total,
+        "shown_files": total - omitted_total,
+        "omitted_files": omitted_total,
+        "totals": totals,
+        "shown": shown,
+        "omitted": omitted,
+    }
+    return visible, summary
+
+
 
