+def test_honcho_shutdown_joins_init_then_late_prefetch_thread():
+    """Shutdown must drain a prefetch thread spawned by background init."""
+    provider = HonchoMemoryProvider()
+    prefetch_done = threading.Event()
+
+    def late_prefetch():
+        time.sleep(0.05)
+        prefetch_done.set()
+
+    def background_init():
+        time.sleep(0.05)
+        provider._prefetch_thread = threading.Thread(
+            target=late_prefetch,
+            daemon=True,
+            name="honcho-test-late-prefetch",
+        )
+        provider._prefetch_thread.start()
+
+    provider._init_thread = threading.Thread(
+        target=background_init,
+        daemon=True,
+        name="honcho-test-session-init",
+    )
+    provider._init_thread.start()
+
+    provider.shutdown()
+
+    assert not provider._init_thread.is_alive()
+    assert prefetch_done.is_set()
+    assert provider._prefetch_thread is not None
+    assert not provider._prefetch_thread.is_alive()
+
+
+def test_honcho_provider_shutdown_stops_manager_async_writer():
+    """Provider shutdown must call the manager lifecycle shutdown, not flush only."""
+    provider = HonchoMemoryProvider()
+    calls = []
+
+    class Manager:
+        def flush_all(self):
+            calls.append("flush")
+
+        def shutdown(self):
+            calls.append("shutdown")
+
+    object.__setattr__(provider, "_manager", Manager())
+
+    provider.shutdown()
+
+    assert calls == ["shutdown"]
+
+
+def test_honcho_manager_shutdown_joins_context_prefetch_thread():
+    """Manager shutdown must drain context-prefetch daemon workers."""
+    from plugins.memory.honcho.session import HonchoSessionManager
+
+    manager = object.__new__(HonchoSessionManager)
+    done = threading.Event()
+    worker = threading.Thread(
+        target=lambda: (time.sleep(0.05), done.set()),
+        daemon=True,
+        name="honcho-test-context-prefetch",
+    )
+    object.__setattr__(manager, "_context_prefetch_threads", [worker])
+    object.__setattr__(manager, "_context_prefetch_threads_lock", threading.Lock())
+    object.__setattr__(manager, "_async_queue", None)
+    object.__setattr__(manager, "_async_thread", None)
+    worker.start()
+
+    manager.shutdown()
+
+    assert done.is_set()
+    assert not worker.is_alive()
