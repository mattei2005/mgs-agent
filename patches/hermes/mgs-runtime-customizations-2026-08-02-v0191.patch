+        "mode": mode,
+        "threshold": threshold,
+        "total_files": total,
+        "shown_files": total - omitted_total,
+        "omitted_files": omitted_total,
+        "totals": totals,
+        "shown": shown,
+        "omitted": omitted,
+    }
