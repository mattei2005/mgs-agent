+    init_error=None,
+    memory_error=None,
+):
+    """Install the smallest real `_run_agent` dependency seam for cleanup tests."""
+    import hermes_cli.oneshot as oneshot
+
+    class FakeSessionDB:
+        def close(self):
+            events.append("session_db.close")
+
+    session_db = FakeSessionDB()
+
+    class FakeAgent:
+        def __init__(self, **_kwargs):
+            if init_error is not None:
+                raise init_error
+            self._session_messages = [{"role": "user", "content": "hello"}]
+            self.suppress_status_output = False
+            self.stream_delta_callback = object()
+            self.tool_gen_callback = object()
+
+        def run_conversation(self, _prompt):
+            events.append("run_conversation")
+            if chat_error is not None:
+                raise chat_error
+            return {"final_response": "ok"}
+
+        def shutdown_memory_provider(self, _messages=None):
+            events.append("shutdown_memory_provider")
+            if memory_error is not None:
+                raise memory_error
+
+        def close(self):
+            events.append("agent.close")
+
+    def module(name, **attrs):
+        mod = types.ModuleType(name)
+        for key, value in attrs.items():
+            setattr(mod, key, value)
+        return mod
