+    def _is_discord_thread_lane(self, source: SessionSource) -> bool:
+        """Return True when a gateway session maps to a Discord thread."""
+        return (
+            source.platform == Platform.DISCORD
+            and (source.chat_type == "thread" or bool(source.thread_id))
+            and bool(source.chat_id or source.thread_id)
+        )
+
+    def _sanitize_discord_thread_title(self, title: str) -> str:
+        """Return a Discord-safe MGS title with UTF-16-aware truncation."""
+        cleaned = re.sub(r"\s+", " ", str(title or "")).strip(" \t\n\r:;,.!?—-–")
+        if not cleaned:
+            return "Assunto da Thread"
+        # Discord caps names at 100 UTF-16 code units; keep headroom for the
+        # MGS ` - FirstName` suffix and avoid splitting surrogate pairs.
+        if utf16_len(cleaned) > 90:
+            cleaned = _prefix_within_utf16_limit(cleaned, 87).rstrip(
+                " \t\n\r:;,.!?—-–"
+            ) + "..."
+        return cleaned
+
+    def _discord_title_message_from_gateway_text(self, message: str) -> str:
+        """Extract the actionable user text for Discord auto-title generation.
+
+        Removes history-backfill context and the shared-thread sender prefix so
+        title_generator sees the user's request, not gateway scaffolding.
+        """
+        text = str(message or "").strip()
+        parts = re.split(r"\n\n\[New message[^\]]*\]\n", text, maxsplit=1)
+        if len(parts) == 2:
+            text = parts[1].strip()
+        text = re.sub(r"^\[[^\]\n]{1,100}\]\s*", "", text).strip()
+        return text or str(message or "").strip()
+
+    def _first_name_for_discord_thread_title(self, display_name: str) -> str:
+        """Return the short first-name suffix for MGS Discord thread titles."""
+        name = re.sub(r"\s+", " ", str(display_name or "")).strip(" \t\n\r:;,.!?—-–")
+        if not name:
+            return ""
+        token = re.split(r"[\s@#|/\\]+", name, maxsplit=1)[0]
+        token = re.sub(r"[^0-9A-Za-zÀ-ÖØ-öø-ÿ_-]", "", token).strip("_-.")
+        return token[:24]
+
+    def _append_discord_thread_author_suffix(self, title: str, source: SessionSource) -> str:
+        """Append ` - FirstName` to the chosen title without changing base naming."""
+        base = self._sanitize_discord_thread_title(title)
+        first_name = self._first_name_for_discord_thread_title(getattr(source, "user_name", "") or "")
+        if not first_name:
+            return base
+        suffix = f" - {first_name}"
+        if base.endswith(suffix):
+            return base
+        max_base_units = max(1, 100 - utf16_len(suffix))
+        if utf16_len(base) > max_base_units:
+            base = _prefix_within_utf16_limit(base, max_base_units).rstrip(
+                " \t\n\r:;,.!?—-–"
+            )
+        return f"{base}{suffix}"
+
+    async def _discord_thread_safe_to_autorename(
+        self,
+        source: SessionSource,
+        *,
+        session_id: str = "",
+        max_thread_age_seconds: float = 1800.0,
+    ) -> bool:
+        """Return True only for the one safe AI rename of a new Discord thread.
+
+        Uses the exact provisional title stored by adapter._auto_create_thread;
+        if that value is absent (restart, human-created thread, old thread), fail
+        closed and do not rename.
+        """
+        if not self._is_discord_thread_lane(source):
+            return False
+
+        adapter = self.adapters.get(source.platform) if getattr(self, "adapters", None) else None
+        client = getattr(adapter, "_client", None) if adapter is not None else None
+        if client is None:
+            return False
+
+        thread_id = str(source.thread_id or source.chat_id or "").strip()
+        if not thread_id:
+            return False
+
+        try:
+            channel = client.get_channel(int(thread_id))
+            if channel is None:
+                channel = await client.fetch_channel(int(thread_id))
+            if channel is None or not hasattr(channel, "edit"):
+                return False
+
+            bot_id = str(getattr(getattr(client, "user", None), "id", "") or "")
+            owner_id = str(getattr(channel, "owner_id", "") or "")
+            if bot_id and owner_id and owner_id != bot_id:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=not_bot_owned owner=%s bot=%s",
+                    thread_id, session_id, owner_id, bot_id,
+                )
+                return False
+
+            created_at = getattr(channel, "created_at", None)
+            if created_at is None:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=missing_created_at",
+                    thread_id, session_id,
+                )
+                return False
+            try:
+                from datetime import datetime, timezone
+                if created_at.tzinfo is None:
+                    created_at = created_at.replace(tzinfo=timezone.utc)
+                age_seconds = (datetime.now(timezone.utc) - created_at).total_seconds()
+            except Exception:
+                logger.debug("Failed to evaluate Discord thread age before title rename", exc_info=True)
+                return False
+            if age_seconds > max_thread_age_seconds:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=not_new age_seconds=%.1f",
+                    thread_id, session_id, age_seconds,
+                )
+                return False
+
+            initial_titles = getattr(adapter, "_auto_thread_initial_titles", {}) or {}
+            expected_initial_raw = initial_titles.get(thread_id)
+            if not expected_initial_raw:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=no_provisional_title_record",
+                    thread_id, session_id,
+                )
+                return False
+            current_name = self._sanitize_discord_thread_title(getattr(channel, "name", "") or "")
+            expected_initial = self._sanitize_discord_thread_title(expected_initial_raw)
+            if current_name != expected_initial:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=non_initial_title current=%r expected_initial=%r",
+                    thread_id, session_id, current_name, expected_initial,
+                )
+                return False
+
+            return True
+        except Exception:
+            logger.debug("Failed to evaluate Discord auto-title rename safety", exc_info=True)
+            return False
+
+    async def _rename_discord_thread_for_session_title(
+        self,
+        source: SessionSource,
+        session_id: str,
+        title: str,
+    ) -> None:
+        """Best-effort one-time AI rename for a newly auto-created Discord thread."""
+        if not await self._discord_thread_safe_to_autorename(source, session_id=session_id):
+            return
+        adapter = self.adapters.get(source.platform) if getattr(self, "adapters", None) else None
+        client = getattr(adapter, "_client", None) if adapter is not None else None
+        if client is None:
+            return
+        thread_id = str(source.thread_id or source.chat_id or "").strip()
+        if not thread_id:
+            return
+        thread_name = self._append_discord_thread_author_suffix(title, source)
+        try:
+            channel = client.get_channel(int(thread_id))
+            if channel is None:
+                channel = await client.fetch_channel(int(thread_id))
+            if channel is None or not hasattr(channel, "edit"):
+                return
+            current_name = str(getattr(channel, "name", "") or "").strip()
+            if current_name == thread_name:
+                return
+            await channel.edit(name=thread_name, reason="MGS AI-generated session title")
+            logger.info(
+                "Discord thread renamed from auto-generated title: thread=%s session=%s name=%r previous=%r",
+                thread_id,
+                session_id,
+                thread_name,
+                current_name,
+            )
+            try:
+                initial_titles = getattr(adapter, "_auto_thread_initial_titles", None)
+                if initial_titles is not None:
+                    initial_titles.pop(thread_id, None)
+            except Exception:
+                logger.debug("Failed to clear Discord provisional title record", exc_info=True)
+        except Exception:
+            logger.debug("Failed to rename Discord thread for auto-generated title", exc_info=True)
+
+    def _schedule_discord_thread_title_rename(
+        self,
+        source: SessionSource,
+        session_id: str,
+        title: str,
+    ) -> None:
+        """Schedule a Discord thread rename from the auto-title background thread."""
+        if not title or not self._is_discord_thread_lane(source):
+            return
+        try:
+            loop = asyncio.get_running_loop()
+        except RuntimeError:
+            loop = getattr(self, "_gateway_loop", None)
+        if loop is None or loop.is_closed():
+            return
+        try:
+            copied_source = dataclasses.replace(source)
+        except Exception:
+            copied_source = source
+        future = safe_schedule_threadsafe(
+            self._rename_discord_thread_for_session_title(copied_source, session_id, title),
+            loop,
+            logger=logger,
+            log_message="Discord thread title rename failed to schedule",
+        )
+        if future is None:
+            return
+
+        def _log_rename_failure(fut) -> None:
+            try:
+                fut.result()
+            except Exception:
+                logger.debug("Discord thread title rename failed", exc_info=True)
+
+        future.add_done_callback(_log_rename_failure)
