new file mode 100644
index 0000000..e47c223
--- /dev/null
+++ b/gateway/reasoning_router.py
@@ -0,0 +1,171 @@
+"""Deterministic per-turn reasoning-effort routing for Hermes gateways.
+
+The router is intentionally local and side-effect free: it does not make an
+extra LLM call, mutate the session, or alter the prompt. Explicit /reasoning
+session overrides are handled by GatewayRunner before this function is used.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from typing import Any, Mapping
+
+from hermes_constants import parse_reasoning_effort
+
+_ALLOWED_EFFORTS = {"minimal", "low", "medium", "high", "xhigh"}
+
+_CRITICAL_MARKERS = (
+    # Incidents / availability
+    "fora do ar",
+    "site down",
+    "system down",
+    "outage",
+    "incidente",
+    "incident",
+    "indisponivel",
+    "unavailable",
+    "erro recorrente",
+    "recurrent error",
+    "root cause",
+    "causa raiz",
+    # Production-changing / security-sensitive work
+    "producao",
+    "production",
+    "deploy",
+    "rollback",
+    "reverter",
+    "migracao",
+    "migration",
+    "em massa",
+    "mass operation",
+    "todos os sites",
+    "all sites",
+    "deleta",
+    "delete",
+    "remover token",
+    "remove token",
+    "credencial",
+    "credential",
+    "senha",
+    "password",
+    "permissao",
+    "permission",
+    "billing",
+    "cobranca",
+    "pagamento",
+    # Deep investigation / exhaustive review
+    "investiga",
+    "investigate",
+    "auditoria",
+    "audit",
+    "revisa tudo",
+    "review everything",
+    "compara tudo",
+    "compare everything",
+    "debug",
+)
+
+_SIMPLE_EXACT = {
+    "oi",
+    "ola",
+    "hello",
+    "hi",
+    "bom dia",
+    "boa tarde",
+    "boa noite",
+    "obrigado",
+    "obrigada",
+    "thanks",
+    "thank you",
+    "ok",
+    "entendi",
+    "perfeito",
+}
+
+_SIMPLE_PREFIXES = (
+    "o que e ",
+    "quem e ",
+    "what is ",
+    "who is ",
+    "defina ",
+    "define ",
+    "traduza ",
+    "translate ",
+    "resuma esta frase",
+    "summarize this sentence",
+)
+
+
+def _normalize(text: str) -> str:
+    normalized = unicodedata.normalize("NFKD", text or "")
+    without_marks = "".join(ch for ch in normalized if not unicodedata.combining(ch))
+    return re.sub(r"\s+", " ", without_marks).strip().lower()
+
+
+def _effort_config(effort: Any, fallback: dict | None) -> dict | None:
+    value = str(effort or "").strip().lower()
+    if value not in _ALLOWED_EFFORTS:
+        return fallback
+    parsed = parse_reasoning_effort(value)
+    return parsed if parsed is not None else fallback
+
+
+def _safe_threshold(
+    settings: Mapping[str, Any],
+    key: str,
+    default: int,
+) -> int:
+    """Parse a positive threshold and fail closed to the safe default."""
+    value = settings.get(key, default)
+    if isinstance(value, bool):
+        return default
+    try:
+        parsed = int(value)
+    except (TypeError, ValueError, OverflowError):
+        return default
+    return parsed if parsed > 0 else default
+
+
+def route_reasoning_config(
+    message: str,
+    profile_default: dict | None,
+    settings: Mapping[str, Any] | None,
+) -> dict | None:
+    """Return Medium, High, or Extra High (``xhigh``) for one user turn.
+
+    Safety ordering matters: critical markers and large/code-heavy payloads are
+    evaluated before the short-message fast path, so a terse production command
+    is never downgraded merely because it is short.
+    """
+    settings = settings or {}
+    if settings.get("enabled") is not True:
+        return profile_default
+
+    raw = str(message or "").strip()
+    if not raw:
+        return profile_default
+
+    normalized = _normalize(raw)
+    simple_effort = settings.get("simple_effort", "medium")
+    default_effort = settings.get("default_effort", "high")
+    critical_effort = settings.get("critical_effort", "xhigh")
+
+    code_heavy = raw.count("\n") >= 20 or raw.count("```") >= 2
+    critical_char_threshold = _safe_threshold(
+        settings, "critical_char_threshold", 1200
+    )
+    long_payload = len(raw) >= critical_char_threshold
+    critical_marker = any(marker in normalized for marker in _CRITICAL_MARKERS)
+
+    if critical_marker or code_heavy or long_payload:
+        return _effort_config(critical_effort, profile_default)
+
+    simple_char_threshold = _safe_threshold(settings, "simple_char_threshold", 180)
+    if len(raw) <= simple_char_threshold and (
+        normalized in _SIMPLE_EXACT
+        or any(normalized.startswith(prefix) for prefix in _SIMPLE_PREFIXES)
+    ):
+        return _effort_config(simple_effort, profile_default)
+
+    return _effort_config(default_effort, profile_default)
diff --git a/tests/gateway/test_auto_reasoning_routing.py b/tests/gateway/test_auto_reasoning_routing.py
new file mode 100644
index 0000000..1c383da
--- /dev/null
+++ b/tests/gateway/test_auto_reasoning_routing.py
@@ -0,0 +1,199 @@
+from gateway.reasoning_router import route_reasoning_config
+
+
+SETTINGS = {
+    "enabled": True,
+    "simple_effort": "medium",
+    "default_effort": "high",
+    "critical_effort": "xhigh",
+}
+
+
+def test_disabled_router_preserves_profile_default():
+    assert route_reasoning_config(
+        "oi",
+        {"enabled": True, "effort": "high"},
+        {"enabled": False},
+    ) == {"enabled": True, "effort": "high"}
+
+
+def test_short_social_or_simple_question_uses_medium():
+    for message in ("oi", "obrigado", "o que é cache?", "traduza isso para inglês"):
+        assert route_reasoning_config(
+            message,
+            {"enabled": True, "effort": "high"},
+            SETTINGS,
+        ) == {"enabled": True, "effort": "medium"}
+
+
+def test_normal_operational_request_uses_high():
+    assert route_reasoning_config(
+        "confere o status da campanha e me passa um resumo",
+        {"enabled": True, "effort": "high"},
+        SETTINGS,
+    ) == {"enabled": True, "effort": "high"}
+
+
+def test_short_critical_request_is_never_downgraded():
+    for message in (
+        "o site está fora do ar",
+        "deleta esse token de produção",
+        "faz deploy em todos os sites",
+        "investiga esse erro recorrente",
+    ):
+        assert route_reasoning_config(
+            message,
+            {"enabled": True, "effort": "high"},
+            SETTINGS,
+        ) == {"enabled": True, "effort": "xhigh"}
+
+
+def test_long_or_code_heavy_request_uses_xhigh():
+    long_message = "analise estes logs:\n" + ("erro de timeout no worker\n" * 90)
+    code_message = "debug este código:\n```python\n" + ("print('x')\n" * 30) + "```"
+    for message in (long_message, code_message):
+        assert route_reasoning_config(
+            message,
+            {"enabled": True, "effort": "high"},
+            SETTINGS,
+        ) == {"enabled": True, "effort": "xhigh"}
+
+
+def test_empty_message_preserves_profile_default():
+    assert route_reasoning_config(
+        "",
+        {"enabled": True, "effort": "high"},
+        SETTINGS,
+    ) == {"enabled": True, "effort": "high"}
+
+
+def test_invalid_thresholds_fall_back_without_raising():
+    invalid = {
+        **SETTINGS,
+        "simple_char_threshold": "oops",
+        "critical_char_threshold": None,
+    }
+
+    assert route_reasoning_config(
+        "oi",
+        {"enabled": True, "effort": "high"},
+        invalid,
+    ) == {"enabled": True, "effort": "medium"}
+    assert route_reasoning_config(
+        "x" * 1300,
+        {"enabled": True, "effort": "high"},
+        invalid,
+    ) == {"enabled": True, "effort": "xhigh"}
+
+
+def test_gateway_turn_router_honors_explicit_session_override(monkeypatch):
+    from gateway.run import GatewayRunner
+
+    runner = object.__new__(GatewayRunner)
+    runner._session_reasoning_overrides = {
+        "session-1": {"enabled": True, "effort": "medium"}
+    }
+    monkeypatch.setattr(
+        runner,
+        "_load_reasoning_config",
+        lambda: {"enabled": True, "effort": "high"},
+    )
+    monkeypatch.setattr(
+        "gateway.run._load_gateway_runtime_config",
+        lambda: {"agent": {"reasoning_auto_routing": SETTINGS}},
+    )
+
+    result = runner._resolve_turn_reasoning_config(
+        "o site está fora do ar",
+        session_key="session-1",
+        model="gpt-5.6-sol",
+        provider="openai-codex",
+    )
+
+    assert result == {"enabled": True, "effort": "medium"}
+
+
+def test_gateway_turn_router_applies_auto_routing_without_override(monkeypatch):
+    from gateway.run import GatewayRunner
+
+    runner = object.__new__(GatewayRunner)
+    runner._session_reasoning_overrides = {}
+    monkeypatch.setattr(
+        runner,
+        "_load_reasoning_config",
+        lambda: {"enabled": True, "effort": "high"},
+    )
+    monkeypatch.setattr(
+        "gateway.run._load_gateway_runtime_config",
+        lambda: {"agent": {"reasoning_auto_routing": SETTINGS}},
+    )
+
+    result = runner._resolve_turn_reasoning_config(
+        "o site está fora do ar",
+        session_key="session-2",
+        model="gpt-5.6-sol",
+        provider="openai-codex",
+    )
+
+    assert result == {"enabled": True, "effort": "xhigh"}
+
+
+def test_gateway_router_is_clamped_to_gpt56_codex(monkeypatch):
+    from gateway.run import GatewayRunner
+
+    runner = object.__new__(GatewayRunner)
+    runner._session_reasoning_overrides = {}
+    monkeypatch.setattr(
+        runner,
+        "_load_reasoning_config",
+        lambda: {"enabled": True, "effort": "high"},
+    )
+    monkeypatch.setattr(
+        "gateway.run._load_gateway_runtime_config",
+        lambda: {"agent": {"reasoning_auto_routing": SETTINGS}},
+    )
+
+    for model, provider in (
+        ("gpt-5.5", "openai-codex"),
+        ("gpt-5.6-sol", "openrouter"),
+    ):
+        assert runner._resolve_turn_reasoning_config(
+            "o site está fora do ar",
+            session_key="session-3",
+            model=model,
+            provider=provider,
+        ) == {"enabled": True, "effort": "high"}
+
+
+def test_reasoning_effort_does_not_change_prompt_cache_key():
+    from agent.transports.codex import ResponsesApiTransport
+
+    transport = ResponsesApiTransport()
+    common = {
+        "model": "gpt-5.6-sol",
+        "messages": [{"role": "user", "content": "confere o status"}],
+        "tools": [
+            {
+                "type": "function",
+                "function": {
+                    "name": "status",
+                    "parameters": {"type": "object"},
+                },
+            }
+        ],
+        "instructions": "system prompt estável",
+        "session_id": "session-cache-test",
+        "is_codex_backend": True,
+    }
+    medium = transport.build_kwargs(
+        **common,
+        reasoning_config={"enabled": True, "effort": "medium"},
+    )
+    xhigh = transport.build_kwargs(
+        **common,
+        reasoning_config={"enabled": True, "effort": "xhigh"},
+    )
+
+    assert medium["prompt_cache_key"] == xhigh["prompt_cache_key"]
+    assert medium["reasoning"]["effort"] == "medium"
+    assert xhigh["reasoning"]["effort"] == "xhigh"
