diff --git a/tests/gateway/test_busy_session_ack.py b/tests/gateway/test_busy_session_ack.py
--- a/tests/gateway/test_busy_session_ack.py
+++ b/tests/gateway/test_busy_session_ack.py
@@ -921,6 +921,35 @@ class TestBusySessionAck:
 
         assert runner._running_agents[sk] is current_agent
 
+    def test_reentrant_followup_transfers_same_generation_rebuilt_agent(self):
+        """A recursive follow-up may own a rebuilt cache agent in the same generation."""
+        runner, _sentinel = _make_runner()
+        event = _make_event(text="follow-up after skill reload")
+        sk = build_session_key(event.source)
+        current_agent = MagicMock()
+        rebuilt_agent = MagicMock()
+        runner._running_agents[sk] = current_agent
+        runner._session_run_generation[sk] = 1
+
+        payload, events = runner._promote_agent_and_consume_startup_steers(
+            sk,
+            rebuilt_agent,
+            1,
+            allow_same_generation_replacement=True,
+        )
+
+        assert payload == ""
+        assert events == []
+        assert runner._running_agents[sk] is rebuilt_agent
+
+    def test_recursive_run_enables_same_generation_replacement(self):
+        """The production recursive path must opt into the guarded transfer."""
+        import inspect
+        from gateway.run import GatewayRunner
+
+        src = inspect.getsource(GatewayRunner._run_agent_inner)
+        assert "allow_same_generation_replacement=_interrupt_depth > 0" in src
+
     @pytest.mark.asyncio
     async def test_async_prepare_does_not_steer_into_replaced_agent(self):
         """A completed preprocessor must revalidate agent identity/generation."""
