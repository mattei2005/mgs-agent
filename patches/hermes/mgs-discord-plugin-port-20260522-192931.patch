+    async def _auto_add_parent_channel_members_to_thread(self, thread: Any, parent_channel: Any, author: Any = None) -> None:
+        """Add human members who can view the parent channel to a new auto-thread.
+
+        PATCH (MGS Digital Corp): Discord private threads are discoverable by
+        parent-channel members, but they are not automatically joined/subscribed.
+        For agent channels, add the humans who can view the parent channel so
+        new tasks are visible/notified instead of hidden behind the Threads UI.
+        """
+        guild = getattr(parent_channel, "guild", None)
+        if guild is None or thread is None:
+            return
+
+        client_user = getattr(getattr(self, "_client", None), "user", None)
+        bot_user_id = str(getattr(client_user, "id", "")) if client_user else None
+        target_members = []
+        seen: Set[int] = set()
+
+        async def consider(member: Any) -> None:
+            if member is None:
+                return
+            member_id = getattr(member, "id", None)
+            if member_id is None or member_id in seen:
+                return
+            seen.add(member_id)
+            user = getattr(member, "_user", None) or member
+            if getattr(user, "bot", False):
+                return
+            if bot_user_id and str(member_id) == bot_user_id:
+                return
+            try:
+                perms = parent_channel.permissions_for(member)
+            except Exception:
+                return
+            if getattr(perms, "view_channel", False):
+                target_members.append(member)
+
+        fetch_failed = None
+        try:
+            async for member in guild.fetch_members(limit=None):
+                await consider(member)
+        except Exception as exc:
+            fetch_failed = exc
+            for member in getattr(guild, "members", []) or []:
+                await consider(member)
+
+        added = []
+        failed = []
+        for member in target_members:
+            member_id = str(getattr(member, "id", ""))
+            try:
+                add_user = getattr(thread, "add_user", None)
+                if add_user is None:
+                    failed.append(f"{member_id}:thread.add_user unavailable")
+                    continue
+                await add_user(member)
+                added.append(member_id)
+            except Exception as exc:
+                # Already-member/no-op/permission errors should not block the agent response.
+                failed.append(f"{member_id}:{exc}")
+
+        logger.info(
+            "[%s] Auto-thread member sync: parent=%s thread=%s targets=%s added=%s failed=%s fetch_failed=%s",
+            self.name,
+            getattr(parent_channel, "id", None),
+            getattr(thread, "id", None),
+            [str(getattr(m, "id", "")) for m in target_members],
+            added,
+            failed,
+            fetch_failed,
+        )
+
