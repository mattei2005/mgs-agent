+    def _sanitize_auto_thread_llm_title(self, title: str) -> str:
+        """Clean an LLM-generated Discord thread title.
+
+        Keep this deliberately strict because the title is applied before the
+        agent response.  Bad outputs fall back to the deterministic gateway
+        classifier instead of producing noisy Discord thread names.
+        """
+        cleaned = re.sub(r"[\r\n]+", " ", str(title or ""))
+        cleaned = re.sub(r"^[\s\"'`*_~#-]*(title|título|titulo)\s*[:：-]\s*", "", cleaned, flags=re.IGNORECASE)
+        cleaned = cleaned.strip(" \t\n\r\"'`*_~:;,.!?—-–")
+        cleaned = re.sub(r"\s+", " ", cleaned)
+        if not cleaned:
+            return ""
+        # Reject obviously non-title outputs.
+        if len(cleaned.split()) > 8 or len(cleaned) > 90:
+            cleaned = " ".join(cleaned.split()[:6])[:80].rstrip(" \t\n\r:;,.!?—-–")
+        if not cleaned or cleaned.casefold() in {"assunto", "assunto da thread", "nova thread", "thread"}:
+            return ""
+        return cleaned[:80].rstrip(" \t\n\r:;,.!?—-–")
+
+    async def _llm_thread_name_from_message(self, content: str) -> str:
+        """Generate a ChatGPT-style title from the first user message before answering.
+
+        MGS requirement: a newly auto-created Discord thread should receive a
+        semantic title based on the first prompt immediately, not only after the
+        first assistant response.  This auxiliary call runs with a short timeout;
+        failures fall back to the deterministic gateway title.
+        """
+        if os.getenv("DISCORD_AUTO_THREAD_LLM_TITLE", "true").strip().lower() in {"0", "false", "no", "off"}:
+            return ""
+        snippet = (content or "").strip()
+        if not snippet:
+            return ""
+        timeout_raw = os.getenv("DISCORD_AUTO_THREAD_LLM_TITLE_TIMEOUT", "6").strip()
+        try:
+            timeout = max(1.0, min(12.0, float(timeout_raw)))
+        except ValueError:
+            timeout = 6.0
+
+        def _generate() -> str:
+            from agent.auxiliary_client import call_llm
+
+            messages = [
+                {
+                    "role": "system",
+                    "content": (
+                        "Generate a short Discord thread title from ONLY the user's first message. "
+                        "Capture the main intent/objective, not the literal first words. "
+                        "Use the user's language. Prefer 3-6 words. "
+                        "Avoid generic words like Dúvida, Ajuda, Pergunta, Problema, Conversa. "
+                        "Return ONLY the title text; no quotes, no punctuation, no prefix."
+                    ),
+                },
+                {"role": "user", "content": snippet[:1200]},
+            ]
+            response = call_llm(
+                task="title_generation",
+                messages=messages,
+                max_tokens=80,
+                temperature=0.2,
+                timeout=timeout,
+            )
+            return (response.choices[0].message.content or "").strip()
+
+        try:
+            generated = await asyncio.wait_for(asyncio.to_thread(_generate), timeout=timeout + 1.0)
+            return self._sanitize_auto_thread_llm_title(generated)
+        except Exception as exc:
+            logger.info("[%s] Immediate auto-thread LLM title unavailable, using deterministic fallback: %s", self.name, exc)
+            return ""
