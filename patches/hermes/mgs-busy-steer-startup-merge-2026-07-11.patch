+    def _stash_startup_steer(
+        self,
+        session_key: str,
+        payload: str,
+        event: MessageEvent,
+    ) -> bool:
+        """Hold an early follow-up for the active turn until AIAgent exists."""
+        if not session_key or not payload or not payload.strip():
+            return False
+        lock = getattr(self, "_pending_startup_steers_lock", None)
+        if lock is None:
+            lock = threading.Lock()
+            self._pending_startup_steers_lock = lock
+        with lock:
+            pending = getattr(self, "_pending_startup_steers", None)
+            if pending is None:
+                pending = {}
+                self._pending_startup_steers = pending
+            pending.setdefault(session_key, []).append((payload.strip(), event))
+        return True
+
+    def _consume_startup_steers(
+        self,
+        session_key: str,
+    ) -> tuple[str, List[MessageEvent]]:
+        """Atomically drain early follow-ups while preserving arrival order."""
+        lock = getattr(self, "_pending_startup_steers_lock", None)
+        pending = getattr(self, "_pending_startup_steers", None)
+        if lock is None or pending is None:
+            return "", []
+        with lock:
+            entries = pending.pop(session_key, [])
+        payload = "\n\n".join(text for text, _event in entries if text)
+        return payload, [event for _text, event in entries]
+
+    @staticmethod
+    def _merge_startup_steer_into_message(message: Any, payload: str) -> Any:
+        """Merge a pre-agent follow-up into the first user turn cache-safely."""
+        if not payload or not payload.strip():
+            return message
+        from agent.prompt_builder import format_steer_marker
+
+        marker = format_steer_marker(payload.strip())
+        if isinstance(message, str):
+            return message + marker
+        if isinstance(message, list):
+            merged = list(message)
+            merged.append({"type": "text", "text": marker})
+            return merged
+        return f"{message}{marker}"
 
