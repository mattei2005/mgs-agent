+                }
+            ],
+        },
+        _tool_msg(
+            "call_failed_stage",
+            {
+                "success": False,
+                "error_code": "capacity_overflow",
+                "target": "user",
+                "usage": "1,800/1,800",
+                "staged": False,
+            },
+        ),
+    ]
+
+    rendered = "\n".join(_summarize(review_messages, []))
