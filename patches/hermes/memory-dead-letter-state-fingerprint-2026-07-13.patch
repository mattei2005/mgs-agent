+def test_surfaces_capacity_dead_letter_without_rejected_content_even_when_off():
+    secret_payload = "SECRET REJECTED MEMORY CONTENT"
+    review_messages = [
+        {
+            "role": "assistant",
+            "tool_calls": [
+                {
+                    "id": "call_overflow",
+                    "function": {
+                        "name": "memory",
+                        "arguments": json.dumps(
+                            {
+                                "action": "add",
+                                "target": "memory",
+                                "content": secret_payload,
+                            }
+                        ),
+                    },
+                }
+            ],
+        },
+        _tool_msg(
+            "call_overflow",
+            {
+                "success": False,
+                "error_code": "capacity_overflow",
+                "failure_type": "capacity_overflow",
+                "target": "memory",
+                "usage": "3,180/3,200",
+                "staged": True,
+                "pending_id": "deadbeef1234",
+                "current_entries": [secret_payload],
+            },
+        ),
+    ]
+
+    for mode in ("on", "verbose", "off"):
+        actions = _summarize(review_messages, [], notification_mode=mode)
+        rendered = "\n".join(actions)
+        assert len(actions) == 1
+        assert "Memory capacity overflow preserved" in rendered
+        assert "3,180/3,200" in rendered
+        assert "deadbeef1234" in rendered
+        assert secret_payload not in rendered
+
+
