+    def test_concurrent_managers_serialize_same_project_store(
+        self, work_dir, checkpoint_base, monkeypatch, caplog,
+    ):
+        """Concurrent sessions must not race on the per-project git index."""
+        monkeypatch.setattr(
+            "tools.checkpoint_manager.CHECKPOINT_BASE", checkpoint_base,
+        )
+        barrier = threading.Barrier(4)
+
+        def snapshot(worker: int) -> bool:
+            manager = CheckpointManager(enabled=True)
+            barrier.wait(timeout=10)
+            return manager.ensure_checkpoint(
+                str(work_dir), f"concurrent worker {worker}",
+            )
+
+        with caplog.at_level(logging.ERROR, logger="tools.checkpoint_manager"):
+            with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
+                results = list(pool.map(snapshot, range(4)))
+
+        # The first worker records the tree; the other serialized workers see
+        # the same tree and correctly skip a duplicate checkpoint.
+        assert sum(results) == 1
+        manager = CheckpointManager(enabled=True)
+        assert len(manager.list_checkpoints(str(work_dir))) == 1
+        assert not any("index.lock" in record.getMessage() for record in caplog.records)
+
 
