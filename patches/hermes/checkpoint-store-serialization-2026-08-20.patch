+@contextmanager
+def _checkpoint_store_lock(base: Path) -> Iterator[None]:
+    """Serialize a complete checkpoint transaction across threads/processes.
+
+    Git's transient ``<index>.lock`` protects one command, but a checkpoint is
+    a multi-command transaction (read-tree → add → write-tree → update-ref →
+    optional prune/gc).  Without an outer lock, concurrent snapshots can race
+    on the same per-project index and store-wide gc can overlap another
+    project's git-add.  The implementation uses only the standard library so
+    checkpoint safety does not depend on an optional package being installed.
+    """
+    base.mkdir(parents=True, exist_ok=True)
+    lock_path = base / _STORE_LOCK_NAME
+    lock_file = lock_path.open("a+b")
+    deadline = time.monotonic() + _STORE_LOCK_TIMEOUT_SECONDS
+    acquired = False
+    try:
+        while not acquired:
+            try:
+                if os.name == "nt":
+                    import msvcrt
+
+                    lock_file.seek(0, os.SEEK_END)
+                    if lock_file.tell() == 0:
+                        lock_file.write(b"\0")
+                        lock_file.flush()
+                    lock_file.seek(0)
+                    msvcrt.locking(lock_file.fileno(), msvcrt.LK_NBLCK, 1)
+                else:
+                    import fcntl
+
+                    fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+                acquired = True
+            except (BlockingIOError, OSError) as exc:
+                if time.monotonic() >= deadline:
+                    raise TimeoutError(
+                        f"checkpoint store lock timed out after "
+                        f"{_STORE_LOCK_TIMEOUT_SECONDS}s: {lock_path}"
+                    ) from exc
+                time.sleep(0.05)
+
+        yield
+    finally:
+        if acquired:
+            try:
+                if os.name == "nt":
+                    import msvcrt
+
+                    lock_file.seek(0)
+                    msvcrt.locking(lock_file.fileno(), msvcrt.LK_UNLCK, 1)
+                else:
+                    import fcntl
+
+                    fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
+            except OSError:
+                pass
+        lock_file.close()
+
+
