+def _discord_thread_auto_add_user_ids(parent_channel_id: Any) -> Tuple[List[str], bool]:
+    """Resolve explicit auto-add users for a Discord parent channel.
+
+    The public config surface is ``discord.thread_auto_add_users_by_channel``;
+    startup bridges it to JSON in ``DISCORD_THREAD_AUTO_ADD_USERS_BY_CHANNEL``.
+    A channel-specific entry wins over the legacy profile-wide CSV.  An
+    explicitly configured empty list is meaningful and fails closed: it must
+    not fall back to broad guild-member discovery.
+    """
+    raw_by_channel = os.getenv("DISCORD_THREAD_AUTO_ADD_USERS_BY_CHANNEL")
+    if raw_by_channel is not None and raw_by_channel.strip():
+        try:
+            by_channel = json.loads(raw_by_channel)
+        except (TypeError, ValueError) as exc:
+            logger.warning("Invalid Discord per-channel thread auto-add config: %s", exc)
+            return [], True
+        if not isinstance(by_channel, dict):
+            logger.warning("Invalid Discord per-channel thread auto-add config: expected object")
+            return [], True
+
+        channel_key = str(parent_channel_id or "").strip()
+        if channel_key in by_channel:
+            configured = by_channel[channel_key]
+            if configured is None:
+                values: List[Any] = []
+            elif isinstance(configured, str):
+                values = configured.split(",")
+            elif isinstance(configured, (list, tuple, set)):
+                values = list(configured)
+            else:
+                logger.warning(
+                    "Invalid Discord per-channel thread auto-add entry for parent=%s",
+                    channel_key,
+                )
+                return [], True
+            resolved: List[str] = []
+            seen: Set[str] = set()
+            for value in values:
+                user_id = str(value).strip()
+                if user_id and user_id not in seen:
+                    seen.add(user_id)
+                    resolved.append(user_id)
+            return resolved, True
+
+    global_configured = "DISCORD_THREAD_AUTO_ADD_USERS" in os.environ
+    resolved = []
+    seen: Set[str] = set()
+    for value in os.getenv("DISCORD_THREAD_AUTO_ADD_USERS", "").split(","):
+        user_id = value.strip()
+        if user_id and user_id not in seen:
+            seen.add(user_id)
+            resolved.append(user_id)
+    return resolved, global_configured
 
 
