+    def _auto_thread_name_from_message(self, content: str) -> str:
+        """Return a deterministic, cleaned Discord auto-thread title.
+
+        PATCH (MGS Digital Corp): agent channels use rename-on-create only.
+        Keep this conservative: prefer object + action/context, avoid generic
+        category guesses, and fall back to a cleaned first-message summary when
+        confidence is low.
+        """
+        text = content or ""
+        text = re.sub(r"<@[!&]?\d+>", "", text)
+        text = re.sub(r"<#\d+>", "", text)
+        text = re.sub(r"https?://\S+", "", text)
+        text = re.sub(r"[`*_~>|]+", " ", text)
+        text = re.sub(r"\s+", " ", text).strip(" \t\n\r:;,.!?—-–")
+        text = re.sub(r"^(zeus|atena|ares|hermes)\b[\s,.:;!?—-]*", "", text, flags=re.IGNORECASE).strip()
+
+        lowered = text.casefold()
+
+        def cap_words(value: str, max_words: int = 8) -> str:
+            value = re.sub(r"\s+", " ", value).strip(" \t\n\r:;,.!?—-–")
+            words = value.split()
+            if len(words) > max_words:
+                value = " ".join(words[:max_words])
+            value = value[:77].rstrip(" \t\n\r:;,.!?—-–")
+            return (value[:1].upper() + value[1:]) if value else "Hermes"
+
+        # Explicit operational subjects. These are narrow by design: avoid broad
+        # catches like "erro" -> "Diagnóstico de erro", which produced vague titles.
+        agent_match = re.search(r"\b(zeus|atena|ares)\b", lowered)
+        agent = agent_match.group(1).capitalize() if agent_match else ""
+        if agent and any(word in lowered for word in ("status", "funcion", "saude", "saúde", "hoje", "online")):
+            return f"{agent} status operacional"[:80]
+        if agent and any(word in lowered for word in ("erro", "falha", "bug", "trav", "diagnost")):
+            return f"{agent} diagnóstico de erro"[:80]
+
+        if "krea" in lowered and any(word in lowered for word in ("pago", "custo", "billing", "servico", "serviço")):
+            return "Krea2 custo e billing"
+        if "precisamos conversar" in lowered and any(word in lowered for word in ("comportamento", "comportamentos", "errado", "errados")):
+            return "Revisão comportamento dos agentes"
+        if "padroniz" in lowered and any(word in lowered for word in ("atena", "zeus", "ares", "agente", "agentes", "thread", "threads")):
+            return "Padronização comportamento dos agentes"[:80]
+        if "thread" in lowered and any(word in lowered for word in ("renome", "rename", "titulo", "título", "nome")):
+            return "Regras de rename de threads"
+        if "thread" in lowered and "auto" in lowered and "add" in lowered:
+            return "Auto-add em threads Discord"
+        if "tracking" in lowered and "custo" in lowered:
+            return "Tracking de custo" if not agent else f"{agent} tracking de custo"
+        if "autoriz" in lowered or "aprova" in lowered or "libera" in lowered or "nega" in lowered:
+            return "Autorização de acesso"
+
+        site_match = re.search(r"\b(eggbev|nice-homes|jewelsblast|financesmint|financeway|financesall)\b", lowered)
+        vertical_match = re.search(r"\b([a-z]{2}-[a-z0-9]+-[a-z]{2})\b", lowered)
+        site_label = site_match.group(1).replace("-", " ").title().replace(" ", "") if site_match else ""
+        vertical_label = vertical_match.group(1).upper() if vertical_match else ""
+
+        article_type = ""
+        if "rec+p1" in lowered:
+            article_type = "REC+P1"
+        elif re.search(r"\bp1\b", lowered):
+            article_type = "P1"
+        elif re.search(r"\brec\b", lowered):
+            article_type = "REC"
+
+        if article_type and any(word in lowered for word in ("crie", "criar", "faca", "faça", "fazer", "novo", "mais um")):
+            product = ""
+            product_match = re.search(
+                r"\b(?:do|da|de)\s+([^\n]+?)(?:\s+url\b|\s+status\b|\s+imagem\b|$)",
+                text,
+                flags=re.IGNORECASE,
+            )
+            if product_match:
+                product = product_match.group(1)
+                product = re.sub(r"\s+(?:no|na|em)\s+(?:eggbev|nice-homes|jewelsblast|financesmint|financeway|financesall)\b.*$", "", product, flags=re.IGNORECASE)
+                product = re.sub(r"\b[a-z]{2}-[a-z0-9]+-[a-z]{2}\b", "", product, flags=re.IGNORECASE)
+                product = re.sub(r"\s+", " ", product).strip(" .,:;!?—-–")
+            suffix = " ".join(part for part in (site_label, vertical_label) if part)
+            if product and suffix:
+                return f"{article_type} {product} - {suffix}"[:80]
+            if product:
+                return f"{article_type} {product}"[:80]
+            if suffix:
+                return f"Novo {article_type} - {suffix}"[:80]
+            return f"Novo {article_type}"[:80]
+
+        if any(word in lowered for word in ("liste", "lista", "listar")) and "artigo" in lowered:
+            suffix = " ".join(part for part in (site_label, vertical_label) if part)
+            return (f"Lista de artigos {suffix}" if suffix else "Lista de artigos")[:80]
+
+        if any(word in lowered for word in ("correcao", "correcoes", "correção", "correções")):
+            if "rec+p1" in lowered or ("rec" in lowered and "p1" in lowered):
+                return "Correções REC+P1"
+            return "Correções de artigos"
+
+        # Conservative fallback: remove prompt filler, preserve the actual subject.
+        compact = text
+        fallback_patterns = [
+            r"^(?:por favor|pf|pode|voce pode|você pode|me diz|me fala)\s+",
+            r"^(?:verifique|verifica|confira|cheque|veja)\s+(?:de novo\s+)?(?:como\s+(?:esta|está)\s+)?",
+            r"^(?:qual\s+(?:o|a|é o|é a)|quais|como)\s+",
+            r"^(?:estou|eu estou|to|tô)\s+",
+        ]
+        for pattern in fallback_patterns:
+            new_compact = re.sub(pattern, "", compact, flags=re.IGNORECASE).strip(" \t\n\r:;,.!?—-–")
+            if new_compact != compact:
+                compact = new_compact
+                break
+        return cap_words(compact)
+
