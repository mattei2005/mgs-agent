+    def _auto_thread_name_from_message(self, content: str) -> str:
+        """Return a deterministic, cleaned Discord auto-thread title.
+
+        PATCH (MGS Digital Corp): agent channels need rename-on-create without
+        relying on a later LLM/tool step. This strips bot mentions/names and
+        common filler, then applies a few operational topic heuristics before
+        falling back to a compact title-cased summary of the first words.
+        """
+        text = content or ""
+        text = re.sub(r"<@[!&]?\d+>", "", text)
+        text = re.sub(r"<#\d+>", "", text)
+        text = re.sub(r"https?://\S+", "", text)
+        text = re.sub(r"[`*_~>|]+", " ", text)
+        text = re.sub(r"\s+", " ", text).strip(" \t\n\r:;,.!?—-–")
+        text = re.sub(r"^(zeus|atena|ares|hermes)\b[\s,.:;!?—-]*", "", text, flags=re.IGNORECASE).strip()
+
+        lowered = text.casefold()
+
+        # MGS agent-channel heuristics: when the first message is phrased as a
+        # request, the raw first words make the thread look "not renamed". Keep
+        # deterministic rename-on-create, but produce an operational title.
+        site_match = re.search(r"\b(eggbev|nice-homes|jewelsblast|financesmint|financeway|financesall)\b", lowered)
+        vertical_match = re.search(r"\b([a-z]{2}-[a-z0-9]+-[a-z]{2})\b", lowered)
+        site_label = site_match.group(1).replace("-", " ").title().replace(" ", "") if site_match else ""
+        vertical_label = vertical_match.group(1).upper() if vertical_match else ""
+
+        article_type = ""
+        if "rec+p1" in lowered:
+            article_type = "REC+P1"
+        elif re.search(r"\bp1\b", lowered):
+            article_type = "P1"
+        elif re.search(r"\brec\b", lowered):
+            article_type = "REC"
+        if article_type and site_label and vertical_label and any(word in lowered for word in ("crie", "criar", "faca", "faça", "fazer")):
+            product_match = re.search(
+                r"\b(?:do|da|de)\s+([^\n]+?)(?:\s+url\b|\s+status\b|\s+imagem\b|$)",
+                text,
+                flags=re.IGNORECASE,
+            )
+            product = product_match.group(1).strip(" .,:;!?—-–") if product_match else ""
+            product = re.sub(r"\s+", " ", product)
+            if product:
+                return f"{article_type} {product} - {site_label} {vertical_label}"[:80]
+
+        if any(word in lowered for word in ("liste", "lista", "listar")) and "artigo" in lowered:
+            suffix = " ".join(part for part in (site_label, vertical_label) if part)
+            return (f"Lista Artigos {suffix}" if suffix else "Lista de Artigos")[:80]
+
+        if any(word in lowered for word in ("correcao", "correcoes", "correção", "correções")):
+            if "rec+p1" in lowered or ("rec" in lowered and "p1" in lowered):
+                return "Correções recentes REC+P1"
+            return "Correções recentes de artigos"
+
+        if "rec+p1" in lowered and any(word in lowered for word in ("pedir", "fazer", "criar", "novo", "mais um")):
+            return "Preparação novo REC+P1"
+
+        heuristics = [
+            (("thread", "renome"), "Correção rename de threads"),
+            (("thread", "rename"), "Correção rename de threads"),
+            (("auto", "add", "thread"), "Correção auto-add em threads"),
+            (("diagnost", "atena"), "Diagnóstico Atena"),
+            (("diagnost", "zeus"), "Diagnóstico Zeus"),
+            (("status", "tracking"), "Status tracking de custo"),
+            (("custo", "tracking"), "Tracking de custo"),
+            (("autoriz",), "Autorização de acesso"),
+            (("aprova",), "Aprovação de acesso"),
+            (("nega",), "Negativa de acesso"),
+            (("erro",), "Diagnóstico de erro"),
+            (("falha",), "Diagnóstico de falha"),
+        ]
+        for needles, title in heuristics:
+            if all(needle in lowered for needle in needles):
+                return title[:80]
+
+        stop_prefixes = (
+            "por favor", "pf", "pode", "voce pode", "você pode", "me diz", "me fala",
+            "qual o", "qual é o", "qual a", "qual é a", "quais", "como", "porque", "por que",
+            "estou", "eu estou", "to", "tô",
+        )
+        compact = text
+        compact_lower = compact.casefold()
+        for prefix in stop_prefixes:
+            if compact_lower.startswith(prefix + " "):
+                compact = compact[len(prefix):].strip(" \t\n\r:;,.!?—-–")
+                break
+
+        words = compact.split()
+        if len(words) > 8:
+            compact = " ".join(words[:8])
+        compact = compact[:77].rstrip(" \t\n\r:;,.!?—-–")
+        if not compact:
+            compact = "Hermes"
+        if len(text) > len(compact):
+            compact = compact.rstrip(".")
+        return compact[:1].upper() + compact[1:]
+
