+    def test_reentrant_followup_promotion_reuses_current_agent(self):
+        """An in-band queued follow-up must not re-promote an already-owned agent."""
+        runner, _sentinel = _make_runner()
+        event = _make_event(text="follow-up")
+        sk = build_session_key(event.source)
+        agent = MagicMock()
+        runner._running_agents[sk] = agent
+        runner._session_run_generation[sk] = 1
+
+        payload, events = runner._promote_agent_and_consume_startup_steers(
+            sk,
+            agent,
+            1,
+        )
+
+        assert payload == ""
+        assert events == []
+        assert runner._running_agents[sk] is agent
+
+    def test_reentrant_followup_does_not_mask_replaced_agent(self):
+        """Only the exact current agent may bypass startup promotion."""
+        runner, _sentinel = _make_runner()
+        event = _make_event(text="follow-up")
+        sk = build_session_key(event.source)
+        current_agent = MagicMock()
+        replacement_agent = MagicMock()
+        runner._running_agents[sk] = current_agent
+        runner._session_run_generation[sk] = 1
+
+        with pytest.raises(RuntimeError, match="lost ownership"):
+            runner._promote_agent_and_consume_startup_steers(
+                sk,
+                replacement_agent,
+                1,
+            )
+
+        assert runner._running_agents[sk] is current_agent
+
