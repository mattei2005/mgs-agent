+
+        # PATCH (MGS Digital Corp): allow explicit per-profile thread members.
+        # Discord guild.fetch_members requires the privileged Members Intent;
+        # MGS bots may not have it. For private agent channels, configure a
+        # deterministic CSV allowlist via DISCORD_THREAD_AUTO_ADD_USERS.
+        explicit_user_ids = [
