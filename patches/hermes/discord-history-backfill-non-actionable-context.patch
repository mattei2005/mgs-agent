+                return
+            seen.add(member_id)
+            user = getattr(member, "_user", None) or member
+            if getattr(user, "bot", False):
+                return
+            if bot_user_id and str(member_id) == bot_user_id:
+                return
+            try:
+                perms = parent_channel.permissions_for(member)
+            except Exception:
+                return
+            if getattr(perms, "view_channel", False):
+                target_members.append(member)
+
+        fetch_failed = None
+        if explicit_user_ids:
+            get_member = getattr(guild, "get_member", None)
+            fetch_member = getattr(guild, "fetch_member", None)
