+@pytest.mark.asyncio
+async def test_planned_restart_keeps_resume_pending_after_graceful_drain():
+    """MGS patch: planned restarts should auto-resume without user nudge.
+
+    Even if the active turn drains cleanly, Discord can miss the final send
+    during disconnect. Keeping resume_pending lets startup synthesize the next
+    turn in the same thread instead of waiting for the human to type "retoma".
+    """
+    runner, adapter = make_restart_runner()
+    adapter.disconnect = AsyncMock()
+
+    running_agent = MagicMock()
+    runner._running_agents = {"session": running_agent}
+
+    async def finish_agent():
+        await asyncio.sleep(0.05)
+        runner._running_agents.clear()
+
+    asyncio.create_task(finish_agent())
+
+    with patch("gateway.status.remove_pid_file"), patch("gateway.status.write_runtime_status"):
+        await runner.stop(restart=True)
+
+    runner.session_store.mark_resume_pending.assert_called_with(
+        "session", "restart_timeout"
+    )
+    runner.session_store.clear_resume_pending.assert_not_called()
+    running_agent.interrupt.assert_not_called()
+    disconnect_mock = adapter.disconnect
+    disconnect_mock.assert_awaited_once()
+
+
 @pytest.mark.asyncio
 async def test_gateway_stop_interrupts_after_drain_timeout():
     runner, adapter = make_restart_runner()
