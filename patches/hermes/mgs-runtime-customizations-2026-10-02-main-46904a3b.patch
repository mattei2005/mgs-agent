+"""Auto-threading must preserve the human's Discord message as thread starter."""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+
+class RateLimitedForTest(RuntimeError):
+    def __init__(self, retry_after: float):
+        self.retry_after = retry_after
+        super().__init__(f"Too many requests. Retry in {retry_after:.2f} seconds.")
+
+from gateway.config import PlatformConfig
+from plugins.platforms.discord.adapter import DiscordAdapter
+
+
+def _adapter(*, existing_thread=None):
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, token="fake-token"))
+    adapter._client = SimpleNamespace(
+        user=SimpleNamespace(id=999),
+        get_channel=MagicMock(return_value=existing_thread),
+        fetch_channel=AsyncMock(
+            return_value=existing_thread,
+            side_effect=None if existing_thread is not None else LookupError("not found"),
+        ),
+    )
+    return adapter
+
+
+def _message(create_thread):
+    channel = SimpleNamespace(
+        id=1516887105543077949,
+        send=AsyncMock(side_effect=AssertionError("must not create an Ares seed message")),
+    )
+    return SimpleNamespace(
+        id=123456789,
+        content="País: BRASIL\nVertical: CAR\nLíngua: PORTUGUÊS",
+        author=SimpleNamespace(id=42, display_name="Nicolas Holanda"),
+        channel=channel,
+        create_thread=create_thread,
+    )
+
+
+@pytest.mark.asyncio
+async def test_auto_thread_retries_original_message_before_giving_up(monkeypatch):
+    """A transient failure must retry message.create_thread, never seed as Ares."""
+    adapter = _adapter()
+    thread = SimpleNamespace(id=123456789, name="CAR Brasil - Nicolas")
+    create_thread = AsyncMock(side_effect=[RuntimeError("transient"), thread])
+    message = _message(create_thread)
+    monkeypatch.setattr("plugins.platforms.discord.adapter.asyncio.sleep", AsyncMock())
+
+    result = await adapter._auto_create_thread(message)
+
+    assert result is thread
+    assert create_thread.await_count == 2
+    message.channel.send.assert_not_awaited()
+
+
+@pytest.mark.asyncio
