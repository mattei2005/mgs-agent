@@ -0,0 +1,271 @@
+from types import SimpleNamespace
+
+from gateway.reasoning_router import route_mgs_finance_model, route_reasoning_config
+
+
+SETTINGS = {
+    "enabled": True,
+    "simple_effort": "medium",
+    "default_effort": "high",
+    "critical_effort": "xhigh",
+}
+
+
+def test_finance_thread_is_always_routed_to_astra():
+    source = SimpleNamespace(
+        thread_id="1545426987756298340",
+        chat_id="1545426987756298340",
+        chat_name="qualquer título",
+    )
+    assert route_mgs_finance_model("assunto genérico", source=source) == {
+        "model": "gpt-6-astra-900k",
+        "provider": "openai-codex",
+    }
+
+
+def test_finance_topic_routes_new_thread_but_unrelated_work_stays_default():
+    generic = SimpleNamespace(thread_id="new", chat_id="new", chat_name="Projeto novo")
+    assert route_mgs_finance_model(
+        "vamos revisar a dashboard financeira da MGS", source=generic,
+    ) == {"model": "gpt-6-astra-900k", "provider": "openai-codex"}
+    assert route_mgs_finance_model("confere o WordPress", source=generic) is None
+
+
+def test_gateway_finance_policy_overrides_existing_session_model(monkeypatch):
+    from gateway.run import GatewayRunner
+
+    runner = object.__new__(GatewayRunner)
+    source = SimpleNamespace(
+        thread_id="1545426987756298340",
+        chat_id="1545426987756298340",
+        chat_name="Dashboard",
+        parent_chat_id="1496267442899521627",
+        platform="discord",
+    )
+    conversation = SimpleNamespace(
+        model_override={"model": "gpt-5.6-sol", "provider": "openai-codex"},
+        last_resolved_model="",
+    )
+    state = SimpleNamespace(conversation=conversation)
+    runner.config = None
+    runner._resolve_session_key_or_none = lambda *_args, **_kwargs: "finance-session"
+    runner._rehydrate_session_model_override = lambda _key: None
+    runner._peek_session_state = lambda _key: state
+    runner._session_state = lambda _key: state
+    runner._apply_session_model_override = lambda *_args, **_kwargs: (_ for _ in ()).throw(
+        AssertionError("finance policy must outrank a stale session override")
+    )
+    monkeypatch.setattr("gateway.run._resolve_gateway_model", lambda _cfg=None: "gpt-5.6-sol")
+    monkeypatch.setattr(
+        "gateway.run._resolve_runtime_agent_kwargs",
+        lambda: {"provider": "openai-codex", "api_key": "test", "model": "gpt-5.6-sol"},
+    )
+    monkeypatch.setattr(
+        "gateway.run._resolve_runtime_agent_kwargs_for_provider",
+        lambda provider, target_model=None: {
+            "provider": provider,
+            "api_key": "test",
+            "api_mode": "codex_responses",
+            "model": target_model,
+        },
+    )
+
+    model, runtime = runner._resolve_session_agent_runtime(
+        source=source,
+        user_config={},
+        user_message="confere o fechamento",
+    )
+
+    assert model == "gpt-6-astra-900k"
+    assert runtime["provider"] == "openai-codex"
+    assert "model" not in runtime
+
+
+def test_disabled_router_preserves_profile_default():
+    assert route_reasoning_config(
+        "oi",
+        {"enabled": True, "effort": "high"},
+        {"enabled": False},
+    ) == {"enabled": True, "effort": "high"}
+
+
+def test_short_social_or_simple_question_uses_medium():
+    for message in ("oi", "obrigado", "o que é cache?", "traduza isso para inglês"):
+        assert route_reasoning_config(
+            message,
+            {"enabled": True, "effort": "high"},
+            SETTINGS,
+        ) == {"enabled": True, "effort": "medium"}
+
+
+def test_normal_operational_request_uses_high():
+    assert route_reasoning_config(
+        "confere o status da campanha e me passa um resumo",
+        {"enabled": True, "effort": "high"},
+        SETTINGS,
+    ) == {"enabled": True, "effort": "high"}
+
+
+def test_short_critical_request_is_never_downgraded():
+    for message in (
+        "o site está fora do ar",
+        "deleta esse token de produção",
+        "faz deploy em todos os sites",
+        "investiga esse erro recorrente",
+    ):
+        assert route_reasoning_config(
+            message,
+            {"enabled": True, "effort": "high"},
+            SETTINGS,
+        ) == {"enabled": True, "effort": "xhigh"}
+
+
+def test_long_or_code_heavy_request_uses_xhigh():
+    long_message = "analise estes logs:\n" + ("erro de timeout no worker\n" * 90)
