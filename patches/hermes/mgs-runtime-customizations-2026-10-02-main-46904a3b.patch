+                if callable(get_channel):
+                    with suppress(Exception):
+                        thread = get_channel(thread_id)
+                        if thread is not None:
+                            return thread
+
+                fetch_channel = getattr(client, "fetch_channel", None)
+                if callable(fetch_channel):
+                    with suppress(Exception):
+                        thread = await fetch_channel(thread_id)
+                        if thread is not None:
+                            return thread
+                return None
+
+            last_direct_error: Exception | None = None
+            attempt = 0
+            generic_retry_used = False
+            rate_limit_retry_used = False
+            parent_channel_id = int(getattr(getattr(message, "channel", None), "id", 0) or 0)
