@@ -0,0 +1,154 @@
+"""Tests for metadata-only structural write receipts."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from unittest.mock import patch
+
+
+def test_receipt_is_idempotent_atomic_and_metadata_only(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    from tools.write_trace import emit_structural_write_receipt
+
+    before = {"/tmp/demo/SKILL.md": "a" * 64}
+    after = {"/tmp/demo/SKILL.md": "b" * 64}
+    first = emit_structural_write_receipt(
+        subsystem="skills",
+        action="patch",
+        target="demo",
+        origin="background_review",
+        before=before,
+        after=after,
+    )
+    second = emit_structural_write_receipt(
+        subsystem="skills",
+        action="patch",
+        target="demo",
+        origin="background_review",
+        before=before,
+        after=after,
+    )
+
+    assert first["persisted"] is True
+    assert second["persisted"] is True
+    assert second["deduplicated"] is True
+    assert first["id"] == second["id"]
+
+    directory = home / "pending" / "trace"
+    path = directory / f"{first['id']}.json"
+    record = json.loads(path.read_text())
+    encoded = json.dumps(record)
+    assert record["status"] == "pending"
+    assert record["before"] == before
+    assert record["after"] == after
+    assert "old_string" not in encoded
+    assert "new_string" not in encoded
+    assert os.stat(directory).st_mode & 0o777 == 0o700
+    assert os.stat(path).st_mode & 0o777 == 0o600
+
+
+def test_unchanged_snapshot_does_not_emit_receipt(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    from tools.write_trace import emit_structural_write_receipt
+
+    snapshot = {"/tmp/demo/SKILL.md": "a" * 64}
+    result = emit_structural_write_receipt(
+        subsystem="skills",
+        action="patch",
+        target="demo",
+        origin="background_review",
+        before=snapshot,
+        after=snapshot,
+    )
+
+    assert result == {"persisted": False, "reason": "unchanged"}
+    assert not (home / "pending" / "trace").exists()
+
+
+def test_receipt_persistence_failure_is_truthful(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    from tools import write_trace
+
+    monkeypatch.setattr(write_trace.tempfile, "mkstemp", lambda **kwargs: (_ for _ in ()).throw(OSError("full")))
+    result = write_trace.emit_structural_write_receipt(
+        subsystem="skills",
+        action="patch",
+        target="demo",
+        origin="background_review",
+        before={"/tmp/demo/SKILL.md": "a" * 64},
+        after={"/tmp/demo/SKILL.md": "b" * 64},
+    )
+
+    assert result["persisted"] is False
+    assert "OSError" in result["persistence_error"]
+    assert "id" in result
+
+
+def test_background_skill_patch_emits_structural_receipt(tmp_path, monkeypatch):
+    import importlib
+
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    import tools.skill_manager_tool as skill_manager
+    from tools.skill_manager_guards import mark_background_review_skill_read
+    from tools.skill_provenance import (
+        reset_current_write_origin,
+        set_current_write_origin,
+    )
+
+    skill_manager = importlib.reload(skill_manager)
+    content = (
+        "---\nname: trace-demo\ndescription: Receipt test\n---\n"
+        "# Demo\nold body\n"
+    )
+    created = json.loads(skill_manager.skill_manage("create", "trace-demo", content=content))
+    assert created["success"] is True
+    skill = skill_manager._find_skill("trace-demo")
+    skill_path = Path(skill["path"]) / "SKILL.md"
+
+    token = set_current_write_origin("background_review")
+    try:
+        mark_background_review_skill_read(skill_path)
+        # Upstream #67140 requires positive curator ownership before a
+        # background-review fork may mutate a skill. Keep that fail-closed
+        # policy active while isolating this test to the structural receipt.
+        with patch(
+            "tools.skill_usage.load_usage",
+            return_value={"trace-demo": {"created_by": "agent", "use_count": 1}},
+        ), patch(
+            "tools.skill_usage.get_record",
+            return_value={"created_by": "agent", "use_count": 1, "pinned": False},
+        ):
+            patched = json.loads(
+                skill_manager.skill_manage(
+                    "patch",
+                    "trace-demo",
+                    old_string="old body",
+                    new_string="new body",
+                )
+            )
+    finally:
+        reset_current_write_origin(token)
+
+    assert patched["success"] is True
+    assert patched["trace_receipt"]["persisted"] is True
+    receipt_path = home / "pending" / "trace" / f"{patched['trace_receipt']['id']}.json"
+    receipt = json.loads(receipt_path.read_text())
+    assert receipt["origin"] == "background_review"
+    assert receipt["target"] == "trace-demo"
+    assert list(receipt["before"]) == [str(skill_path)]
+    assert list(receipt["after"]) == [str(skill_path)]
+    assert receipt["before"][str(skill_path)] != receipt["after"][str(skill_path)]
