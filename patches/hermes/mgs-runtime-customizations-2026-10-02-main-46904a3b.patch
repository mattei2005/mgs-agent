+    async def _auto_create_thread(self, message: 'DiscordMessage') -> Optional[Any]:
+            """Create a thread whose starter is always the human's source message.
+
+            A bot-authored seed fallback hides the user's text and attachments from
+            the resulting thread.  Retry ``message.create_thread`` directly and,
+            after each error, reconcile the thread ID derived from the source
+            message.  Discord uses the starter message snowflake as the thread ID,
+            so this also recovers cleanly when the create request succeeded but the
+            client lost the response.  Discord ``RateLimited`` errors carry the
+            route's real ``retry_after``; wait for that window once instead of
+            treating a multi-minute bucket as a permanent routing failure.
+            Persistent failures return ``None`` and the caller reports the routing
+            error in the parent channel (#20243).
+            """
+            content = (message.content or "").strip()
+            base_thread_name = self._auto_thread_name_from_message(content)
+            thread_name = self._append_thread_author_suffix(
+                base_thread_name,
+                getattr(getattr(message, "author", None), "display_name", None),
+            )
+
+            async def resolve_source_thread() -> Optional[Any]:
+                message_id = getattr(message, "id", None)
+                try:
