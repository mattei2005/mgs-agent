+"""Real process leases, cancellation and managed-browser integration (no remote writes)."""
+import asyncio
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+from unittest.mock import MagicMock
+
+import pytest
+
+MODULE = Path('/root/mgs-agent/scripts/mgs_browser_budget.py')
+spec = importlib.util.spec_from_file_location('test_mgs_budget', MODULE)
+budget = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(budget)
+
+
+@pytest.fixture
+def config(tmp_path):
+    path = tmp_path / 'config.json'
+    path.write_text(json.dumps({'schema_version': 1, 'slots': 3, 'local_workers': 1,
+        'wait_timeout_seconds': 3, 'poll_seconds': 0.01, 'lock_dir': str(tmp_path / 'locks')}))
+    return path
+
+
+@pytest.mark.parametrize('key,value', [('slots', 0), ('slots', True), ('slots', 100),
+    ('local_workers', 0), ('wait_timeout_seconds', float('nan')), ('poll_seconds', 0),
+    ('schema_version', 2), ('lock_dir', 'relative')])
+def test_invalid_config_fails_closed(config, key, value):
+    data = json.loads(config.read_text()); data[key] = value; config.write_text(json.dumps(data))
+    with pytest.raises(RuntimeError): budget.Lease(config)
+
+
+def test_slots_and_exception_release(config):
+    leases = [budget.Lease(config, timeout=0) for _ in range(3)]
+    try:
+        for lease in leases: lease.acquire()
+        with pytest.raises(TimeoutError): budget.Lease(config, timeout=0).acquire()
+    finally:
+        for lease in leases: lease.release()
+    with pytest.raises(ValueError):
+        with budget.browser_lease(config): raise ValueError('synthetic failure')
+    with budget.browser_lease(config, timeout=0) as lease: assert lease.fd is not None
+
+
+def test_batch_preserves_one_interactive_slot(config):
+    leases = [budget.Lease(config, timeout=0, batch=True) for _ in range(2)]
+    try:
+        for lease in leases: lease.acquire()
+        with pytest.raises(TimeoutError): budget.Lease(config, timeout=0, batch=True).acquire()
+        with budget.browser_lease(config, timeout=0): pass
+    finally:
+        for lease in leases: lease.release()
+
+
+def test_process_union_never_exceeds_three(config, tmp_path):
+    events = tmp_path / 'events.jsonl'
+    code = '''import importlib.util,sys,time,json,os
+s=importlib.util.spec_from_file_location('budget',sys.argv[1]);m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
+with m.browser_lease(sys.argv[2]):
+ f=os.open(sys.argv[3],os.O_CREAT|os.O_WRONLY|os.O_APPEND,0o600)
+ os.write(f,(json.dumps([time.monotonic(),1,os.getpid()])+'\\n').encode())
+ time.sleep(0.12)
+ os.write(f,(json.dumps([time.monotonic(),-1,os.getpid()])+'\\n').encode());os.close(f)
+'''
+    processes = [subprocess.Popen([sys.executable, '-c', code, str(MODULE), str(config), str(events)], stdout=subprocess.PIPE, stderr=subprocess.PIPE) for _ in range(12)]
+    for process in processes:
+        out, err = process.communicate(timeout=15)
+        assert process.returncode == 0, err.decode()
+    rows = sorted(json.loads(x) for x in events.read_text().splitlines())
+    active = peak = 0
+    for _, delta, _ in rows:
+        active += delta; peak = max(peak, active)
+    assert len(rows) == 24 and active == 0 and peak == 3
+
+
+def test_process_death_releases_slot(config):
+    data = json.loads(config.read_text()); data['slots'] = 1; config.write_text(json.dumps(data))
+    code = "import importlib.util,sys,time;s=importlib.util.spec_from_file_location('budget',sys.argv[1]);m=importlib.util.module_from_spec(s);s.loader.exec_module(m);x=m.Lease(sys.argv[2]);x.acquire();print('ready',flush=True);time.sleep(60)"
+    process = subprocess.Popen([sys.executable, '-c', code, str(MODULE), str(config)], stdout=subprocess.PIPE)
+    try:
+        assert process.stdout.readline().strip() == b'ready'
+        with pytest.raises(TimeoutError): budget.Lease(config, timeout=0).acquire()
+    finally:
+        process.terminate(); process.wait(timeout=5)
+    with budget.browser_lease(config, timeout=0): pass
+
+
+def test_async_cancellation_does_not_leak(config):
+    async def run():
+        leases = [budget.Lease(config) for _ in range(3)]
+        try:
+            for lease in leases: lease.acquire()
+            waiter = asyncio.create_task(budget.Lease(config).acquire_async())
+            await asyncio.sleep(0.03); waiter.cancel()
+            with pytest.raises(asyncio.CancelledError): await waiter
+        finally:
+            for lease in leases: lease.release()
+        async with budget.async_browser_lease(config, timeout=0): pass
+    asyncio.run(run())
+
+
+def test_managed_browser_uses_budget_and_fails_closed(monkeypatch):
+    from tools import browser_use_cli as cli
+    monkeypatch.setattr(cli, '_find_cli', lambda: ['synthetic-cli'])
+    monkeypatch.setattr(cli, '_base_subprocess_env', lambda: {})
+    route = MagicMock(return_value=None)
+    monkeypatch.setattr(cli, '_route_backend', route)
+    monkeypatch.setattr(cli, '_workspace_dir', lambda *a: '')
+    monkeypatch.setattr(cli, '_attach_vault_supervisor', lambda *a: None)
+    monkeypatch.setattr(cli, '_find_screenshot', lambda *a: None)
+    run = MagicMock(return_value=subprocess.CompletedProcess([], 0, 'ok', ''))
+    monkeypatch.setattr(cli, '_run_cli_killing_process_group', run)
+    monkeypatch.setattr(cli, '_read_browser_cfg', lambda: {'resource_budget_module': str(MODULE)})
+    result = json.loads(cli.browser_exec('print(1)'))
+    assert result['success'] and run.call_count == 1
+    monkeypatch.setattr(cli, '_read_browser_cfg', lambda: {'resource_budget_module': '/nonexistent/mgs-budget.py'})
+    result = json.loads(cli.browser_exec('print(1)'))
+    assert not result.get('success') and run.call_count == 1 and route.call_count == 1
