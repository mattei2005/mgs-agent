+++ b/tools/write_trace.py
@@ -0,0 +1,165 @@
+#!/usr/bin/env python3
+"""Metadata-only structural receipts for automatic Hermes writes.
+
+Receipts contain paths and hashes, never skill or memory content.  An external
+profile-aware finalizer can use them to close mirror/inventory/audit/report
+obligations without coupling Hermes core to one deployment.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import tempfile
+import time
+from pathlib import Path
+from typing import Any, Dict
+
+from hermes_constants import get_hermes_home
+
+
+def _session_metadata() -> Dict[str, str]:
+    values: Dict[str, str] = {}
+    try:
+        from gateway.session_context import get_session_env
+
+        for field, env_name in (
+            ("session_id", "HERMES_SESSION_ID"),
+            ("platform", "HERMES_SESSION_PLATFORM"),
+            ("chat_id", "HERMES_SESSION_CHAT_ID"),
+            ("thread_id", "HERMES_SESSION_THREAD_ID"),
+            ("message_id", "HERMES_SESSION_MESSAGE_ID"),
+            ("session_profile", "HERMES_SESSION_PROFILE"),
+        ):
+            value = get_session_env(env_name, "")
+            if value:
+                values[field] = value
+    except Exception:
+        pass
+    return values
+
+
+def snapshot_path_tree(root: Path | str | None) -> Dict[str, str]:
+    """Return absolute file paths mapped to SHA-256, without reading content out."""
+    if root is None:
+        return {}
+    path = Path(root)
+    if not path.exists():
+        return {}
+    files = [path] if path.is_file() else sorted(p for p in path.rglob("*") if p.is_file())
+    snapshot: Dict[str, str] = {}
+    for file_path in files:
+        digest = hashlib.sha256()
+        with file_path.open("rb") as stream:
+            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(chunk)
+        snapshot[str(file_path.resolve())] = digest.hexdigest()
+    return snapshot
+
+
+def emit_structural_write_receipt(
+    *,
+    subsystem: str,
+    action: str,
+    target: str,
+    origin: str,
+    before: Dict[str, str],
+    after: Dict[str, str],
+) -> Dict[str, Any]:
+    """Persist an idempotent metadata-only receipt after a structural write."""
+    before = dict(sorted((before or {}).items()))
+    after = dict(sorted((after or {}).items()))
+    if before == after:
+        return {"persisted": False, "reason": "unchanged"}
+
+    home = get_hermes_home().resolve()
+    identity = {
+        "profile_home": str(home),
+        "subsystem": subsystem,
+        "action": action,
+        "target": target,
+        "origin": origin,
+        "before": before,
+        "after": after,
+    }
+    canonical = json.dumps(
+        identity,
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    correlation_id = hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:20]
+    record: Dict[str, Any] = {
+        "id": correlation_id,
+        "correlation_id": correlation_id,
+        "subsystem": subsystem,
+        "action": action,
+        "target": target,
+        "origin": origin,
+        "profile": home.name,
+        "profile_home": str(home),
+        "created_at": time.time(),
+        "status": "pending",
+        "before": before,
+        "after": after,
+        "paths": sorted(set(before) | set(after)),
+        "session": _session_metadata(),
+        "persisted": True,
+    }
+
+    directory = home / "pending" / "trace"
+    tmp_path: str | None = None
+    try:
+        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
+        os.chmod(directory, 0o700)
+        path = directory / f"{correlation_id}.json"
+        if path.exists():
+            existing = json.loads(path.read_text(encoding="utf-8"))
+            if (
+                existing.get("correlation_id") == correlation_id
+                and existing.get("before") == before
+                and existing.get("after") == after
+            ):
+                os.chmod(path, 0o600)
+                return {
+                    **existing,
+                    "persisted": True,
+                    "deduplicated": True,
+                    "path": str(path),
+                }
+            raise RuntimeError(f"Trace receipt ID collision for {correlation_id}")
+
+        fd, tmp_path = tempfile.mkstemp(
+            prefix=f".{correlation_id}.", suffix=".tmp", dir=str(directory)
+        )
+        os.fchmod(fd, 0o600)
+        with os.fdopen(fd, "w", encoding="utf-8") as stream:
+            json.dump(record, stream, ensure_ascii=False, indent=2)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(tmp_path, path)
+        tmp_path = None
+        os.chmod(path, 0o600)
+        readback = json.loads(path.read_text(encoding="utf-8"))
+        if readback != record:
+            raise RuntimeError("Structural receipt readback mismatch")
+        return {
+            **readback,
+            "persisted": True,
+            "deduplicated": False,
+            "path": str(path),
+        }
+    except Exception as exc:
+        if tmp_path:
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+        return {
+            **record,
+            "persisted": False,
+            "deduplicated": False,
+            "persistence_error": f"{type(exc).__name__}: {exc}",
+        }
