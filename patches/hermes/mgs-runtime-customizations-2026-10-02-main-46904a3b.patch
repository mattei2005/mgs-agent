@@ -0,0 +1,22 @@
+"""Behavior proof: gateway hygiene honors the configured threshold, fail-soft."""
+from types import SimpleNamespace
+import pytest
+from gateway.run_turn import GatewayTurnMixin
+
+
+@pytest.mark.parametrize('value', [0.5, 0.85, 0.9, '0.9'])
+def test_configured_threshold(value):
+    hs = SimpleNamespace(model='test', threshold_pct=0.85, hard_msg_limit=5000,
+        timeout_seconds=30, total_ceiling_seconds=600, max_turn_hold_seconds=10,
+        failure_cooldown_seconds=300)
+    GatewayTurnMixin._hmwa_hygiene_read_config(hs, {'compression': {'threshold': value}})
+    assert hs.threshold_pct == float(value)
+
+
+@pytest.mark.parametrize('value', [None, True, False, 0, -1, 1, 2, 'invalid', float('nan'), float('inf')])
+def test_invalid_threshold_keeps_fallback(value):
+    hs = SimpleNamespace(model='test', threshold_pct=0.85, hard_msg_limit=5000,
+        timeout_seconds=30, total_ceiling_seconds=600, max_turn_hold_seconds=10,
+        failure_cooldown_seconds=300)
+    GatewayTurnMixin._hmwa_hygiene_read_config(hs, {'compression': {'threshold': value}})
+    assert hs.threshold_pct == 0.85
