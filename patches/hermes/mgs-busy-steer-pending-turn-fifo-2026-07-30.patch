+    def _merge_leftover_steer_into_pending_turn(message: Any, payload: str) -> Any:
+        """Keep a late steer behind an already queued earlier user message.
+
+        A turn can finish with both an adapter ``pending_event`` and an
+        ``AIAgent`` leftover steer.  The pending event arrived first and owns
+        the next turn; the steer is a later complement that must be framed
+        inside that turn instead of being dropped or replayed separately.
+        """
+        if not payload or not payload.strip():
+            return message
+        if message is None or (isinstance(message, str) and not message.strip()):
+            return payload.strip()
+        return GatewayRunner._merge_startup_steer_into_message(message, payload)
