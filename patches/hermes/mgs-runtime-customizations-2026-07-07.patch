+                return False
+
+            initial_titles = getattr(adapter, "_auto_thread_initial_titles", {}) or {}
+            expected_initial_raw = initial_titles.get(thread_id)
+            if not expected_initial_raw:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=no_provisional_title_record",
+                    thread_id, session_id,
+                )
+                return False
+            current_name = self._sanitize_discord_thread_title(getattr(channel, "name", "") or "")
+            expected_initial = self._sanitize_discord_thread_title(expected_initial_raw)
+            if current_name != expected_initial:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=non_initial_title current=%r expected_initial=%r",
+                    thread_id, session_id, current_name, expected_initial,
