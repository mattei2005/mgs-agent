+                    and self._running_agents.get(session_key)
+                    is _AGENT_PENDING_SENTINEL
+                    and (
+                        expected_generation is None
+                        or self._session_run_generation.get(session_key)
+                        == expected_generation
+                    )
+                )
+                if accepted:
+                    self._pending_startup_steers.setdefault(session_key, []).append(
+                        (order, payload.strip(), event)
+                    )
+            finally:
+                remaining = max(
+                    0,
+                    self._pending_startup_steer_inflight.get(session_key, 0) - 1,
+                )
+                if remaining:
+                    self._pending_startup_steer_inflight[session_key] = remaining
+                else:
+                    self._pending_startup_steer_inflight.pop(session_key, None)
+                condition.notify_all()
+        return accepted
+
+    def _promote_agent_and_consume_startup_steers(
+        self,
+        session_key: str,
+        agent: Any,
+        run_generation: Optional[int],
+        *,
+        timeout: float = 60.0,
+        allow_same_generation_replacement: bool = False,
+    ) -> tuple[str, List[MessageEvent]]:
+        """Wait for reserved preprocessors, then atomically close and promote."""
+        if not session_key:
+            return "", []
+        condition = self._startup_steer_condition()
+        deadline = time.monotonic() + max(0.0, timeout)
+        with condition:
+            while self._pending_startup_steer_inflight.get(session_key, 0) > 0:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise RuntimeError(
+                        f"startup steer preprocessing timed out for {session_key}"
+                    )
+                condition.wait(timeout=remaining)
+            current_agent = self._running_agents.get(session_key)
+            generation_current = (
+                run_generation is None
+                or self._is_session_run_current(session_key, run_generation)
+            )
+            # Preserve the upstream stale-generation contract: /stop or /new can
+            # invalidate a run while agent construction/compression is still
+            # unwinding. The stale run may finish, but it must not promote itself
+            # over the newer session binding or fail the turn with a generic
+            # startup-ownership error.
+            if not generation_current:
+                logger.info(
+                    "Skipping stale startup agent promotion for %s — generation %s is no longer current",
+                    session_key,
+                    run_generation,
+                )
+                return "", []
+            # In-band queued follow-ups recurse through _run_agent while the
+            # outer turn still owns the same live agent/generation. Startup
+            # promotion already happened for that chain; treating this as an
+            # ownership loss aborts the valid follow-up with a generic error.
+            if current_agent is agent and generation_current:
+                return "", []
+            # A recursive in-band follow-up can legitimately rebuild the
+            # cached AIAgent between turns in the same run generation (for
+            # example after a skill/config signature change or a concurrent
+            # SessionDB write). The outer turn has already completed before
+            # recursion, so transfer ownership to the replacement atomically.
+            # Initial turns keep the strict identity check below.
+            if (
+                allow_same_generation_replacement
+                and generation_current
+                and current_agent is not None
+                and current_agent is not _AGENT_PENDING_SENTINEL
+            ):
+                self._pending_startup_steers.pop(session_key, None)
+                self._startup_steer_open.discard(session_key)
+                self._pending_startup_steer_sequence.pop(session_key, None)
+                self._running_agents[session_key] = agent
+                return "", []
+            # Preserve upstream direct-call paths (tests, API callers, compression
+            # unwind): a current generation may enter _run_agent without the outer
+            # message handler having reserved the pending sentinel. It may claim an
+            # empty slot, but never replace an existing owner.
+            direct_unclaimed_run = current_agent is None
+            if (
+                current_agent is not _AGENT_PENDING_SENTINEL
+                and not direct_unclaimed_run
+            ) or not generation_current:
+                raise RuntimeError(
+                    f"startup agent promotion lost ownership for {session_key}"
+                )
+            entries = sorted(
+                self._pending_startup_steers.pop(session_key, []),
+                key=lambda item: item[0],
+            )
+            self._startup_steer_open.discard(session_key)
+            self._pending_startup_steer_sequence.pop(session_key, None)
+            self._running_agents[session_key] = agent
+        payload = "\n\n".join(text for _order, text, _event in entries if text)
+        return payload, [event for _order, _text, event in entries]
+
+    @staticmethod
+    def _merge_startup_steer_into_message(message: Any, payload: str) -> Any:
+        """Merge a pre-agent follow-up into the first user turn cache-safely."""
+        if not payload or not payload.strip():
+            return message
+        from agent.prompt_builder import format_steer_marker
+
+        marker = format_steer_marker(payload.strip())
+        if isinstance(message, str):
+            return message + marker
+        if isinstance(message, list):
+            merged = list(message)
+            merged.append({"type": "text", "text": marker})
+            return merged
+        return f"{message}{marker}"
+
+    async def _prepare_busy_steer_payload(
+        self,
+        event: MessageEvent,
+        session_key: str,
+    ) -> str:
+        """Normalize any busy follow-up into the text-only steer channel.
+
+        Text-only events remain byte-for-byte compatible with stock steer.
+        Events carrying images, voice/audio, video, documents, or mixed
+        attachments run through the normal inbound enrichment pipeline in its
+        mid-turn mode, so captions/transcripts and cached paths reach the
+        active run exactly once instead of replaying as a later turn.
+        """
+        raw_text = (event.text or "").strip()
+        if not (getattr(event, "media_urls", None) or []):
+            return raw_text
+
+        try:
+            prepared = await self._prepare_inbound_message_text(
+                event=event,
+                source=event.source,
+                history=[],
+                session_key=session_key,
+                for_mid_turn_steer=True,
+            )
+            # None is a deliberate preprocessing refusal (for example a
+            # security-sensitive context-reference rejection). Do not bypass
+            # it by serializing the raw attachment paths.
+            if prepared is None:
+                return ""
+
+            payload = prepared.strip()
+            from tools.credential_files import to_agent_visible_cache_path as _to_agent_path
+
+            # The canonical inbound pipeline may represent voice as a
+            # transcript and mixed attachments according to the event's
+            # primary MessageType. Preserve every attachment path exactly once
+            # so no secondary image/audio/video/document disappears from a
+            # successful steer.
+            missing_media_context: list[str] = []
+            media_urls = list(getattr(event, "media_urls", None) or [])
+            media_types = list(getattr(event, "media_types", None) or [])
+            for index, media_path in enumerate(media_urls):
+                raw_path = str(media_path)
+                agent_path = (
+                    raw_path
+                    if raw_path.startswith(("http://", "https://"))
+                    else str(_to_agent_path(raw_path))
+                )
+                if raw_path in payload or agent_path in payload:
+                    continue
+                mime = str(media_types[index] if index < len(media_types) else "").lower()
+                if mime.startswith("image/"):
+                    note = f"[Image attached at: {agent_path}]"
+                elif mime.startswith("audio/"):
+                    note = f"[Audio attached at: {agent_path}; MIME: {mime or 'unknown'}]"
+                elif mime.startswith("video/"):
+                    note = f"[Video attached at: {agent_path}; MIME: {mime or 'unknown'}]"
+                else:
+                    note = f"[Document attached at: {agent_path}; MIME: {mime or 'unknown'}]"
+                missing_media_context.append(note)
+
+            return "\n\n".join(
+                part for part in (payload, *missing_media_context) if part
+            ).strip()
+        except Exception as exc:
+            logger.warning(
+                "Busy steer media enrichment failed for session %s; using path placeholders: %s",
+                session_key,
+                exc,
+            )
+
+        # Do not demote an authorized MGS media follow-up to queue solely
+        # because enrichment failed. Preserve its caption and every cached path
+        # using the same backend-visible path mapping as the success path.
+        from tools.credential_files import to_agent_visible_cache_path as _to_agent_path
+
+        fallback_notes: list[str] = []
+        media_urls = list(getattr(event, "media_urls", None) or [])
+        media_types = list(getattr(event, "media_types", None) or [])
+        for index, media_path in enumerate(media_urls):
+            raw_path = str(media_path)
+            agent_path = (
+                raw_path
+                if raw_path.startswith(("http://", "https://"))
+                else str(_to_agent_path(raw_path))
+            )
+            mime = str(media_types[index] if index < len(media_types) else "").lower()
+            if mime.startswith("image/"):
+                fallback_notes.append(f"[Image attached at: {agent_path}]")
+            elif mime.startswith("audio/"):
+                fallback_notes.append(
+                    f"[Audio attached at: {agent_path}; MIME: {mime or 'unknown'}]"
+                )
+            elif mime.startswith("video/"):
+                fallback_notes.append(
+                    f"[Video attached at: {agent_path}; MIME: {mime or 'unknown'}]"
+                )
+            else:
+                fallback_notes.append(
+                    f"[Document attached at: {agent_path}; MIME: {mime or 'unknown'}]"
+                )
+        return "\n\n".join(
+            part for part in (raw_text, *fallback_notes) if part
+        ).strip()
+
+    async def _try_busy_steer_event(
+        self,
+        event: MessageEvent,
+        session_key: str,
+        observed_agent: Any,
+    ) -> bool:
+        """Prepare and route one steer without using stale startup state."""
+        generations = getattr(self, "_session_run_generation", {})
+        observed_generation = generations.get(session_key)
+        startup_order = None
+        if observed_agent is _AGENT_PENDING_SENTINEL:
+            startup_order = self._reserve_startup_steer(
+                session_key,
+                observed_generation,
+            )
+        try:
+            payload = await self._prepare_busy_steer_payload(event, session_key)
+        except Exception:
+            if startup_order is not None:
+                self._complete_startup_steer(
+                    session_key,
+                    observed_generation,
+                    startup_order,
+                    "",
+                    event,
+                )
+            raise
+
+        if startup_order is not None:
+            return self._complete_startup_steer(
+                session_key,
+                observed_generation,
+                startup_order,
+                payload,
+                event,
+            )
+
+        current_agent = self._running_agents.get(session_key)
+        current_generation = generations.get(session_key)
+        if observed_generation != current_generation:
+            return False
+        if observed_agent is _AGENT_PENDING_SENTINEL:
+            target_agent = (
+                current_agent
+                if current_agent not in (None, _AGENT_PENDING_SENTINEL)
+                else None
+            )
+        else:
+            target_agent = current_agent if current_agent is observed_agent else None
+        if not payload or target_agent is None or not hasattr(target_agent, "steer"):
+            return False
+        try:
+            return bool(target_agent.steer(payload))
+        except Exception as exc:
+            logger.warning("Gateway steer failed for session %s: %s", session_key, exc)
+            return False
+
