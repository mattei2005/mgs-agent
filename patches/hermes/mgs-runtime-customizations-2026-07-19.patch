@@ -0,0 +1,276 @@
+"""Failure-only dead-letter coverage for capacity-rejected memory writes."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from tools.memory_tool import MemoryStore, memory_tool
+
+
+@pytest.fixture()
+def hermes_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr("tools.memory_tool.get_memory_dir", lambda: home / "memories")
+    return home
+
+
+def _store(limit: int = 40) -> MemoryStore:
+    store = MemoryStore(memory_char_limit=limit, user_char_limit=limit)
+    store.load_from_disk()
+    return store
+
+
+def _bytes(path: Path) -> bytes:
+    return path.read_bytes() if path.exists() else b""
+
+
+def test_add_overflow_stages_exact_payload_and_preserves_memory_bytes(hermes_home):
+    from tools import write_approval as wa
+
+    store = _store()
+    assert store.add("memory", "a" * 30)["success"] is True
+    memory_file = hermes_home / "memories" / "MEMORY.md"
+    before = _bytes(memory_file)
+    rejected = "b" * 30
+
+    result = json.loads(memory_tool("add", "memory", rejected, store=store))
+
+    assert result["success"] is False
+    assert result["error_code"] == "capacity_overflow"
+    assert result["failure_type"] == "capacity_overflow"
+    assert result["staged"] is True
+    assert result["requires_user_report"] is True
+    assert result["pending_id"]
+    assert _bytes(memory_file) == before
+
+    record = wa.get_pending(wa.MEMORY, result["pending_id"])
+    assert record is not None
+    assert record["persisted"] is True
+    assert record["failure_type"] == "capacity_overflow"
+    assert record["payload"] == {
+        "action": "add",
+        "target": "memory",
+        "content": rejected,
+        "old_text": None,
+    }
+    assert rejected not in record["summary"]
+    assert result["current_chars"] == 30
+    assert result["char_limit"] == 40
+
+
+def test_replace_and_batch_overflow_are_recoverable_and_atomic(hermes_home):
+    from tools import write_approval as wa
+
+    store = _store()
+    assert store.add("memory", "seed")["success"] is True
+    memory_file = hermes_home / "memories" / "MEMORY.md"
+    before = _bytes(memory_file)
+
+    replaced = json.loads(
+        memory_tool("replace", "memory", "z" * 60, old_text="seed", store=store)
+    )
+    batched = json.loads(
+        memory_tool(
+            target="memory",
+            operations=[{"action": "add", "content": "q" * 60}],
+            store=store,
+        )
+    )
+
+    assert replaced["error_code"] == "capacity_overflow"
+    assert replaced["staged"] is True
+    assert batched["error_code"] == "capacity_overflow"
+    assert batched["staged"] is True
+    assert _bytes(memory_file) == before
+    assert wa.pending_count(wa.MEMORY) == 2
+
+
+def test_duplicate_retry_coalesces_to_same_pending_id(hermes_home):
+    from tools import write_approval as wa
+
+    store = _store()
+    assert store.add("memory", "a" * 30)["success"] is True
+    before = _bytes(hermes_home / "memories" / "MEMORY.md")
+
+    results = [
+        json.loads(memory_tool("add", "memory", "b" * 30, store=store))
+        for _ in range(4)
+    ]
+
+    assert len({result["pending_id"] for result in results}) == 1
+    assert results[1]["deduplicated"] is True
+    assert results[-1]["done"] is True
+    assert len(results[-1]["state_fingerprint"]) == 64
+    assert wa.pending_count(wa.MEMORY) == 1
+    assert _bytes(hermes_home / "memories" / "MEMORY.md") == before
+
+
+def test_same_payload_against_different_state_gets_new_pending_id(hermes_home):
+    from tools import write_approval as wa
+
+    store = _store()
+    first_state = "a" * 30
+    second_state = "c" * 30
+    rejected = "b" * 30
+    assert store.add("memory", first_state)["success"] is True
+
+    first = json.loads(memory_tool("add", "memory", rejected, store=store))
+    first_record = wa.get_pending(wa.MEMORY, first["pending_id"])
+    assert first_record is not None
+
+    assert store.remove("memory", first_state)["success"] is True
+    assert store.add("memory", second_state)["success"] is True
+    before_second_rejection = _bytes(hermes_home / "memories" / "MEMORY.md")
+
+    second = json.loads(memory_tool("add", "memory", rejected, store=store))
+    second_record = wa.get_pending(wa.MEMORY, second["pending_id"])
+    assert second_record is not None
+
+    assert first["pending_id"] != second["pending_id"]
+    assert first["state_fingerprint"] != second["state_fingerprint"]
+    assert first_record["failure_context"]["state_fingerprint"] == first["state_fingerprint"]
+    assert second_record["failure_context"]["state_fingerprint"] == second["state_fingerprint"]
+    assert wa.pending_count(wa.MEMORY) == 2
+    assert _bytes(hermes_home / "memories" / "MEMORY.md") == before_second_rejection
+
+
+def test_non_capacity_failure_does_not_create_dead_letter(hermes_home):
+    from tools import write_approval as wa
+
+    store = _store()
+    assert store.add("memory", "seed")["success"] is True
+
+    result = json.loads(
+        memory_tool("replace", "memory", "new", old_text="missing", store=store)
+    )
