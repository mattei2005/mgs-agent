+def _close_oneshot_agent(agent: object) -> None:
+    """Drain one-shot agent resources before interpreter finalization.
+
+    Short-lived ``hermes -z`` processes bypass the interactive CLI cleanup
+    hook.  Honcho can own async writer/prefetch workers, and leaving those
+    daemon threads alive can abort CPython after the final response has already
+    been printed.  Memory shutdown must run before ``agent.close()`` because
+    close clears the session message list.
+    """
+    messages = list(getattr(agent, "_session_messages", None) or [])
+    try:
+        shutdown_memory = getattr(agent, "shutdown_memory_provider", None)
+        if callable(shutdown_memory):
+            shutdown_memory(messages)
+    except Exception:
+        logging.debug("One-shot memory shutdown failed", exc_info=True)
+    try:
+        close_agent = getattr(agent, "close", None)
+        if callable(close_agent):
+            close_agent()
+    except Exception:
+        logging.debug("One-shot agent close failed", exc_info=True)
 
 
