+    def _auto_thread_initial_name_for_source(self, thread: Any) -> Optional[str]:
+        """Return the exact created name, including the author suffix, or fail closed.
+
+        discord.py Thread is slotted: the optional dynamic attribute may not
+        exist. Use the creation-time record, never rederive an unsuffixed title
+        or trust the current name (which a human may have edited).
+        """
+        if thread is None:
+            return None
+        thread_id = str(getattr(thread, "id", "") or "").strip()
+        titles = getattr(self, "_auto_thread_initial_titles", {}) or {}
+        return titles.get(thread_id) or getattr(thread, "_hermes_auto_thread_initial_name", None)
+
     def _first_name_for_thread_title(self, display_name: Any) -> str:
             """Return the short first-name suffix for MGS Discord thread titles."""
             name = re.sub(r"\s+", " ", str(display_name or "")).strip(" \t\n\r:;,.!?—-–")
