+import json
+import os
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.config import PlatformConfig
+from plugins.platforms.discord.adapter import (
+    DiscordAdapter,
+    _apply_yaml_config,
+    _discord_thread_auto_add_user_ids,
+)
+
+
+ACQUISITION_CHANNEL = "1516887105543077949"
+DIRECTOR_CHANNEL = "1508853425952133180"
+
+
+def test_yaml_config_bridges_per_channel_thread_auto_add(monkeypatch):
+    monkeypatch.delenv("DISCORD_THREAD_AUTO_ADD_USERS_BY_CHANNEL", raising=False)
+    mapping = {
+        ACQUISITION_CHANNEL: ["1", "2"],
+        DIRECTOR_CHANNEL: [],
+    }
+
+    _apply_yaml_config({}, {"thread_auto_add_users_by_channel": mapping})
+
+    assert json.loads(os.environ["DISCORD_THREAD_AUTO_ADD_USERS_BY_CHANNEL"]) == mapping
+
+
+def test_per_channel_thread_auto_add_overrides_legacy_global(monkeypatch):
+    monkeypatch.setenv("DISCORD_THREAD_AUTO_ADD_USERS", "9")
+    monkeypatch.setenv(
+        "DISCORD_THREAD_AUTO_ADD_USERS_BY_CHANNEL",
+        json.dumps(
+            {
+                ACQUISITION_CHANNEL: ["1", "2", "1"],
+                DIRECTOR_CHANNEL: [],
+            }
+        ),
+    )
+
+    assert _discord_thread_auto_add_user_ids(ACQUISITION_CHANNEL) == (["1", "2"], True)
+    assert _discord_thread_auto_add_user_ids(DIRECTOR_CHANNEL) == ([], True)
+    assert _discord_thread_auto_add_user_ids("other") == (["9"], True)
+
+
+def test_explicit_empty_global_thread_auto_add_fails_closed(monkeypatch):
+    monkeypatch.delenv("DISCORD_THREAD_AUTO_ADD_USERS_BY_CHANNEL", raising=False)
+    monkeypatch.setenv("DISCORD_THREAD_AUTO_ADD_USERS", "")
+
+    assert _discord_thread_auto_add_user_ids(ACQUISITION_CHANNEL) == ([], True)
+
+
+def test_invalid_per_channel_thread_auto_add_fails_closed(monkeypatch):
+    monkeypatch.setenv("DISCORD_THREAD_AUTO_ADD_USERS", "9")
+    monkeypatch.setenv("DISCORD_THREAD_AUTO_ADD_USERS_BY_CHANNEL", "not-json")
+
+    assert _discord_thread_auto_add_user_ids(ACQUISITION_CHANNEL) == ([], True)
+
+
+@pytest.mark.asyncio
+async def test_auto_add_is_scoped_to_parent_channel(monkeypatch):
+    members = {
+        1: SimpleNamespace(id=1, bot=False),
+        2: SimpleNamespace(id=2, bot=False),
+    }
+
+    async def fetch_members_must_not_run(*, limit=None):
+        raise AssertionError("broad guild-member discovery must not run")
+        yield  # pragma: no cover
+
+    guild = SimpleNamespace(
+        get_member=lambda user_id: members.get(user_id),
+        fetch_member=AsyncMock(side_effect=lambda user_id: members[user_id]),
+        fetch_members=fetch_members_must_not_run,
+        members=list(members.values()),
+    )
+    thread = SimpleNamespace(id=100, add_user=AsyncMock())
+    acquisition = SimpleNamespace(
+        id=int(ACQUISITION_CHANNEL),
+        guild=guild,
+        permissions_for=lambda member: SimpleNamespace(view_channel=True),
+    )
+    director = SimpleNamespace(
+        id=int(DIRECTOR_CHANNEL),
+        guild=guild,
+        permissions_for=lambda member: SimpleNamespace(view_channel=True),
+    )
+    monkeypatch.setenv("DISCORD_THREAD_AUTO_ADD_USERS", "")
+    monkeypatch.setenv(
+        "DISCORD_THREAD_AUTO_ADD_USERS_BY_CHANNEL",
+        json.dumps(
+            {
+                ACQUISITION_CHANNEL: ["1", "2"],
+                DIRECTOR_CHANNEL: [],
+            }
+        ),
+    )
+
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, token="fake-token"))
+    adapter._client = SimpleNamespace(user=SimpleNamespace(id=999))
+
+    await adapter._auto_add_parent_channel_members_to_thread(thread, acquisition)
+    assert [call.args[0].id for call in thread.add_user.await_args_list] == [1, 2]
+
+    thread.add_user.reset_mock()
+    await adapter._auto_add_parent_channel_members_to_thread(thread, director)
+    thread.add_user.assert_not_awaited()
