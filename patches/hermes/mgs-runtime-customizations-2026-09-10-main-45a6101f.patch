+def _is_discord_bot_loop_noise(message: Any, client_user: Any = None) -> bool:
+    """Return True for low-information bot messages that can cause bot loops.
+
+    DISCORD_ALLOW_BOTS=mentions is needed for explicit cross-agent handoffs, but
+    once a task is complete a mentioned bot may emit acknowledgements/status
+    chatter ("Sem ação pendente", 👍, retry notices). Those messages should stay
+    visible in Discord/logs, but must not wake another MGS bot and create a
+    ping-pong loop. Keep the filter narrow: never suppress messages with
+    attachments/embeds or substantive text.
