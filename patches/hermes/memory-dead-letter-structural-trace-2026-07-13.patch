index b017299d8..14a2f1b9d 100644
--- a/tools/write_approval.py
+++ b/tools/write_approval.py
@@ -42,9 +42,11 @@ web dashboard.
 
 from __future__ import annotations
 
+import hashlib
 import json
 import logging
 import os
+import tempfile
 import time
 import uuid
 from pathlib import Path
@@ -151,6 +153,112 @@ def stage_write(subsystem: str, payload: Dict[str, Any],
     return record
 
 
+def stage_failure_write(
+    subsystem: str,
+    payload: Dict[str, Any],
+    *,
+    failure_type: str,
+    summary: str,
+    origin: str,
+    context: Optional[Dict[str, Any]] = None,
+) -> Dict[str, Any]:
+    """Persist an idempotent failure-only pending record with strict readback.
+
+    Unlike :func:`stage_write`, this function is used after a direct write has
+    already failed. Returning a plausible pending ID when persistence failed
+    would lose the rejected payload, so the return value always carries a
+    truthful ``persisted`` flag and never claims success without readback.
+    """
+    context = dict(context or {})
+    identity = {
+        "hermes_home": str(get_hermes_home().resolve()),
+        "subsystem": subsystem,
+        "failure_type": failure_type,
+        "payload": payload,
+    }
+    canonical = json.dumps(
+        identity,
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    idempotency_key = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+    pid = idempotency_key[:16]
+    record = {
+        "id": pid,
+        "subsystem": subsystem,
+        "action": payload.get("action", ""),
+        "summary": (summary or "").strip(),
+        "origin": origin or "foreground",
+        "created_at": time.time(),
+        "payload": payload,
+        "failure_type": failure_type,
+        "failure_context": context,
+        "idempotency_key": idempotency_key,
+        "persisted": True,
+    }
+    tmp_path: Optional[str] = None
+    try:
+        d = _pending_dir(subsystem)
+        d.mkdir(parents=True, exist_ok=True, mode=0o700)
+        os.chmod(d, 0o700)
+        path = d / f"{pid}.json"
+
+        if path.exists():
+            existing = json.loads(path.read_text(encoding="utf-8"))
+            if (
+                existing.get("idempotency_key") == idempotency_key
+                and existing.get("failure_type") == failure_type
+                and existing.get("payload") == payload
+            ):
+                os.chmod(path, 0o600)
+                return {
+                    **existing,
+                    "persisted": True,
+                    "deduplicated": True,
+                    "path": str(path),
+                }
+            raise RuntimeError(f"Pending ID collision for {pid}")
+
+        fd, tmp_path = tempfile.mkstemp(prefix=f".{pid}.", suffix=".tmp", dir=str(d))
+        os.fchmod(fd, 0o600)
+        with os.fdopen(fd, "w", encoding="utf-8") as tmp_file:
+            json.dump(record, tmp_file, ensure_ascii=False, indent=2)
+            tmp_file.flush()
+            os.fsync(tmp_file.fileno())
+        os.replace(tmp_path, path)
+        tmp_path = None
+        os.chmod(path, 0o600)
+
+        readback = json.loads(path.read_text(encoding="utf-8"))
+        if readback != record:
+            raise RuntimeError("Pending failure record readback mismatch")
+        return {
+            **readback,
+            "persisted": True,
+            "deduplicated": False,
+            "path": str(path),
+        }
+    except Exception as exc:
+        if tmp_path:
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+        logger.error(
+            "Failed to persist failure-only pending %s write: %s",
+            subsystem,
+            exc,
+            exc_info=True,
+        )
+        return {
+            **record,
+            "persisted": False,
+            "deduplicated": False,
+            "persistence_error": f"{type(exc).__name__}: {exc}",
+        }
+
+
 def list_pending(subsystem: str) -> List[Dict[str, Any]]:
     """Return all pending records for ``subsystem``, oldest first."""
     d = _pending_dir(subsystem)
