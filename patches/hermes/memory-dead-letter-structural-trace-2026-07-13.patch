+def _stage_capacity_overflow(
+    result: Dict[str, Any],
+    payload: Dict[str, Any],
+) -> Dict[str, Any]:
+    """Preserve an exact capacity-rejected write in a failure-only queue."""
+    if result.get("error_code") != "capacity_overflow":
+        return result
+
+    from tools import write_approval as wa
+
+    context: Dict[str, Any] = {
+        "current_chars": result.get("current_chars"),
+        "char_limit": result.get("char_limit"),
+        "attempted_chars": result.get("attempted_chars"),
+        "usage": result.get("usage"),
+        "profile": get_hermes_home().name,
+    }
+    try:
+        from gateway.session_context import get_session_env
+
+        for field, env_name in (
+            ("session_id", "HERMES_SESSION_ID"),
+            ("platform", "HERMES_SESSION_PLATFORM"),
+            ("chat_id", "HERMES_SESSION_CHAT_ID"),
+            ("thread_id", "HERMES_SESSION_THREAD_ID"),
+            ("message_id", "HERMES_SESSION_MESSAGE_ID"),
+            ("session_profile", "HERMES_SESSION_PROFILE"),
+        ):
+            value = get_session_env(env_name, "")
+            if value:
+                context[field] = value
+    except Exception:
+        pass
+
+    payload_chars = len(json.dumps(payload, ensure_ascii=False, sort_keys=True))
+    summary = (
+        f"capacity overflow: {payload.get('target', 'memory')} "
+        f"{payload.get('action', 'write')} ({payload_chars} payload chars)"
+    )
+    record = wa.stage_failure_write(
+        wa.MEMORY,
+        payload,
+        failure_type="capacity_overflow",
+        summary=summary,
+        origin=wa.current_origin(),
+        context=context,
+    )
+
+    staged_result = dict(result)
+    staged_result.update(
+        {
+            "failure_type": "capacity_overflow",
+            "requires_user_report": True,
+        }
+    )
+    if record.get("persisted"):
+        staged_result.update(
+            {
+                "staged": True,
+                "pending_id": record["id"],
+                "deduplicated": bool(record.get("deduplicated")),
+                "message": (
+                    "Memory write was rejected by the capacity limit. The exact proposal "
+                    "was preserved for reviewed recovery; memory remains unchanged."
+                ),
+            }
+        )
+    else:
+        staged_result.update(
+            {
+                "staged": False,
+                "dead_letter_error": record.get(
+                    "persistence_error", "failure-only staging did not persist"
+                ),
+                "message": (
+                    "Memory write was rejected by the capacity limit and the recovery "
+                    "record could not be persisted. Report this failure immediately; "
+                    "memory remains unchanged."
+                ),
+            }
+        )
+    return staged_result
+
+
