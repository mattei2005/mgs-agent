+    def _remember_auto_thread_initial_title(self, thread: Any, thread_name: str) -> None:
+        """Remember the exact provisional title used for a new auto-created thread.
+
+        PATCH (MGS Digital Corp): run.py later allows one AI-generated rename
+        only if Discord's current name still equals this exact provisional value.
+        This avoids recomputing the regex title from a gateway-mutated message.
+        In-memory only is intentional: if the gateway restarts before auto-title
+        completes, we fail closed and do not rename an existing thread.
+        """
+        thread_id = str(getattr(thread, "id", "") or "").strip()
+        if not thread_id or not thread_name:
+            return
+        titles = getattr(self, "_auto_thread_initial_titles", None)
+        if titles is None:
+            titles = {}
+            self._auto_thread_initial_titles = titles
+        titles[thread_id] = thread_name
+
