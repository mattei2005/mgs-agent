+    def _sanitize_discord_thread_title(self, title: str) -> str:
+        """Return a Discord-safe thread title from an auto-generated session title."""
+        cleaned = re.sub(r"\s+", " ", str(title or "")).strip(" \t\n\r:;,.!?—-–")
+        if not cleaned:
+            return "Assunto da Thread"
+        # Discord channel/thread names are capped at 100 chars. Keep a little
+        # room and avoid churn from trailing ellipsis when possible.
+        if len(cleaned) > 90:
+            cleaned = cleaned[:87].rstrip(" \t\n\r:;,.!?—-–") + "..."
+        return cleaned
