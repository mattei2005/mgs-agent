+    def _discord_title_message_from_gateway_text(self, message: str) -> str:
+        """Extract the actionable user text for Discord auto-title generation.
+
+        Removes history-backfill context and the shared-thread sender prefix so
+        title_generator sees the user's request, not gateway scaffolding.
+        """
+        text = str(message or "").strip()
+        parts = re.split(r"\n\n\[New message[^\]]*\]\n", text, maxsplit=1)
+        if len(parts) == 2:
+            text = parts[1].strip()
+        text = re.sub(r"^\[[^\]\n]{1,100}\]\s*", "", text).strip()
+        return text or str(message or "").strip()
