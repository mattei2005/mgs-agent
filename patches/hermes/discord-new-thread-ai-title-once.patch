+    def _discord_title_message_from_gateway_text(self, message: str) -> str:
+        """Extract the actionable user text for Discord auto-title generation.
+
+        Removes history-backfill context and the shared-thread sender prefix so
+        title_generator sees the user's request, not gateway scaffolding.
+        """
+        text = str(message or "").strip()
+        parts = re.split(r"\n\n\[New message[^\]]*\]\n", text, maxsplit=1)
+        if len(parts) == 2:
+            text = parts[1].strip()
+        text = re.sub(r"^\[[^\]\n]{1,100}\]\s*", "", text).strip()
+        return text or str(message or "").strip()
+
+    async def _discord_thread_safe_to_autorename(
+        self,
+        source: SessionSource,
+        *,
+        session_id: str = "",
+        max_thread_age_seconds: float = 1800.0,
+    ) -> bool:
+        """Return True only for the one safe AI rename of a new Discord thread.
+
+        Uses the exact provisional title stored by adapter._auto_create_thread;
+        if that value is absent (restart, human-created thread, old thread), fail
+        closed and do not rename.
+        """
+        if not self._is_discord_thread_lane(source):
+            return False
+
+        adapter = self.adapters.get(source.platform) if getattr(self, "adapters", None) else None
+        client = getattr(adapter, "_client", None) if adapter is not None else None
+        if client is None:
+            return False
+
+        thread_id = str(source.thread_id or source.chat_id or "").strip()
+        if not thread_id:
+            return False
+
+        try:
+            channel = client.get_channel(int(thread_id))
+            if channel is None:
+                channel = await client.fetch_channel(int(thread_id))
+            if channel is None or not hasattr(channel, "edit"):
+                return False
+
+            bot_id = str(getattr(getattr(client, "user", None), "id", "") or "")
+            owner_id = str(getattr(channel, "owner_id", "") or "")
+            if bot_id and owner_id and owner_id != bot_id:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=not_bot_owned owner=%s bot=%s",
+                    thread_id, session_id, owner_id, bot_id,
+                )
+                return False
+
+            created_at = getattr(channel, "created_at", None)
+            if created_at is None:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=missing_created_at",
+                    thread_id, session_id,
+                )
+                return False
+            try:
+                from datetime import datetime, timezone
+                if created_at.tzinfo is None:
+                    created_at = created_at.replace(tzinfo=timezone.utc)
+                age_seconds = (datetime.now(timezone.utc) - created_at).total_seconds()
+            except Exception:
+                logger.debug("Failed to evaluate Discord thread age before title rename", exc_info=True)
+                return False
+            if age_seconds > max_thread_age_seconds:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=not_new age_seconds=%.1f",
+                    thread_id, session_id, age_seconds,
+                )
+                return False
+
+            initial_titles = getattr(adapter, "_auto_thread_initial_titles", {}) or {}
+            expected_initial_raw = initial_titles.get(thread_id)
+            if not expected_initial_raw:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=no_provisional_title_record",
+                    thread_id, session_id,
+                )
+                return False
+            current_name = self._sanitize_discord_thread_title(getattr(channel, "name", "") or "")
+            expected_initial = self._sanitize_discord_thread_title(expected_initial_raw)
+            if current_name != expected_initial:
+                logger.info(
+                    "Discord auto-title rename skipped: thread=%s session=%s reason=non_initial_title current=%r expected_initial=%r",
+                    thread_id, session_id, current_name, expected_initial,
+                )
+                return False
+
+            return True
+        except Exception:
+            logger.debug("Failed to evaluate Discord auto-title rename safety", exc_info=True)
+            return False
