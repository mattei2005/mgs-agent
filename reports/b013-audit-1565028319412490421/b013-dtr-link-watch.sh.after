def now_dt():
    return datetime.now(ZoneInfo('America/New_York'))


def now_iso():
    return now_dt().isoformat(timespec='seconds')


def norm(value):
    s = str(value or '').strip().casefold()
    s = ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c))
    return re.sub(r'\s+', ' ', s)


def parse_old_profile_references(value):
    """Parse ``Perfil Antigo: Name - ID`` as a logical predecessor profile."""
    references = []
    for match in re.finditer(r'perfil\s+antigo\s*:\s*([^;\n\r]+)', str(value or ''), flags=re.I):
        raw = match.group(1).strip()
        profile_id = ''
        id_match = re.search(r'\s*-\s*(\d{6,})\s*$', raw)
        if id_match:
            profile_id = id_match.group(1)
            name = raw[:id_match.start()].strip(' -')
        else:
            name = raw.strip(' -')
        if name:
            references.append({'name': name, 'profile_id': profile_id})
    return references


def profile_names_from_item(item, app_name):
    """Read principal/backup names from current 1Password metadata.

    Complete metadata may exist as dedicated fields, in the strict item-title
    suffix, or in notes. When more than one complete source exists, every source
    must agree; this prevents a stale copied name from reaching an alert.
    """
    candidates = []

    primary = OP_RESOLVER.field_value(
        item, 'perfil', 'perfil admin', 'perfil principal', 'profile', 'admin profile'
    ).strip()
    backup = OP_RESOLVER.field_value(
        item, 'perfil backup', 'backup profile', 'backup_profile'
    ).strip()
    if primary and backup:
        candidates.append(('fields', primary, backup))

    title = str(item.get('title') or '').strip()
    title_match = re.fullmatch(
        rf'BOT\s+{re.escape(app_name)}\s+Token\s*-\s*(.+?)\s*,\s*backup\s*:\s*(.+)',
        title,
        flags=re.IGNORECASE,
    )
    if title_match:
        candidates.append(('title', title_match.group(1).strip(), title_match.group(2).strip()))

    notes = OP_RESOLVER.field_value(item, 'notesPlain', 'notes', 'notas')
    note_primary = ''
    note_backup = ''
    for line in notes.splitlines():
        match = re.fullmatch(r'\s*Perfil(?:\s+(?:admin|principal))?\s*:\s*(.+?)\s*', line, re.IGNORECASE)
        if match:
            note_primary = match.group(1).strip()
            continue
        match = re.fullmatch(r'\s*Perfil\s+backup\s*:\s*(.+?)\s*', line, re.IGNORECASE)
        if match:
            note_backup = match.group(1).strip()
    if note_primary and note_backup:
        candidates.append(('notes', note_primary, note_backup))

    if not candidates:
        raise RuntimeError('B013-7 principal/backup profile metadata missing in 1Password')

    expected = (norm(candidates[0][1]), norm(candidates[0][2]))
    if not all((norm(row[1]), norm(row[2])) == expected for row in candidates[1:]):
        raise RuntimeError('B013-7 profile metadata mismatch across 1Password title/fields/notes')

    profile_name = candidates[0][1]
    backup_profile_name = candidates[0][2]
    if not profile_name or not backup_profile_name or len(profile_name) > 200 or len(backup_profile_name) > 200:
        raise RuntimeError('B013-7 profile metadata is empty or too long in 1Password')
    return profile_name, backup_profile_name


INVEST_3D_DATA = None
INVEST_3D_ERROR = None


def norm_invest_name(value):
    text = unicodedata.normalize('NFKD', str(value or '').strip().lower())
    text = ''.join(char for char in text if not unicodedata.combining(char))
    return re.sub(r'\s+', ' ', re.sub(r'[^a-z0-9]+', ' ', text)).strip()


def load_invest_3d():
    """Fetch today's partial and the prior-three-day metric once per alert run."""
    global INVEST_3D_DATA, INVEST_3D_ERROR
    if INVEST_3D_DATA is not None:
        return INVEST_3D_DATA
    command = [
        'xvfb-run', '-a', INVEST_3D_PYTHON, str(INVEST_3D_HELPER), '--invest-3d-json',
    ]
    try:
        proc = subprocess.run(command, text=True, capture_output=True, timeout=60, env=os.environ.copy())
        lines = [line.strip() for line in (proc.stdout or '').splitlines() if line.strip()]
        if proc.returncode != 0 or not lines:
            raise RuntimeError(f'helper exit={proc.returncode}')
        # xvfb-run merges browser-admission stderr into stdout; a release
        # event can share the JSON line. Select the business JSON by contract.
        payload = None
        for line in lines:
            try:
                candidate, _ = json.JSONDecoder().raw_decode(line)
            except (json.JSONDecodeError, TypeError):
                continue
            if isinstance(candidate, dict) and candidate.get('status') == 'INVEST_3D_OK':
                if payload is not None:
                    raise RuntimeError('helper returned multiple three-day payloads')
                payload = candidate
        if payload is None:
            raise RuntimeError('helper returned no three-day business payload')
        if payload.get('status') != 'INVEST_3D_OK' or payload.get('days') != 3:
            raise RuntimeError('helper returned an invalid three-day payload')
        by_profile = payload.get('by_profile')
        by_profile_today = payload.get('by_profile_today')
        if not isinstance(by_profile, dict) or not by_profile:
            raise RuntimeError('helper returned an empty three-day profile map')
        if not isinstance(by_profile_today, dict) or not by_profile_today:
            raise RuntimeError('helper returned an empty current-day profile map')
        INVEST_3D_DATA = payload
        INVEST_3D_ERROR = None
    except Exception as exc:
        INVEST_3D_DATA = {
            'status': 'INVEST_3D_UNAVAILABLE',
            'days': 3,
            'by_profile': {},
            'by_profile_today': {},
        }
        INVEST_3D_ERROR = f'{type(exc).__name__}: {str(exc)}'[:240]
    return INVEST_3D_DATA


def format_invest_metric(name, field, profile_names=None):
    by_profile = load_invest_3d().get(field) or {}
    keys = []
    for profile_name in (profile_names or [name]):
        full_key = norm_invest_name(profile_name)
        if full_key and full_key not in keys:
            keys.append(full_key)
        for part in str(profile_name or '').split('/'):
            key = norm_invest_name(part)
            if key and key not in keys:
                keys.append(key)
    values = []
    for key in keys:
        if key not in by_profile:
            continue
        try:
            values.append(Decimal(str(by_profile[key])))
        except (InvalidOperation, TypeError, ValueError):
            return 'n/d'
    if not values:
        return 'n/d'
    value = sum(values, Decimal('0'))
    absolute = f'{abs(value):,.2f}'.replace(',', 'X').replace('.', ',').replace('X', '.')
    return f"{'-' if value < 0 else ''}R$ {absolute}"


def format_invest_today(name, profile_names=None):
    return format_invest_metric(name, 'by_profile_today', profile_names=profile_names)


def format_invest_3d(name, profile_names=None):
    return format_invest_metric(name, 'by_profile', profile_names=profile_names)


def app_key_from_sheet_value(value):
    raw = str(value or '').strip().upper()
    m = re.fullmatch(r'B\s*0*(\d{1,3})(?:\s*-\s*(\d+)|\s*([A-Z]+))?', raw)
    if not m:
        return raw
    key = f"B{int(m.group(1)):03d}"
    if m.group(2):
        key += '-' + m.group(2)
    elif m.group(3):
        key += m.group(3)
    return key


def resolve_removed_header(headers):
    """Resolve the live accumulated-removal column without blind writes.

    Rodolfo renamed the same operational column to ``Rem Acum``. The writer
    still targets column A, so the resolved alias must remain uniquely in A;
    otherwise reconciliation stops before any Sheet update.
    """
    aliases = {'rem acum', 'removidos acumulado', 'zzzaa'}
    matches = [header for header in headers if norm(header) in aliases]
    if len(matches) != 1:
        raise RuntimeError(
            f'Sheets B013-7 accumulated-removal header ambiguous/missing: matches={len(matches)}'
        )
    marker_header = matches[0]
    if headers.index(marker_header) != 0:
        raise RuntimeError('Sheets B013-7 accumulated-removal header moved away from column A')
    return marker_header


def load_config():
    item = OP_RESOLVER.get_item_json(CONFIG_ITEM, VAULT)
    app_id = OP_RESOLVER.field_value(item, 'app_id', required=True)
    app_name = (OP_RESOLVER.field_value(item, 'app_name') or '').strip().upper()
    alert_channel_id = (OP_RESOLVER.field_value(item, 'alert_channel_id') or '').strip()
    if app_name != 'B013-7':
        raise RuntimeError('B013-7 config identity mismatch; refusing stale predecessor credentials')
    if alert_channel_id != '1522830283240505385':
        raise RuntimeError('B013-7 alert channel mismatch; refusing to post or reconcile')
    profile_name, backup_profile_name = profile_names_from_item(item, app_name)
    return {
        'app_id': app_id,
        'app_name': app_name,
        'app_secret': OP_RESOLVER.field_value(item, 'app_secret', required=True),
        'dtr_base_url': (OP_RESOLVER.field_value(item, 'dtr_base_url') or 'https://digitaltrchat.com').rstrip('/'),
        'sheet_id': OP_RESOLVER.field_value(item, 'sheet_id') or '1sTkBE6RQPQ3obq1j6m8RSu_22beEUbZjkQ-OttI01XY',
        'sheet_gid': OP_RESOLVER.field_value(item, 'sheet_gid') or '542936436',
        'alert_channel_id': alert_channel_id,
        'profile_name': profile_name,
        'backup_profile_name': backup_profile_name,
        'config_item_title': str(item.get('title') or '').strip(),
    }


def load_state():
    if STATE_PATH.exists():
        try:
            return json.loads(STATE_PATH.read_text(encoding='utf-8'))
        except Exception:
            return {'_corrupt_backup_at': now_iso(), 'accounts': {}}
    return {'_created_at': now_iso(), 'accounts': {}}


def save_state(state):
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE_PATH.with_suffix('.tmp')
    tmp.write_text(json.dumps(state, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
    tmp.replace(STATE_PATH)


def graph(path, params, token):
    q = urllib.parse.urlencode({**params, 'access_token': token})
    req = urllib.request.Request(f'{GRAPH}{path}?{q}', headers={'User-Agent': 'MGS-Zeus-B013-DTR-Link-Watch/1.0'})
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            headers = {k.lower(): v for k, v in r.headers.items()}
            return r.status, headers, json.loads(r.read().decode('utf-8', 'replace') or '{}')
    except urllib.error.HTTPError as e:
        raw = e.read().decode('utf-8', 'replace')
        try:
            body = json.loads(raw)
        except Exception:
            body = {'raw': raw[:500]}
        return e.code, {k.lower(): v for k, v in e.headers.items()}, body


def sheet_rows(config):
    token = google_service_account_access_token()
    title = sheet_title_for_gid(config, token)
    rng = quote_sheet_range(title, 'A:P')
    status, body = sheets_request(
        'GET',
        f"/spreadsheets/{config['sheet_id']}/values/{urllib.parse.quote(rng, safe='')}?majorDimension=ROWS",
        token,
    )
    if status != 200:
        raise RuntimeError(f'Sheets B013-7 read failed status={status} body={str(body)[:300]}')
    values = body.get('values') or []
    if not values:
        raise RuntimeError('Sheets B013-7 read returned no rows')
    headers = [str(x) for x in values[0]]
    removed_header = resolve_removed_header(headers)
    required_headers = {'User', 'Segurador', 'PG', 'USUARIO', 'NO APP'}
    missing_headers = sorted(required_headers - set(headers))
    if missing_headers:
        raise RuntimeError(f'Sheets B013-7 required headers missing: {missing_headers}')
    targets = []
    for idx, values_row in enumerate(values[1:], start=2):
        padded = list(values_row) + [''] * max(0, len(headers) - len(values_row))
        row = dict(zip(headers, padded[:len(headers)]))
        row['Removidos acumulado'] = row.get(removed_header, '') if removed_header else ''
        if app_key_from_sheet_value(row.get('NO APP')) != 'B013-7':
            continue
        migrado = str(row.get('Migrado') or row.get('Migracao') or '').strip().upper()
        sheet_x = str(row.get('Removidos acumulado') or '').strip().upper()
        if REQUIRE_MIGRADO_TRUE and migrado != 'TRUE':
            continue
        user = (row.get('User') or '').strip()
        segurador = (row.get('Segurador') or '').strip()
        if not user or not segurador:
            continue
        old_profiles = parse_old_profile_references(row.get('OBS') or '')
        invest_profile_names = []
        seen_invest_names = set()
        for candidate in [segurador, *[old['name'] for old in old_profiles]]:
            candidate_key = norm_invest_name(candidate)
            if candidate_key and candidate_key not in seen_invest_names:
                seen_invest_names.add(candidate_key)
                invest_profile_names.append(candidate)
        targets.append({
            'row': idx,
            'sheet_x': (row.get('Removidos acumulado') or '').strip(),
            'user': user,
            'segurador': segurador,
            'profile_id': (row.get('USUARIO') or '').strip(),
            'pages': (row.get('PG') or '').strip(),
            'invest_profile_names': invest_profile_names,
        })
    if MAX_TARGETS:
        targets = targets[:MAX_TARGETS]
    return targets


def map_dtr_items(users):
    mapped, missing, _errors, _cache = OP_RESOLVER.resolve_dtr_items(users, VAULT)
    # The metadata cache is intentionally long-lived to reduce 1Password use,
    # but a cache miss must be confirmed live before becoming an incident.
    if missing:
        refreshed, _still_missing, _refresh_errors, _fresh_cache = OP_RESOLVER.resolve_dtr_items(
            missing, VAULT, force_refresh=True
        )
        mapped.update(refreshed)
    return {username: row['id'] for username, row in mapped.items()}


def extract_token_from_html(src):
    # DigitalTRChat renders the active FB connection token in graph.facebook.com/me/picture URLs.
    # Never print or persist this token.
    vals = re.findall(r'access_token=([^&"\']+)', src)
    return urllib.parse.unquote(vals[0]) if vals else ''


def should_alert(prev, key, status):
    alerts = prev.setdefault('alerts', {})
    item = alerts.get(key) or {}
    if item.get('status') != status:
        return True
    ts = item.get('at')
    try:
        last = datetime.fromisoformat(ts) if ts else None
    except Exception:
        last = None
    if not last:
        return True
    return (now_dt() - last).total_seconds() >= ALERT_COOLDOWN_MINUTES * 60


def mark_alert(prev, key, status):
    prev.setdefault('alerts', {})[key] = {'status': status, 'at': now_iso()}


def clear_alert(prev, key):
    alerts = prev.setdefault('alerts', {})
    alerts.pop(key, None)


def persistent_unknown_status(rows):
    parts = sorted(
        f"{str(r.get('user') or '').strip().casefold()}|{norm(r.get('segurador'))}|{str(r.get('link_status') or 'unknown')}"
        for r in rows
    )
    return f"persistent_unknowns={len(rows)};" + ';'.join(parts)


def link_change_signature(changes, failures):
    """Deduplicate the exact changed identities, not unrelated equal counts."""
    def identity(row):
        return (str(row.get('user') or '').casefold(), norm(row.get('segurador')))
    return json.dumps({
        'changes': sorted(
            (*identity(row), str(row.get('kind') or ''), str(row.get('old') or ''), str(row.get('new') or ''))
            for row in changes
        ),
        'failures': sorted(identity(row) for row in failures),
    }, ensure_ascii=False, sort_keys=True, separators=(',', ':'))


def confirmed_account_state(snapshot):
    """Return only durable connection evidence, never a transport diagnostic."""
    snapshot = snapshot or {}
    verdict = snapshot.get('last_confirmed_verdict')
    status = snapshot.get('last_confirmed_link_status')
    if verdict not in {'linked', 'unlinked_confirmed'}:
        verdict = snapshot.get('verdict')
        status = snapshot.get('link_status')
        # Compatibility with old snapshots that predate explicit verdicts.
        if verdict is None and status == 'linked':
            verdict = 'linked'
        elif verdict is None and status in {'not_linked_or_invalid', 'token_app_mismatch', 'profile_removed_from_dtr'}:
            verdict = 'unlinked_confirmed'
    if verdict not in {'linked', 'unlinked_confirmed'}:
        return None, None
    return verdict, status


def account_link_change(result, previous, initialized):
    """Membership changes require a confirmed edge or a new Sheet assignment."""
    if not initialized:
        return None
    previous = previous or {}
    current_verdict = result.get('verdict')
    if not previous.get('link_status'):
        return {
            'user': result.get('user'), 'segurador': result.get('segurador'),
            'old': 'not_monitored', 'new': result.get('link_status'),
            'kind': 'added', 'reason': 'new_sheet_assignment',
        }
    old_verdict, old_status = confirmed_account_state(previous)
    if (
        old_verdict is not None
        and current_verdict in {'linked', 'unlinked_confirmed'}
        and old_verdict != current_verdict
    ):
        return {
            'user': result.get('user'), 'segurador': result.get('segurador'),
            'old': old_status, 'new': result.get('link_status'),
            'kind': 'added' if current_verdict == 'linked' else 'removed',
            'reason': 'confirmed_link_transition',
        }
    return None


def classify_account_result(result, previous):
    """Convert repeated, verified DTR absence into a profile removal.

    A profile missing from an otherwise authenticated DTR account inventory is
    an account-level event, not evidence that the B013 app is restricted. The
    first absence remains inconclusive; the second becomes a normal confirmed
    removal so Sheet reconciliation and the standard link-change alert can act.
    """
    result = dict(result)
    previous = previous or {}
    raw_status = result.get('link_status')
    if raw_status == 'not_found_in_dtr_switcher':
        prior_absence = int(previous.get('consecutive_profile_absent') or 0)
        if not prior_absence and previous.get('link_status') == 'not_found_in_dtr_switcher':
            # Migrate the pre-fix counter without forcing an extra cycle.
            prior_absence = int(previous.get('consecutive_unknown') or 0)
        absence_count = prior_absence + 1
        result['consecutive_profile_absent'] = absence_count
        if absence_count >= PROFILE_ABSENCE_THRESHOLD:
            result['verdict'] = 'unlinked_confirmed'
            result['link_status'] = 'profile_removed_from_dtr'
            result['error'] = None
    else:
        result['consecutive_profile_absent'] = 0

    verdict = result.get('verdict')
    result['consecutive_unknown'] = (
        int(previous.get('consecutive_unknown') or 0) + 1
        if verdict == 'unknown'
        else 0
    )
    confirmed_verdict, confirmed_status = confirmed_account_state(previous)
    confirmed_at = previous.get('last_confirmed_at') or previous.get('checked_at')
    if verdict in {'linked', 'unlinked_confirmed'}:
        confirmed_verdict, confirmed_status = verdict, result.get('link_status')
        confirmed_at = result.get('checked_at') or now_iso()
    result['last_confirmed_verdict'] = confirmed_verdict
    result['last_confirmed_link_status'] = confirmed_status
    result['last_confirmed_at'] = confirmed_at if confirmed_verdict else None
    return result


def restriction_unknown_candidates(rows, capability=None):
    """Return only failures that can still indicate an app-wide restriction.

    Fresh functional evidence wins over account-level ambiguity. If at least
    three independent linked accounts still expose pages through Meta Graph,
    the app capability detector is healthy and a mass ``debug_token`` failure
    is not an app/BM restriction. Keep those rows inconclusive for Sheet safety,
    but do not open the manager-facing ``POSSÍVEL RESTRIÇÃO`` incident.
    """
    candidates = [
        r for r in rows
        if r.get('link_status') == 'debug_token_check_failed'
        and int(r.get('consecutive_unknown') or 0) >= UNKNOWN_ALERT_THRESHOLD
    ]
    independent_users = {
        str(r.get('user') or '').strip().casefold()
        for r in candidates
        if str(r.get('user') or '').strip()
    }
    if len(independent_users) < RESTRICTION_UNKNOWN_MIN_ACCOUNTS:
        return []
    if (capability or {}).get('status') == 'healthy':
        return []
    return candidates


def retire_out_of_scope_accounts(accounts_state, seen_keys):
    """Retire Sheet-reassigned targets without producing a removal incident."""
    retired = []
    for key in sorted(set(accounts_state) - set(seen_keys)):
        retired.append(accounts_state.pop(key))
    return retired


def post_request_with_rate_limit_retry(req, max_attempts=5):
    for attempt in range(1, max_attempts + 1):
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                return r.status
        except urllib.error.HTTPError as exc:
            if exc.code != 429 or attempt >= max_attempts:
                raise
            raw = exc.read().decode('utf-8', 'replace')
            try:
                body = json.loads(raw or '{}')
            except Exception:
                body = {}
            retry_after = body.get('retry_after') or exc.headers.get('X-RateLimit-Reset-After') or exc.headers.get('Retry-After') or 1.0
            try:
                delay = float(retry_after)
            except (TypeError, ValueError):
                delay = 1.0
            time.sleep(min(max(delay, 0.25), 15.0) + 0.15)


def post_discord(config, content, embed=None, allowed_mentions=None):
    if allowed_mentions is None:
        allowed_mentions = {'users': [RODOLFO_ID]}
    if DRY_RUN:
        print(json.dumps({'dry_run_alert': content, 'embed': embed, 'allowed_mentions': allowed_mentions}, ensure_ascii=False))
        return 0
    token = os.environ.get('DISCORD_BOT_TOKEN', '').strip()
    if not token:
        raise RuntimeError('local Zeus Discord bot token unavailable')
    payload = {'content': content, 'allowed_mentions': allowed_mentions}
    if embed:
        payload['embeds'] = [embed]
    req = urllib.request.Request(
        f"https://discord.com/api/v10/channels/{config['alert_channel_id']}/messages",
        data=json.dumps(payload, ensure_ascii=False).encode('utf-8'),
        headers={'Content-Type': 'application/json', 'Authorization': f'Bot {token}', 'User-Agent': 'MGS-Zeus-B013-DTR-Link-Watch/1.0'},
        method='POST',
    )
    return post_request_with_rate_limit_retry(req)


def possible_restriction_content():
    role_mentions = ' '.join(f'<@&{role_id}>' for role_id in POSSIBLE_RESTRICTION_ROLE_IDS)
    return f'{POSSIBLE_RESTRICTION_EMOJIS}\n{role_mentions}'


def possible_restriction_allowed_mentions():
    return {'parse': [], 'roles': list(POSSIBLE_RESTRICTION_ROLE_IDS)}


