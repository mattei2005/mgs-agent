def is_application_deleted_response(status, body):
    """Recognize Meta's exact app-deleted/restricted response."""
    err = (body or {}).get('error') or {}
    message = str(err.get('message') or '')
    return (
        status in {400, 401, 403}
        and int(err.get('code') or 0) == 190
        and 'application has been deleted' in message.casefold()
    )


def restriction_confirmation_probe(config, rows, graph_call=graph):
    """Independently confirm that a possible restriction is not a false positive.

    Account evidence must already be persistent across monitor cycles. After the
    possible-restriction alert, this probe checks two fresh app-level Meta routes
    with the app access token. Secrets never leave this function or enter state.
    """
    exact_rows = []
    for row in rows:
        err = row.get('error') or {}
        if (
            row.get('link_status') == 'debug_token_check_failed'
            and int(row.get('consecutive_unknown') or 0) >= UNKNOWN_ALERT_THRESHOLD
            and int(err.get('code') or 0) == 190
            and 'application has been deleted' in str(err.get('message') or '').casefold()
        ):
            exact_rows.append(row)
    independent_users = {
        str(row.get('user') or '').strip().casefold()
        for row in exact_rows
        if str(row.get('user') or '').strip()
    }
    result = {
        'status': 'inconclusive',
        'independent_bot_logins': len(independent_users),
        'account_error': 'OAuthException 190: Application has been deleted',
        'checks': [],
        'checked_at': now_iso(),
    }
    if len(independent_users) < RESTRICTION_UNKNOWN_MIN_ACCOUNTS:
        return result

    app_token = f"{config['app_id']}|{config['app_secret']}"
    probes = (
        ('app_metadata', f"/{config['app_id']}", {'fields': 'id,name,link'}),
        ('app_roles', f"/{config['app_id']}/roles", {'limit': '5'}),
    )
    for label, path, params in probes:
        try:
            status, _, body = graph_call(path, params, app_token)
            err = (body or {}).get('error') or {}
            result['checks'].append({
                'name': label,
                'http': status,
                'error_code': err.get('code'),
                'application_deleted': is_application_deleted_response(status, body),
            })
        except Exception as exc:
            result['checks'].append({
                'name': label,
                'http': None,
                'error_code': None,
                'application_deleted': False,
                'transport_error': type(exc).__name__,
            })
    if len(result['checks']) == len(probes) and all(
        check.get('application_deleted') is True for check in result['checks']
    ):
        result['status'] = 'confirmed_not_false_positive'
    return result


