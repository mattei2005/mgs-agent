  "intermediate_issues": [
    {
      "issue": "External Application Password users returned 401 rest_cannot_install_plugin and 404 for plugin controller",
      "resolution": "Authenticated admin ZIP upload, direct activation href, AJAX wizard save."
    },
    {
      "issue": "Activation link was iframe/invisible and direct click timed out",
      "resolution": "Extracted nonce-bearing href and navigated directly."
    },
    {
      "issue": "Spanish panels use Versión and immediate enforcement applies on next login",
      "resolution": "Language-neutral version and fresh-session behavioral gates."
    },
    {
      "issue": "Package 4.1.0 readme declares Stable tag 4.0",
      "resolution": "Version read from authenticated plugin row, not readme Stable tag."
    },
    {
      "issue": "Rollback checks were initially fooled by enforcement redirect",
      "resolution": "Reconciled current URL, active asset and fresh-login behavior before classifying state."
    }
  ],
