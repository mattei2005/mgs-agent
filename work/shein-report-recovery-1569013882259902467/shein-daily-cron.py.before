#!/usr/bin/env python3
"""Daily deterministic cron wrapper: bounded resume + local logs, no LLM."""
import importlib.util,json,subprocess,time,sys,re
from pathlib import Path
from datetime import datetime
from zoneinfo import ZoneInfo
HOME=Path('/root/.hermes/profiles/ares');BASE=Path('/root/mgs-agent')
STATE=BASE/'data/ares/meta-ads/state/shein-daily-report'
def run():
    deadline=time.monotonic()+2300;attempt=0
    while time.monotonic()<deadline:
        attempt+=1
        interpreter=Path('/root/.local/bin/hermes').read_text().splitlines()[0].removeprefix('#!').strip()
        assert interpreter.startswith('/') and Path(interpreter).is_file()
        result=subprocess.run([interpreter,str(HOME/'scripts/shein-daily-report.py')],capture_output=True,text=True,timeout=max(1,int(deadline-time.monotonic())))
        STATE.mkdir(parents=True,exist_ok=True)
        log={'at':datetime.now(ZoneInfo('America/New_York')).isoformat(),'attempt':attempt,'returncode':result.returncode,'stdout':result.stdout[-2500:],'stderr':result.stderr[-1000:]}
        (STATE/'last-cron-result.json').write_text(json.dumps(log,ensure_ascii=False,indent=2))
        if result.returncode==0:
            data=json.loads(result.stdout)
            if data.get('status')=='COMPLETE_GET_VERIFIED':return
            if data.get('status')=='ALREADY_RUNNING':time.sleep(20);continue
        if attempt>=3:break
        time.sleep(30)
    raise RuntimeError('Daily report incomplete; resume same journal and sources')
def alert():
    args=[str(BASE/'scripts/send-report-infra-embed.sh'),'--action','modificada','--type','cron/read-only-report','--path','SHEIN daily D-1 / 24 threads','--reason','Falha na rotina diaria SHEIN; estado preservado sem replay de POST. Campanhas e dashboards nao alterados.','--evidence','Consultar last-error/last-cron-result do request; retomar somente fonte/parte pendente e conferir GET. Nenhum envio incompleto e sucesso.']
    p=subprocess.run(args,capture_output=True,text=True,timeout=90)
    safe={'returncode':p.returncode,'message_id':None,'verified':False}
    match=re.search(r'message_id=(\d+)',p.stdout)
    if match:
        spec=importlib.util.spec_from_file_location('daily_alert_reader',HOME/'scripts/shein-daily-report.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
        message=m.Discord().call('GET','/channels/1498132022634483894/messages/'+match[1])
        assert message.get('content','')=='' and not message.get('mentions') and len(message.get('embeds',[]))==1
        safe.update(message_id=match[1],verified=True)
    (STATE/'failure-alert-readback.json').write_text(json.dumps(safe))
if __name__=='__main__':
    try:run()
    except Exception:
        try:alert()
        finally:sys.exit(1)
