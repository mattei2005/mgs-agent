#!/usr/bin/env python3
"""Resolve the active Hermes interpreter on each scheduled fire; no LLM."""
import os
from pathlib import Path
import sys

def main():
    launcher = Path('/root/.local/bin/hermes')
    first = launcher.read_text().splitlines()[0]
    assert first.startswith('#!')
    interpreter = first[2:].strip()
    assert interpreter.startswith('/') and Path(interpreter).is_file()
    target = '/root/.hermes/profiles/ares/scripts/shein-intraday-report.py'
    os.execv(interpreter, [interpreter, target, *sys.argv[1:]])

if __name__ == '__main__':
    main()
