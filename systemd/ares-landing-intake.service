[Unit]
Description=Ares independent read-only native delivery observer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/mgs-agent
Environment=HERMES_HOME=/root/.hermes/profiles/ares
Environment=TMPDIR=/root/.hermes/profiles/ares/cache/scratch
ExecStart=/usr/bin/python3 /root/mgs-agent/scripts/ares-direct-traffic-followup.py intake
TimeoutStartSec=60
UMask=0077
Nice=19
CPUWeight=1
CPUQuota=10%
IOWeight=1
IOSchedulingClass=idle
MemoryMax=256M
StandardOutput=journal
StandardError=journal
